+    void *stage = g_stage_vt, *kit = fake_actor_kit.bytes;
+    memcpy(fake_scene.bytes, &stage, sizeof(stage)); memcpy(fake_scene.bytes + 0x90, &kit, sizeof(kit));
+    DmLunaFrame expected[2]; neutral_pair(expected); observe_pair(&expected[0], &expected[1], 15, 0x8010);
+    movement(fake_scene.bytes);
+    CHECK(g_frame == 2 && g_generation == 2 && !g_camera_pending && change_calls == 1);
+    CHECK(holder_mode_calls == 1 && separate_mode);
+}
+static void test_unprepared_scene_rejected(void) {
+    reset_runtime(0); char path[4096]; make_basic(path, 1);
+    void *no_kit = NULL; memcpy(fake_scene.bytes + 0x90, &no_kit, sizeof(no_kit));
+    REQUIRE(dm_smo_replay_load(path)); movement(fake_scene.bytes);
+    CHECK(!dm_smo_replay_active() && !g_frame && !g_index && !strcmp(g_phase, "error"));
+    CHECK(!holder_calls && !holder_mode_calls && !change_calls);
+    movement(fake_scene.bytes); CHECK(!dm_smo_luna_selected() && connections == 5);
+}
+static void test_first_scene_missing_holder(void) {
+    reset_runtime(0); first_scene(); missing_holder = 1; char path[4096]; make_basic(path, 1);
+    REQUIRE(dm_smo_replay_load(path)); movement(fake_scene.bytes);
+    CHECK(!dm_smo_replay_active() && !g_frame && !g_index && !strcmp(g_phase, "error"));
+    CHECK(holder_calls == 1 && !holder_mode_calls && !change_calls);
+    movement(fake_scene.bytes); CHECK(!dm_smo_luna_selected() && connections == 5);
+}
+static void test_golden_file(const char *name) {
+    reset_runtime(1);
+    int cascade = !strcmp(name, "cascade");
+    const char *path = golden_paths[cascade];
+    REQUIRE(dm_smo_replay_load(path));
+    REQUIRE(g_tape.frames == (cascade ? 5327u : 7055u));
+    REQUIRE(g_tape.count == (cascade ? 10654u : 14110u));
+    size_t index = 0; uint32_t previous[2] = {0};
+    for (uint32_t step = 0; step < g_tape.frames; ++step) {
+        DmLunaFrame expected[2]; neutral_pair(expected);
+        while (index < g_tape.count && g_tape.records[index].step == step) {
+            DmLunaFrame *f = &g_tape.records[index++]; expected[f->player] = *f;
+        }
+        observe_pair(&expected[0], &expected[1], previous[0], previous[1]);
+        movement(fake_scene.bytes);
+        CHECK(g_frame == step + 1 && g_generation == step + 1 && g_index == index);
+        for (int p = 0; p < 2; ++p) previous[p] = expected[p].buttons;
+    }
+    CHECK(index == g_tape.count && !dm_smo_replay_active() && !strcmp(g_phase, "completed"));
+    CHECK(trans_calls == (!strcmp(name, "cascade") ? 1 : 0));
+    printf("%s: all %u source steps, %zu records, exact two-player addon writes verified\n", name, g_frame, g_tape.count);
+}
+static void test_cap(void) { test_golden_file("cap"); }
+static void test_cascade(void) { test_golden_file("cascade"); }
+
+int main(int argc, char **argv) {
+    const char *only = NULL;
+    for (int i = 1; i < argc; ++i) {
+        if (!strcmp(argv[i], "--goldens") && i + 2 < argc && !golden_paths[0]) {
+            golden_paths[0] = argv[++i]; golden_paths[1] = argv[++i];
+        } else if (!strcmp(argv[i], "--case") && i + 1 < argc && !only) {
+            only = argv[++i];
+        } else {
+            fprintf(stderr, "Usage: %s [--goldens CAP_BIN CASCADE_BIN] [--case CASE_NAME]\n", argv[0]);
+            return 2;
+        }
+    }
+    if (only && (!strcmp(only, "cap-golden") || !strcmp(only, "cascade-golden")) && !golden_paths[0]) {
+        fputs("Golden cases require --goldens CAP_BIN CASCADE_BIN\n", stderr); return 2;
+    }
+    static char temporary[4096]; /* Remains valid for the atexit cleanup. */
+    const char *base = getenv("TMPDIR"); if (!base || !*base) base = "/tmp";
+    int n = snprintf(temporary, sizeof(temporary), "%s/smo-lunakit-runtime-XXXXXX", base);
+    if (n < 0 || (size_t)n >= sizeof(temporary) || !mkdtemp(temporary)) {
+        fputs("Cannot create private runtime-test fixture directory\n", stderr); return 2;
+    }
+    scratch = temporary;
+    if (atexit(cleanup_scratch)) { cleanup_scratch(); return 2; }
+    struct { const char *name; void (*run)(void); } cases[] = {
+        {"setup-wait-frame0", test_setup}, {"already-separate", test_already_separate},
+        {"sparse-neutral-release", test_sparse_and_release}, {"invalid-load-preserves-active", test_invalid_load},
+        {"render-read-no-advance", test_render_reads}, {"explicit-stop", test_stop},
+        {"completion-cleanup", test_completion_cleanup}, {"continuous-handoff", test_continuous_handoff}, {"restore-initial-2p", test_restore_initial_two_player},
+        {"setup-failure-cleanup", test_setup_failure}, {"missing-addon-atomic", test_missing_addon},
+        {"position-once", test_position_once}, {"continuous-position-no-write", test_continuous_position}, {"reload-ownership", test_reload},
+        {"legacy-text", test_legacy_text}, {"luna-to-text", test_luna_to_text},
+        {"first-scene-setup-stop", test_first_scene_setup_stop}, {"first-scene-defer-camera", test_first_scene_defer_camera},
+        {"unprepared-scene-rejected", test_unprepared_scene_rejected}, {"first-scene-missing-holder", test_first_scene_missing_holder},
+        {"cap-golden", test_cap}, {"cascade-golden", test_cascade}
+    };
+    size_t run = 0;
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+        if (only && strcmp(only, cases[i].name)) continue;
+        if (!golden_paths[0] && (!strcmp(cases[i].name, "cap-golden") || !strcmp(cases[i].name, "cascade-golden"))) continue;
+        case_name = cases[i].name; size_t before = failures;
+        cases[i].run(); ++run;
+        printf("%s %s (%zu failed assertions)\n", failures == before ? "PASS" : "FAIL", case_name, failures - before);
+    }
+    case_name = "teardown"; reset_runtime(0);
+    if (!run) { fputs("Unknown test case\n", stderr); return 2; }
+    printf("LunaKit runtime: %zu cases, %zu checks, %zu failures\n", run, checks, failures);
+    return failures ? 1 : 0;
+}
diff --git a/dm/host/tests/t_smo_lunakit_tape.c b/dm/host/tests/t_smo_lunakit_tape.c
new file mode 100644
index 0000000..f1449e6
--- /dev/null
+++ b/dm/host/tests/t_smo_lunakit_tape.c
@@ -0,0 +1,376 @@
+/* Standalone CPU test; no host, game, graphics or external dependencies.
+ * cc -std=c11 -Wall -Wextra -Werror -pedantic t_smo_lunakit_tape.c -o TEST
+ * TEST /path/to/switch-recomps
+ * Alternatively pass explicit cap.bin and cascade.bin paths as two arguments.
+ */
+#include "../smo_lunakit_tape.h"
+
+static size_t checks, malformed_cases;
+
+#define CHECK(condition) do { \
+    ++checks; \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); \
+        exit(1); \
+    } \
+} while (0)
+
+static uint32_t read32(const unsigned char *p) {
+    uint32_t value = 0;
+    for (size_t i = 4; i; --i) value = value * 256u + p[i - 1];
+    return value;
+}
+
+static uint32_t float_bits(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+static void write32(unsigned char *p, uint32_t value) {
+    for (size_t i = 0; i < 4; ++i) {
+        p[i] = (unsigned char)(value & 255u);
+        value >>= 8;
+    }
+}
+
+static unsigned char *fixture(size_t count, int two_player, size_t *length) {
+    *length = DM_LUNA_HEADER_SIZE + count * DM_LUNA_RECORD_SIZE;
+    unsigned char *bytes = (unsigned char *)calloc(1, *length + 1);
+    CHECK(bytes != NULL);
+    memcpy(bytes, "BOOB", 4);
+    write32(bytes + 4, (uint32_t)count);
+    bytes[8] = (unsigned char)two_player;
+    write32(bytes + 12, UINT32_MAX); /* signed scenario -1 */
+    memcpy(bytes + 16, "SyntheticStage", sizeof("SyntheticStage"));
+    memcpy(bytes + 144, "SyntheticEntrance", sizeof("SyntheticEntrance"));
+    for (size_t i = 0; i < count; ++i) {
+        unsigned char *p = bytes + DM_LUNA_HEADER_SIZE + i * DM_LUNA_RECORD_SIZE;
+        write32(p, (uint32_t)(two_player ? i / 2 : i));
+        p[4] = (unsigned char)(two_player ? i % 2 : 0);
+        write32(p + 8, (i & 1) ? UINT32_C(0x00084210) : UINT32_C(0x00012481));
+        for (size_t j = 12; j < DM_LUNA_RECORD_SIZE; j += 4)
+            write32(p + j, UINT32_C(0x3f000000) + (uint32_t)(i % 100 + j));
+    }
+    return bytes;
+}
+
+static void expect_bad(const unsigned char *bytes, size_t length, const char *name) {
+    DmLunaTape output;
+    unsigned char sentinel[sizeof(output)];
+    char error[128] = {0};
+    memset(&output, 0xa5, sizeof(output));
+    memcpy(sentinel, &output, sizeof(output));
+    if (dm_luna_decode(bytes, length, &output, error, sizeof(error)) != -1) {
+        fprintf(stderr, "FAIL accepted malformed tape: %s\n", name);
+        exit(1);
+    }
+    CHECK(!memcmp(sentinel, &output, sizeof(output)));
+    CHECK(error[0] != '\0' && memchr(error, '\0', sizeof(error)) != NULL);
+    ++malformed_cases;
+}
+
+static void compare_record(const DmLunaFrame *frame, const unsigned char *p) {
+    CHECK(frame->step == read32(p));
+    CHECK(frame->player == p[4]);
+    CHECK(frame->buttons == read32(p + 8));
+    for (size_t j = 0; j < 4; ++j)
+        CHECK(float_bits(frame->sticks[j]) == read32(p + 12 + j * 4));
+    for (size_t hand = 0; hand < 2; ++hand) {
+        size_t a = hand ? 40 : 28, d = hand ? 100 : 52, v = hand ? 136 : 88;
+        for (size_t j = 0; j < 3; ++j) {
+            CHECK(float_bits(frame->accel[hand][j]) == read32(p + a + j * 4));
+            CHECK(float_bits(frame->angular[hand][j]) == read32(p + v + j * 4));
+        }
+        for (size_t j = 0; j < 9; ++j)
+            CHECK(float_bits(frame->direction[hand][j]) == read32(p + d + j * 4));
+    }
+}
+
+static void test_valid(void) {
+    size_t length;
+    unsigned char *bytes = fixture(4, 1, &length);
+    DmLunaTape tape = {0};
+    const unsigned char empty[sizeof(tape)] = {0};
+    char error[128] = "must be cleared";
+    /* Signed zero, subnormals, extrema and arbitrary finite sensor values. */
+    const uint32_t finite[] = {UINT32_C(0x80000000), UINT32_C(0x00000001),
+        UINT32_C(0x80000001), UINT32_C(0x7f7fffff), UINT32_C(0xff7fffff),
+        UINT32_C(0x00800000), UINT32_C(0x80800000)};
+    write32(bytes + 272, UINT32_C(0x80000000));
+    write32(bytes + 276, UINT32_C(0x7f7fffff));
+    write32(bytes + 280, UINT32_C(0xff7fffff));
+    unsigned char *p = bytes + DM_LUNA_HEADER_SIZE;
+    write32(p + 8, DM_LUNA_SEAD_BUTTON_MASK);
+    write32(p + 12, UINT32_C(0x80000000));
+    write32(p + 16, UINT32_C(0x00000001));
+    write32(p + 20, UINT32_C(0xbf800000));
+    write32(p + 24, UINT32_C(0x3f800000));
+    for (size_t i = 28; i < DM_LUNA_RECORD_SIZE; i += 4)
+        write32(p + i, finite[(i / 4) % (sizeof(finite) / sizeof(finite[0]))]);
+    CHECK(dm_luna_decode(bytes, length, &tape, error, sizeof(error)) == 0);
+    CHECK(!error[0]);
+    CHECK(tape.count == 4 && tape.frames == 2 && tape.two_player == 1);
+    CHECK(tape.scenario == -1);
+    CHECK(!strcmp(tape.stage, "SyntheticStage"));
+    CHECK(!strcmp(tape.entrance, "SyntheticEntrance"));
+    for (size_t i = 0; i < 3; ++i) CHECK(float_bits(tape.pos[i]) == read32(bytes + 272 + i * 4));
+    for (size_t i = 0; i < tape.count; ++i)
+        compare_record(&tape.records[i], bytes + DM_LUNA_HEADER_SIZE + i * DM_LUNA_RECORD_SIZE);
+    /* The result owns a copy, including its strings. */
+    memset(bytes, 0, length);
+    CHECK(tape.records[0].buttons == DM_LUNA_SEAD_BUTTON_MASK);
+    CHECK(!strcmp(tape.stage, "SyntheticStage"));
+    dm_luna_free(&tape);
+    CHECK(!memcmp(&tape, empty, sizeof(tape)));
+    dm_luna_free(&tape);
+    dm_luna_free(NULL);
+    free(bytes);
+
+    /* Sparse 2P: P2 can occur before the first P1 record. No records are added. */
+    bytes = fixture(3, 1, &length);
+    p = bytes + DM_LUNA_HEADER_SIZE;
+    write32(p, 5); p[4] = 1;
+    write32(p + DM_LUNA_RECORD_SIZE, 9); p[DM_LUNA_RECORD_SIZE + 4] = 0;
+    write32(p + 2 * DM_LUNA_RECORD_SIZE, 59999); p[2 * DM_LUNA_RECORD_SIZE + 4] = 1;
+    CHECK(dm_luna_decode(bytes, length, &tape, NULL, 0) == 0);
+    CHECK(tape.count == 3 && tape.frames == 60000);
+    CHECK(tape.records[0].step == 5 && tape.records[0].player == 1);
+    CHECK(tape.records[1].step == 9 && tape.records[1].player == 0);
+    dm_luna_free(&tape);
+    free(bytes);
+
+    /* Unaligned input and longest terminated ASCII fields; 1P stays 1P. */
+    bytes = fixture(2, 0, &length);
+    memset(bytes + 16, 'S', 127); bytes[143] = 0;
+    memset(bytes + 144, 'E', 127); bytes[271] = 0;
+    write32(bytes + 12, UINT32_C(0x80000000));
+    unsigned char *unaligned = (unsigned char *)malloc(length + 1);
+    CHECK(unaligned != NULL);
+    memcpy(unaligned + 1, bytes, length);
+    CHECK(dm_luna_decode(unaligned + 1, length, &tape, NULL, 99) == 0);
+    CHECK(tape.count == 2 && tape.frames == 2 && !tape.two_player);
+    CHECK(tape.scenario == INT32_MIN);
+    CHECK(strlen(tape.stage) == 127 && strlen(tape.entrance) == 127);
+    dm_luna_free(&tape);
+    free(unaligned);
+    free(bytes);
+
+    /* A valid single sparse record is sufficient, even for only P2. */
+    bytes = fixture(1, 1, &length);
+    bytes[DM_LUNA_HEADER_SIZE + 4] = 1;
+    CHECK(dm_luna_decode(bytes, length, &tape, NULL, 0) == 0);
+    CHECK(tape.count == 1 && tape.frames == 1 && tape.records[0].player == 1);
+    dm_luna_free(&tape);
+    free(bytes);
+}
+
+static void test_malformed(void) {
+    size_t length;
+    unsigned char *good = fixture(4, 1, &length);
+    unsigned char *bad = (unsigned char *)malloc(length + 1);
+    CHECK(bad != NULL);
+    expect_bad(NULL, 0, "null tape");
+    expect_bad(good, SIZE_MAX, "oversized supplied length");
+    for (size_t n = 0; n < length; ++n) expect_bad(good, n, "every truncation");
+    memcpy(bad, good, length + 1);
+    expect_bad(bad, length + 1, "trailing byte");
+
+    for (size_t i = 0; i < 4; ++i) {
+        memcpy(bad, good, length); bad[i] ^= 0x20;
+        expect_bad(bad, length, "magic");
+    }
+    const uint32_t bad_counts[] = {0, 1, 3, 5, 120001, UINT32_MAX};
+    for (size_t i = 0; i < sizeof(bad_counts) / sizeof(bad_counts[0]); ++i) {
+        memcpy(bad, good, length); write32(bad + 4, bad_counts[i]);
+        expect_bad(bad, length, "count/length mismatch or limit");
+    }
+    for (unsigned value = 2; value <= 255; ++value) {
+        memcpy(bad, good, length); bad[8] = (unsigned char)value;
+        expect_bad(bad, length, "header boolean");
+        memcpy(bad, good, length); bad[DM_LUNA_HEADER_SIZE + 4] = (unsigned char)value;
+        expect_bad(bad, length, "player boolean");
+    }
+    memcpy(bad, good, length); bad[8] = 0;
+    expect_bad(bad, length, "P2 in single-player tape");
+    for (size_t field = 16; field <= 144; field += 128) {
+        memcpy(bad, good, length); memset(bad + field, 'x', 128);
+        expect_bad(bad, length, "unterminated metadata string");
+        memcpy(bad, good, length); bad[field] = 0x80;
+        expect_bad(bad, length, "non-ASCII metadata string");
+    }
+    const uint32_t nonfinite[] = {UINT32_C(0x7f800000), UINT32_C(0xff800000),
+        UINT32_C(0x7fc00000), UINT32_C(0x7f800001),
+        UINT32_C(0xffc12345), UINT32_C(0xff800001)};
+    for (size_t i = 0; i < sizeof(nonfinite) / sizeof(nonfinite[0]); ++i) {
+        for (size_t offset = 272; offset < 284; offset += 4) {
+            memcpy(bad, good, length); write32(bad + offset, nonfinite[i]);
+            expect_bad(bad, length, "nonfinite position component");
+        }
+        for (size_t record = 0; record < 4; ++record) {
+            for (size_t offset = 12; offset < DM_LUNA_RECORD_SIZE; offset += 4) {
+                memcpy(bad, good, length);
+                write32(bad + DM_LUNA_HEADER_SIZE + record * DM_LUNA_RECORD_SIZE + offset, nonfinite[i]);
+                expect_bad(bad, length, "nonfinite record component");
+            }
+        }
+    }
+    const uint32_t outside_sticks[] = {UINT32_C(0x3f800001), UINT32_C(0xbf800001),
+        UINT32_C(0x7f7fffff), UINT32_C(0xff7fffff)};
+    for (size_t axis = 0; axis < 4; ++axis)
+        for (size_t i = 0; i < sizeof(outside_sticks) / sizeof(outside_sticks[0]); ++i) {
+            memcpy(bad, good, length);
+            write32(bad + DM_LUNA_HEADER_SIZE + 12 + axis * 4, outside_sticks[i]);
+            expect_bad(bad, length, "out-of-range stick");
+        }
+    for (unsigned bit = 20; bit < 32; ++bit) {
+        memcpy(bad, good, length);
+        write32(bad + DM_LUNA_HEADER_SIZE + 8, UINT32_C(1) << bit);
+        expect_bad(bad, length, "unknown SEAD bit");
+    }
+    memcpy(bad, good, length); write32(bad + DM_LUNA_HEADER_SIZE, 60000);
+    expect_bad(bad, length, "step limit");
+    memcpy(bad, good, length); write32(bad + DM_LUNA_HEADER_SIZE, UINT32_MAX);
+    expect_bad(bad, length, "huge step");
+    memcpy(bad, good, length); bad[DM_LUNA_HEADER_SIZE + DM_LUNA_RECORD_SIZE + 4] = 0;
+    expect_bad(bad, length, "duplicate step/player");
+    memcpy(bad, good, length); bad[DM_LUNA_HEADER_SIZE + 4] = 1;
+    bad[DM_LUNA_HEADER_SIZE + DM_LUNA_RECORD_SIZE + 4] = 0;
+    expect_bad(bad, length, "descending player on same step");
+    memcpy(bad, good, length);
+    write32(bad + DM_LUNA_HEADER_SIZE + 3 * DM_LUNA_RECORD_SIZE, 0);
+    expect_bad(bad, length, "descending step");
+
+    DmLunaTape output;
+    unsigned char sentinel[sizeof(output)];
+    memset(&output, 0x5a, sizeof(output)); memcpy(sentinel, &output, sizeof(output));
+    char tiny[3] = {'x', 'y', 'z'};
+    CHECK(dm_luna_decode(NULL, length, &output, tiny, 1) == -1);
+    CHECK(tiny[0] == 0 && tiny[1] == 'y' && tiny[2] == 'z');
+    CHECK(!memcmp(sentinel, &output, sizeof(output)));
+    CHECK(dm_luna_decode(good, length, NULL, NULL, 0) == -1);
+    CHECK(dm_luna_decode(good, 1, &output, tiny, 0) == -1);
+    CHECK(tiny[1] == 'y');
+    CHECK(dm_luna_decode(good, 1, &output, NULL, 99) == -1);
+    CHECK(!memcmp(sentinel, &output, sizeof(output)));
+    free(bad);
+    free(good);
+}
+
+static void test_limits(void) {
+    size_t length;
+    unsigned char *bytes = fixture(DM_LUNA_MAX_RECORDS, 1, &length);
+    DmLunaTape tape = {0};
+    CHECK(dm_luna_decode(bytes, length, &tape, NULL, 0) == 0);
+    CHECK(tape.count == DM_LUNA_MAX_RECORDS && tape.frames == DM_LUNA_MAX_STEPS);
+    CHECK(tape.records[tape.count - 1].step == 59999 && tape.records[tape.count - 1].player == 1);
+    dm_luna_free(&tape);
+    write32(bytes + length - DM_LUNA_RECORD_SIZE, 60000);
+    expect_bad(bytes, length, "invalid final record after maximum valid prefix");
+    free(bytes);
+}
+
+static unsigned char *read_file(const char *path, size_t *length) {
+    FILE *file = fopen(path, "rb");
+    if (!file) { fprintf(stderr, "Cannot open golden tape: %s\n", path); exit(1); }
+    CHECK(fseek(file, 0, SEEK_END) == 0);
+    long size = ftell(file);
+    CHECK(size > 0);
+    CHECK(fseek(file, 0, SEEK_SET) == 0);
+    *length = (size_t)size;
+    unsigned char *bytes = (unsigned char *)malloc(*length);
+    CHECK(bytes != NULL);
+    CHECK(fread(bytes, 1, *length, file) == *length);
+    CHECK(fclose(file) == 0);
+    return bytes;
+}
+
+static void test_golden(const char *path, int cascade) {
+    size_t length;
+    unsigned char *bytes = read_file(path, &length);
+    DmLunaTape tape = {0};
+    char error[128];
+    int rc = dm_luna_decode(bytes, length, &tape, error, sizeof(error));
+    if (rc) fprintf(stderr, "Golden decode failed: %s: %s\n", path, error);
+    CHECK(rc == 0);
+    CHECK(length == (cascade ? 1577076u : 2088564u));
+    CHECK(tape.count == (cascade ? 10654u : 14110u));
+    CHECK(tape.frames == (cascade ? 5327u : 7055u));
+    CHECK(tape.two_player == 1 && tape.scenario == 1);
+    CHECK(!tape.stage[0] && !tape.entrance[0]);
+    const float pos[3] = {5700.0f, 1175.0f, 700.0f};
+    for (size_t i = 0; i < 3; ++i) CHECK(tape.pos[i] == (cascade ? pos[i] : 0.0f));
+    size_t button_frames[2] = {0}, stick_frames[2] = {0}, motion_frames[2] = {0};
+    for (size_t i = 0; i < tape.count; ++i) {
+        const DmLunaFrame *f = &tape.records[i];
+        compare_record(f, bytes + DM_LUNA_HEADER_SIZE + i * DM_LUNA_RECORD_SIZE);
+        CHECK(f->step == i / 2 && f->player == i % 2);
+        button_frames[f->player] += f->buttons != 0;
+        int stick = 0, motion = 0;
+        for (size_t j = 0; j < 4; ++j) stick |= f->sticks[j] != 0.0f;
+        for (size_t h = 0; h < 2; ++h)
+            for (size_t j = 0; j < 3; ++j)
+                motion |= f->accel[h][j] != 0.0f || f->angular[h][j] != 0.0f;
+        stick_frames[f->player] += stick;
+        motion_frames[f->player] += motion;
+    }
+    CHECK(button_frames[0] == (cascade ? 3036u : 3926u));
+    CHECK(button_frames[1] == (cascade ? 557u : 852u));
+    CHECK(stick_frames[0] == (cascade ? 975u : 5131u));
+    CHECK(stick_frames[1] == (cascade ? 106u : 717u));
+    CHECK(motion_frames[0] == (cascade ? 18u : 61u));
+    CHECK(motion_frames[1] == (cascade ? 2u : 3u));
+    CHECK(tape.records[(cascade ? 1097u : 300u) * 2].buttons == (cascade ? 1024u : 1u));
+    CHECK(tape.records[(cascade ? 1554u : 302u) * 2 + 1].buttons == (cascade ? 16u : 1025u));
+    /* Reject mutations at the end of real tapes after thousands of valid rows. */
+    unsigned char *last = bytes + length - DM_LUNA_RECORD_SIZE;
+    uint32_t saved = read32(last + 144);
+    write32(last + 144, UINT32_C(0x7fc00001));
+    expect_bad(bytes, length, "golden final motion component NaN");
+    write32(last + 144, saved);
+    saved = read32(last + 8);
+    write32(last + 8, UINT32_C(0x80000000));
+    expect_bad(bytes, length, "golden final unknown button");
+    write32(last + 8, saved);
+    last[4] = 0;
+    expect_bad(bytes, length, "golden final duplicate player");
+    last[4] = 1;
+    /* Failure while replacing a real owned result retains every output byte. */
+    DmLunaTape previous = tape;
+    unsigned char before[sizeof(tape)];
+    memcpy(before, &tape, sizeof(tape));
+    bytes[0] ^= 1;
+    CHECK(dm_luna_decode(bytes, length, &tape, error, sizeof(error)) == -1);
+    CHECK(!memcmp(before, &tape, sizeof(tape)));
+    CHECK(tape.records[tape.count - 1].step == tape.frames - 1);
+    dm_luna_free(&tape);
+    free(bytes);
+    printf("%s golden: exact fields for %zu records, both players and motion passed\n",
+           cascade ? "Cascade" : "Cap", previous.count);
+}
+
+int main(int argc, char **argv) {
+    char cap[4096], cascade[4096];
+    if (argc == 3) {
+        CHECK(strlen(argv[1]) < sizeof(cap) && strlen(argv[2]) < sizeof(cascade));
+        strcpy(cap, argv[1]); strcpy(cascade, argv[2]);
+    } else if (argc == 2) {
+        const char *root = argv[1];
+        int n = snprintf(cap, sizeof(cap), "%s/tmp/odyssey/tsv-replay/cap.bin", root);
+        CHECK(n > 0 && (size_t)n < sizeof(cap));
+        n = snprintf(cascade, sizeof(cascade), "%s/tmp/odyssey/tsv-replay/cascade.bin", root);
+        CHECK(n > 0 && (size_t)n < sizeof(cascade));
+    } else if (argc != 1) {
+        fprintf(stderr, "Usage: %s [PROJECT_ROOT | CAP_BIN CASCADE_BIN]\n", argv[0]);
+        return 2;
+    }
+    test_valid();
+    test_malformed();
+    test_limits();
+    if (argc > 1) {
+        test_golden(cap, 0);
+        test_golden(cascade, 1);
+    }
+    printf("LunaKit decoder: %zu checks, %zu malformed cases passed\n", checks, malformed_cases);
+    return 0;
+}
