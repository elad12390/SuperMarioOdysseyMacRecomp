+++ b/dm/host/tests/t_smo_lunakit_runtime.c
@@ -0,0 +1,625 @@
+/* CPU-only integration test of the actual runtime/replay/motion C sources.
+ * cc -std=gnu11 -O1 -g -Wall -Wextra -Werror -pthread \
+ *   -I../gen/0100000000010000 t_smo_lunakit_runtime.c -o TEST
+ * TEST [--goldens CAP_BIN CASCADE_BIN] [--case CASE_NAME]
+ * No arguments runs self-contained synthetic cases. Fixtures use a private
+ * directory beneath TMPDIR (or /tmp) and are removed before exit.
+ * No game code, guest instructions, graphics, app or device is executed.
+ */
+#include "../dm.h"
+#include <stdatomic.h>
+#include <stddef.h>
+#include <unistd.h>
+
+#include "../hle_smo_lunakit.c"
+/* Keep the real legacy parser and scheduler in this translation unit too. */
+#define g_active text_active
+#define g_index text_index
+#define g_frame text_frame
+#define g_previous text_previous
+#include "../hle_smo_replay.c"
+#undef g_active
+#undef g_index
+#undef g_frame
+#undef g_previous
+#include "../hle_smo_tas_motion.c"
+
+module_t g_mod[MAX_MOD];
+int g_nmod;
+static size_t checks, failures;
+static const char *case_name, *scratch, *golden_paths[2];
+#define CHECK(expr) do { \
+    ++checks; \
+    if (!(expr)) { \
+        ++failures; \
+        fprintf(stderr, "FAIL [%s] line %d: %s\n", case_name, __LINE__, #expr); \
+    } \
+} while (0)
+#define REQUIRE(expr) do { \
+    size_t before_ = failures; CHECK(expr); if (failures != before_) return; \
+} while (0)
+
+enum { PAD_BYTES = 0x200, ADDON_BYTES = 0x80 };
+typedef union { max_align_t align; unsigned char bytes[PAD_BYTES]; } PadBuffer;
+typedef union { max_align_t align; unsigned char bytes[ADDON_BYTES]; } AddonBuffer;
+static PadBuffer fake_pads[2], fake_manager, fake_system_buffer, fake_scene, fake_keeper, fake_nerve, fake_actor_kit;
+static AddonBuffer fake_accel[2][2], fake_gyro[2][2];
+static void *fake_table[3], *fake_manager_ptr;
+static void *fake_scene_vtable[3], *fake_nerve_vtable[3], *fake_first_vtable[3];
+static struct { void *unused; const char *name; } scene_info, nerve_info, first_info;
+static int system_pad_tag, nfp_director_tag, player_tag, keeper_calls, holder_tag, camera_tag;
+static int holder_calls, holder_mode_calls, missing_holder;
+static int separate_mode, separate_calls, single_calls, change_calls, movement_calls;
+static int setup_ok, missing_addon, missing_port, addon_calls;
+static int puppet_start_calls, puppet_end_calls, trans_calls, puppet_active;
+static uint32_t connections;
+static uint64_t virtual_buttons[2];
+static int32_t virtual_axes[2][4];
+static float player_position[3];
+static const DmLunaFrame *observed[2];
+static uint32_t observed_previous[2];
+static int observe_writes;
+
+void *guest_sym(const char *name) { (void)name; return NULL; }
+void dm_guest_write_prepare(void *p, size_t n) { (void)p; (void)n; }
+int gate_call_present(int id) { (void)id; return 0; }
+void gate_call_set(int id, void (*fn)(uint64_t *)) { (void)id; (void)fn; }
+uint32_t dm_pad_players_get(void) { return connections; }
+void dm_pad_set_player(int p, uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    CHECK(p >= 0 && p < 2);
+    if (p < 0 || p >= 2) return;
+    virtual_buttons[p] = b;
+    virtual_axes[p][0] = lx; virtual_axes[p][1] = ly;
+    virtual_axes[p][2] = rx; virtual_axes[p][3] = ry;
+}
+void dm_pad_set(uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    dm_pad_set_player(0, b, lx, ly, rx, ry);
+}
+void dm_pad_players(uint32_t mask) {
+    connections = mask | 1;
+    for (int p = 0; p < 2; ++p)
+        if (!(connections & (1u << p))) dm_pad_set_player(p, 0, 0, 0, 0, 0);
+}
+
+static void verify_pad(unsigned player, const DmLunaFrame *frame, uint32_t previous) {
+    unsigned char pad[PAD_BYTES], accel[ADDON_BYTES], gyro[ADDON_BYTES];
+    memset(pad, 0xa7, sizeof(pad));
+    uint32_t devices = 2, trigger = frame->buttons & ~previous;
+    uint32_t release = frame->buttons & previous;
+    memcpy(pad + 0x184, &devices, 4);
+    memcpy(pad + 8, &trigger, 4); memcpy(pad + 12, &release, 4);
+    memcpy(pad + 0x114, &frame->buttons, 4);
+    memcpy(pad + 0x120, frame->sticks, 16);
+    CHECK(!memcmp(fake_pads[player].bytes, pad, sizeof(pad)));
+    for (int h = 0; h < 2; ++h) {
+        memset(accel, 0xb8, sizeof(accel)); memset(gyro, 0xc9, sizeof(gyro));
+        memcpy(accel + 0x2c, frame->accel[h], 12);
+        memcpy(gyro + 0x2c, frame->direction[h], 36);
+        memcpy(gyro + 0x50, frame->angular[h], 12);
+        CHECK(!memcmp(fake_accel[player][h].bytes, accel, sizeof(accel)));
+        CHECK(!memcmp(fake_gyro[player][h].bytes, gyro, sizeof(gyro)));
+    }
+}
+static void fake_movement(void *scene) {
+    CHECK(scene == fake_scene.bytes);
+    if (observe_writes)
+        for (unsigned p = 0; p < 2; ++p) verify_pad(p, observed[p], observed_previous[p]);
+    ++movement_calls;
+}
+static int fake_port(int player) {
+    CHECK(player == 0 || player == 1);
+    if (missing_port && player == 1) return -1;
+    return player ? 0 : 2; /* Deliberately not equal to player or Npad id. */
+}
+static void *fake_addon(void *pad, int id, int hand) {
+    ++addon_calls;
+    CHECK(hand == 0 || hand == 1);
+    CHECK(id == 1 || id == 4);
+    int player = pad == fake_pads[0].bytes ? 0 : pad == fake_pads[1].bytes ? 1 : -1;
+    CHECK(player >= 0);
+    if (player < 0 || (missing_addon && player == 1 && id == 4 && hand == 1)) return NULL;
+    return id == 1 ? fake_accel[player][hand].bytes : fake_gyro[player][hand].bytes;
+}
+static void *fake_system_get(void) { return fake_system_buffer.bytes; }
+static void *fake_executor_nerve(void *scene) {
+    CHECK(scene == fake_scene.bytes); ++keeper_calls; return fake_keeper.bytes;
+}
+static int fake_is_separate(void *holder) {
+    CHECK(holder == fake_scene.bytes + 0x20);
+    return separate_mode;
+}
+static int fake_connect_separate(void *pads) {
+    CHECK(pads == &system_pad_tag); ++separate_calls; return setup_ok && pads == &system_pad_tag;
+}
+static int fake_connect_single(void *pads) {
+    CHECK(pads == &system_pad_tag); ++single_calls; return setup_ok && pads == &system_pad_tag;
+}
+static void fake_change_mode(void *scene, int mode) {
+    CHECK(scene == fake_scene.bytes);
+    void *kit = NULL; memcpy(&kit, fake_scene.bytes + 0x90, sizeof(kit));
+    CHECK(kit == fake_actor_kit.bytes);
+    if (!kit) return; /* Model the original camera precondition without crashing. */
+    separate_mode = mode; ++change_calls;
+}
+static void *fake_scene_obj(void *holder, int id) {
+    CHECK(holder == fake_scene.bytes + 0x20 && id == 18); ++holder_calls;
+    return missing_holder ? NULL : &holder_tag;
+}
+static void fake_holder_mode(void *holder, int mode) {
+    CHECK(holder == &holder_tag); ++holder_mode_calls; separate_mode = mode;
+}
+static void *fake_player_get(void *scene) {
+    CHECK(scene == fake_scene.bytes); return &player_tag;
+}
+static void fake_puppet_start(void *p) {
+    CHECK(p == &player_tag && !puppet_active); puppet_active = 1; ++puppet_start_calls;
+}
+static void fake_puppet_end(void *p) {
+    CHECK(p == &player_tag && puppet_active); puppet_active = 0; ++puppet_end_calls;
+}
+static void fake_set_trans(void *p, const float *pos) {
+    CHECK(p == &player_tag && puppet_active); memcpy(player_position, pos, 12); ++trans_calls;
+}
+
+static const float *fake_get_trans(const void *p) { CHECK(p == &player_tag); return player_position; }
+
+static void reset_runtime(int initial_separate) {
+    dm_luna_free(&g_tape); free(g_rows); g_rows = NULL;
+    g_index = g_frame = 0; memset(g_previous, 0, sizeof(g_previous));
+    g_saved_players = 0; g_pending = g_wait = g_cleanup = g_owned = g_initial_separate = g_camera_pending = 0;
+    atomic_store(&g_active, 0); atomic_store(&g_selected, 0);
+    g_installed = 1; g_generation = 0; g_separate = 0;
+    g_continuous = g_live_separate = 0;
+    g_verify_position = g_position_checked = 0; memset(g_position_delta, 0, sizeof(g_position_delta));
+    g_ports[0] = g_ports[1] = -1; memset(g_applied, 0, sizeof(g_applied));
+    strcpy(g_phase, "idle"); g_error[0] = 0;
+    atomic_store(&text_active, 0); atomic_store(&g_lunakit, 0); atomic_store(&g_trigger, 0);
+    atomic_store(&g_luna_cleanup_pending, 0);
+    g_count = text_index = g_remaining = text_frame = g_total = 0; text_previous = 0;
+    g_legacy = 1;
+    memset(fake_pads, 0xa7, sizeof(fake_pads));
+    memset(fake_accel, 0xb8, sizeof(fake_accel)); memset(fake_gyro, 0xc9, sizeof(fake_gyro));
+    memset(&fake_manager, 0, sizeof(fake_manager)); memset(&fake_system_buffer, 0, sizeof(fake_system_buffer));
+    memset(&fake_scene, 0, sizeof(fake_scene));
+    memset(&fake_keeper, 0, sizeof(fake_keeper)); memset(&fake_nerve, 0, sizeof(fake_nerve));
+    scene_info.unused = NULL; scene_info.name = "10StageScene";
+    first_info.unused = NULL; first_info.name = "18FirstSequenceScene";
+    nerve_info.unused = NULL; nerve_info.name = "*SyntheticPlayNerve";
+    fake_scene_vtable[0] = fake_scene_vtable[2] = NULL; fake_scene_vtable[1] = &scene_info;
+    fake_first_vtable[0] = fake_first_vtable[2] = NULL; fake_first_vtable[1] = &first_info;
+    fake_nerve_vtable[0] = fake_nerve_vtable[2] = NULL; fake_nerve_vtable[1] = &nerve_info;
+    void *nerve_vt = &fake_nerve_vtable[2], *nerve = fake_nerve.bytes;
+    memcpy(fake_nerve.bytes, &nerve_vt, sizeof(nerve_vt));
+    memcpy(fake_keeper.bytes + 8, &nerve, sizeof(nerve));
+    fake_table[0] = fake_pads[1].bytes; fake_table[1] = NULL; fake_table[2] = fake_pads[0].bytes;
+    int count = 3; void *table = fake_table, *pads = &system_pad_tag, *nfp = &nfp_director_tag, *vt = &fake_scene_vtable[2];
+    memcpy(fake_manager.bytes + 0x188, &count, sizeof(count));
