+
+static void t_native_ipc(void) {
+    int pair[2]; CHECK(!socketpair(AF_UNIX, SOCK_STREAM, 0, pair), "native IPC socket pair opens");
+    pthread_t worker; atomic_fetch_add(&g_native_clients, 1);
+    CHECK(!pthread_create(&worker, NULL, native_socket_client, (void *)(intptr_t)pair[1]), "native IPC handler starts");
+    FILE *reply = fdopen(pair[0], "r"); char line[2048];
+    const char *down = "input 0 0 -32767 0 0\n";
+    CHECK(write(pair[0], down, strlen(down)) == (ssize_t)strlen(down) && fgets(line, sizeof line, reply) && strstr(line, "\"ok\":true"), "direct native input is acknowledged");
+    uint32_t id = 0; NpadState state;
+    h_hid_StatesFullKey(&state, 1, &id); dm_hid_commit();
+    const char *up = "input 0 0 0 0 0\n";
+    write(pair[0], up, strlen(up)); CHECK(fgets(line, sizeof line, reply) != NULL, "native release is acknowledged");
+    CHECK(g_consumed.ly == -32767, "an input acknowledgement does not pretend the game consumed the release");
+    h_hid_StatesFullKey(&state, 1, &id); dm_hid_commit();
+    CHECK(!g_consumed.ly, "the committed receipt changes after the game consumes release");
+    write(pair[0], "state\n", 6);
+    CHECK(fgets(line, sizeof line, reply) && strstr(line, "\"consumed\":") && strstr(line, "\"ly\":0"), "native state and committed input return directly on the socket");
+    const char *invalid = "input 0 999999 0 0 0\n";
+    write(pair[0], invalid, strlen(invalid));
+    CHECK(fgets(line, sizeof line, reply) && strstr(line, "\"error\":"), "invalid native axes are rejected");
+    /* The last global receipt can belong to P2; GUI input still targets P1. */
+    dm_pad_players(3); ids((uint32_t[]){0, 1, NPAD_HANDHELD}, 3);
+    dm_pad_set_player(0, DM_BTN_A, 0, 0, 0, 0); dm_pad_set_player(1, 0, 0, 0, 0, 0);
+    h_hid_StatesFullKey(&state, 1, &(uint32_t){0});
+    h_hid_StatesFullKey(&state, 1, &(uint32_t){1}); dm_hid_commit();
+    CHECK(g_received_id == 1 && !g_received.buttons && (g_consumed.buttons & DM_BTN_A),
+          "P2's later neutral read does not erase committed P1 A acknowledgement");
+    dm_pad_set_player(0, 0, 0, 0, 0, 0); dm_pad_set_player(1, DM_BTN_A, 0, 0, 0, 0);
+    h_hid_StatesFullKey(&state, 1, &(uint32_t){0});
+    h_hid_StatesFullKey(&state, 1, &(uint32_t){1}); dm_hid_commit();
+    CHECK((g_received.buttons & DM_BTN_A) && !g_consumed.buttons,
+          "P2's A does not prevent acknowledgement of P1 release");
+    dm_pad_set_player(1, 0, 0, 0, 0, 0); dm_pad_players(1);
+    fclose(reply); pthread_join(worker, NULL);
+    CHECK(!atomic_load(&g_native_clients), "native IPC disconnect releases its client slot");
+}
+
+static void t_recorded_joy_dual(void) {
+    setenv("DM_AUTOMATED_INPUT", "1", 1); setenv("DM_TEST_NPAD_STYLE", "joy-dual", 1);
+    h_hid_InitNpad(); g_mode = 1;
+    ids((const uint32_t[]){0, 1, NPAD_HANDHELD}, 3); dm_pad_players(3);
+    uint32_t p1 = 0, p2 = 1, handles[2]; NpadState state; SixAxisState sensor;
+    CHECK(h_hid_GetStyle(&p1) == STYLE_JOYDUAL && h_hid_GetStyle(&p2) == STYLE_JOYDUAL, "recorded controllers report paired Joy-Cons independently");
+    dm_pad_set_player(0, DM_BTN_A, 12345, -6789, 0, 0); dm_pad_set_player(1, DM_BTN_B, -23456, 0, 0, 0);
+    h_hid_StateJoyDual(&state, &p1);
+    CHECK(state.attributes && (state.buttons & 0xffff) == DM_BTN_A && state.lx == 12345 && state.ly == -6789, "JoyDual P1 preserves buttons and sticks");
+    h_hid_StateJoyDual(&state, &p2);
+    CHECK(state.attributes && (state.buttons & 0xffff) == DM_BTN_B && state.lx == -23456, "JoyDual P2 does not receive P1 input");
+    h_hid_StateFullKey(&state, &p1); CHECK(!state.attributes && !state.buttons, "JoyDual does not also appear as Pro Controller");
+    CHECK(h_hid_SixHandles(handles, 2, &p2, STYLE_JOYDUAL) == 2 && handles[0] == 0x105 && handles[1] == 0x10105, "paired Joy-Con sensor handles match original SDK device type 5");
+    CHECK(h_hid_SixStates(&sensor, 1, &handles[0]) == 1 && h_hid_SixStates(&sensor, 1, &handles[1]) == 1, "both Joy-Con sensors report connected");
+    CHECK(!six_connected(0x102) && !six_connected(0x20105) && !six_connected(0x1000105), "old style-bit encoding, excess device and reserved bytes are rejected");
+    struct { uint64_t guard0; NpadState samples[16]; uint64_t guard1; } pads = {.guard0 = 0x123456789abcdef0, .guard1 = 0xfedcba9876543210};
+    struct { uint64_t guard0; SixAxisState samples[16]; uint64_t guard1; } sensors = {.guard0 = 0x123456789abcdef0, .guard1 = 0xfedcba9876543210};
+    h_hid_StatesJoyDual(pads.samples, 16, &p2); h_hid_SixStates(sensors.samples, 16, &handles[1]);
+    CHECK(pads.guard0 == 0x123456789abcdef0 && pads.guard1 == 0xfedcba9876543210 && sensors.guard0 == 0x123456789abcdef0 && sensors.guard1 == 0xfedcba9876543210, "original caller capacities preserve Npad and sensor output guards");
+    dm_pad_players(1); CHECK(!h_hid_GetStyle(&p2) && !h_hid_SixStates(&sensor, 1, &handles[0]), "disconnect removes both paired controller and sensors");
+    g_mode = 0; CHECK(h_hid_GetStyle(&(uint32_t){NPAD_HANDHELD}) == STYLE_HANDHELD, "recorded docked style preserves handheld classification");
+    setenv("DM_TEST_NPAD_STYLE", "full-key", 1); h_hid_InitNpad();
+    unsetenv("DM_TEST_NPAD_STYLE"); unsetenv("DM_AUTOMATED_INPUT"); g_mode = 1;
+    dm_pad_set(0, 0, 0, 0, 0);
+    CHECK(h_hid_GetStyle(&p1) == STYLE_FULLKEY, "explicit default style restores Pro Controller");
+}
+
 int main(void) {
     t_slots();
     t_npads();
     t_vibration();
+    t_history();
+    NpadState pulse[2]; uint32_t id = 0;
+    ctl_input(0, 0, -32767, 0, 0); ctl_input(0, 0, 0, 0, 0);
+    h_hid_StatesFullKey(pulse, 2, &id);
+    CHECK(pulse[0].ly == -32767 && (pulse[0].buttons & (1u << 19)),
+          "a control-file stick tap between reads reaches one real HID sample");
+    h_hid_StatesFullKey(pulse, 2, &id);
+    CHECK(!pulse[0].ly && !pulse[0].buttons && pulse[1].ly == -32767,
+          "the short stick tap releases on the next sample and remains in history");
+    ctl_input(0, 32767, 0, 0, 0); ctl_input(0, -32767, 0, 0, 0);
+    h_hid_StatesFullKey(pulse, 2, &id);
+    CHECK(pulse[0].lx == -32767, "the latest held stick direction wins over a pending tap");
+    ctl_input(0, 0, 0, 0, 0); h_hid_StatesFullKey(pulse, 2, &id);
+    CHECK(!pulse[0].lx, "a sampled held direction has no extra delayed release");
+    {
+        NpadState before[2], repeated[2], advanced[2];
+        dm_pad_set(DM_BTN_A, 7000, -9000, 0, 0);
+        h_hid_StatesFullKey(before, 2, &id);
+        g_sample_due = 0;
+        dm_pad_set(DM_BTN_B, -11000, 12000, 0, 0);
+        for (int i = 0; i < 8; i++) h_hid_StatesFullKey(repeated, 2, &id);
+        CHECK(!memcmp(before, repeated, sizeof before),
+              "render-only reads preserve controller sampling numbers and both history entries");
+        g_sample_due = 1;
+        h_hid_StatesFullKey(advanced, 2, &id);
+        CHECK(advanced[0].sampling == before[0].sampling + 1 && advanced[0].lx == -11000 &&
+              (advanced[0].buttons & 0xffff) == DM_BTN_B && !memcmp(&advanced[1], &before[0], sizeof before[0]),
+              "the next simulation update consumes the new input once and retains the previous real sample");
+        dm_pad_set(0, 0, 0, 0, 0); h_hid_StatesFullKey(advanced, 2, &id);
+    }
+    t_native_ipc();
+    t_recorded_joy_dual();
     printf("hid players: %d checks, %d failed\n", checks, fails);
     return fails != 0;
 }
diff --git a/dm/host/tests/t_main_qos.c b/dm/host/tests/t_main_qos.c
new file mode 100644
index 0000000..0c39299
--- /dev/null
+++ b/dm/host/tests/t_main_qos.c
@@ -0,0 +1,31 @@
+// The guest main thread must not retain a front end's low inherited QoS.
+// Exercise the real thread initializer and macOS pthread scheduling API.
+#include "../dm.h"
+#include <pthread.h>
+#include <pthread/qos.h>
+#include <stdio.h>
+
+uint32_t svc_thread_main_init(void);
+static qos_class_t before, after;
+static int error;
+static void *guest(void *unused) {
+    (void)unused;
+    int relative;
+    error = pthread_get_qos_class_np(pthread_self(), &before, &relative);
+    svc_thread_main_init();
+    error |= pthread_get_qos_class_np(pthread_self(), &after, &relative);
+    return NULL;
+}
+int main(void) {
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    int rc = pthread_attr_set_qos_class_np(&attr, QOS_CLASS_UTILITY, 0);
+    pthread_t thread;
+    if (!rc) rc = pthread_create(&thread, &attr, guest, NULL);
+    pthread_attr_destroy(&attr);
+    if (rc) { fprintf(stderr, "Cannot start real QoS test: %d\n", rc); return 1; }
+    pthread_join(thread, NULL);
+    int ok = !error && before == QOS_CLASS_UTILITY && after == QOS_CLASS_USER_INTERACTIVE;
+    printf("main thread QoS: inherited %#x, guest %#x; %s\n", (unsigned)before, (unsigned)after, ok ? "passed" : "FAILED");
+    return !ok;
+}
diff --git a/dm/host/tests/t_smo_clock.c b/dm/host/tests/t_smo_clock.c
new file mode 100644
index 0000000..685fb0e
--- /dev/null
+++ b/dm/host/tests/t_smo_clock.c
@@ -0,0 +1,61 @@
+#include "../smo_clock.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static int failed, checks;
+static void check(int ok, const char *what) {
+    checks++; failed += !ok; printf("%s: %s\n", ok ? "PASS" : "FAIL", what);
+}
+int main(void) {
+    const uint64_t origin = 1000000000ull;
+    for (unsigned hz = 60; hz <= 480; hz *= 2) {
+        uint64_t last = 0; int64_t credit = 0; unsigned total = 0, max = 0;
+        dm_smo_clock_advance(origin, &last, &credit);
+        for (unsigned i = 1; i <= hz * 10; i++) {
+            unsigned ticks = dm_smo_clock_advance(origin + (uint64_t)i * 1000000000ull / hz, &last, &credit);
+            total += ticks; if (ticks > max) max = ticks;
+        }
+        check(total == 600 && max <= 1, "60/120/240/480 renderer Hz preserve exactly 600 game updates in ten seconds");
+    }
+    {
+        uint64_t last = 0, now = origin; int64_t credit = 0;
+        unsigned total = 0, early = 0, empty = 0;
+        dm_smo_clock_advance(now, &last, &credit);
+        for (unsigned frame = 0; frame < 600; frame++) {
+            now += frame % 2 ? 16500000 : 15500000;
+            unsigned ticks = dm_smo_clock_advance(now, &last, &credit);
+            if (!ticks) {
+                early++; now += dm_smo_clock_wait_ns(credit);
+                ticks = dm_smo_clock_advance(now, &last, &credit);
+            }
+            empty += ticks == 0; total += ticks;
+        }
+        check(early && !empty && total == 600 && llabs((int64_t)(now - origin) - 10000000000ll) <= 1100000ll,
+              "early capped frames wait for real time: 600 updates/draws in ten seconds, no cleanup-free extra draws");
+    }
+    {
+        uint64_t last = 0; int64_t credit = 0; unsigned total = 0;
+        dm_smo_clock_advance(origin, &last, &credit);
+        unsigned first = dm_smo_clock_advance(origin + 191000000ull, &last, &credit);
+        check(first == 4 && credit > 7000000000ll, "191 ms CPU stall caps work at four updates and retains outstanding time");
+        check(dm_smo_clock_wait_ns(credit) == 0, "outstanding catch-up debt never adds a renderer wait");
+        total += first;
+        for (unsigned i = 1; i <= 250; i++) {
+            unsigned ticks = dm_smo_clock_advance(origin + 191000000ull + i * 4000000ull, &last, &credit);
+            total += ticks;
+            if (ticks > 4) failed++;
+        }
+        check(total == 71 && llabs(credit) < 1000000000ll,
+              "uncapped rendering recovers the entire stall without losing simulation updates");
+    }
+    {
+        uint64_t last = 0; int64_t credit = 0;
+        dm_smo_clock_advance(origin, &last, &credit);
+        check(dm_smo_clock_advance(origin + 2000000000ull, &last, &credit) == 1,
+              "a two-second load/debugger pause does not replay seconds of stale input");
+        check(dm_smo_clock_advance(origin + 2000000000ull, &last, &credit) == 0,
+              "repeated renders at the same clock time do not advance gameplay");
+    }
+    printf("Odyssey fixed clock: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+}
diff --git a/dm/host/tests/t_smo_lunakit_runtime.c b/dm/host/tests/t_smo_lunakit_runtime.c
