diff --git a/dm/host/smo_clock.h b/dm/host/smo_clock.h
new file mode 100644
index 0000000..019a364
--- /dev/null
+++ b/dm/host/smo_clock.h
@@ -0,0 +1,28 @@
+#ifndef DM_SMO_CLOCK_H
+#define DM_SMO_CLOCK_H
+#include <stdint.h>
+
+// Wall time until the next update is eligible, including the existing 1 ms
+// early-update debt. A guarded draw must not skip the game's GPU cleanup.
+static inline uint64_t dm_smo_clock_wait_ns(int64_t credit) {
+    return credit >= 940000000ll ? 0 : (uint64_t)((940000000ll - credit + 59) / 60);
+}
+
+// Credit is nanoseconds * 60. Limit catch-up work, retaining the remaining
+// debt so ordinary CPU stalls cannot permanently slow the simulation clock.
+static inline unsigned dm_smo_clock_advance(uint64_t now, uint64_t *last, int64_t *credit) {
+    if (!*last) *credit = 1000000000ll;
+    else {
+        uint64_t dt = now >= *last ? now - *last : 0;
+        // A load or debugger stop does not replay seconds of stale input.
+        if (dt > 250000000ull) dt = 16666667ull;
+        *credit += (int64_t)dt * 60;
+    }
+    *last = now;
+    // A 1 ms early-update tolerance is debt, never extra long-term game time.
+    unsigned ticks = (unsigned)((*credit + 60000000ll) / 1000000000ll);
+    if (ticks > 4) ticks = 4;
+    *credit -= (int64_t)ticks * 1000000000ll;
+    return ticks;
+}
+#endif
