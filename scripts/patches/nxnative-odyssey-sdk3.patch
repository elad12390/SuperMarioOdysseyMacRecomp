+    for (int i = 0; i < 20; i++) { dm_pad_set(0, i * 100, 0, 0, 0); h_hid_StatesFullKey(s, 16, &id); }
+    CHECK(s[0].lx == 1900 && s[15].lx == 400 && s[0].sampling - s[15].sampling == 15,
