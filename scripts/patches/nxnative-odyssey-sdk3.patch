+// Odyssey base 1.0.0: separate GameSystem's frame-counted updates from drawing.
+// Framework calculation still runs for every render (graphics resource upkeep
+// is in that tree too). The original game/scene/actor/physics/UI update advances
+// at 60 Hz; extra draws do not increment those counters.
+#include "hle.h"
+#include "smo_clock.h"
+#include <stdatomic.h>
+#include <ctype.h>
+#include <math.h>
+#include <errno.h>
+#include <time.h>
+
+#define SMO_BASE_BUILD "3ca12dfaaf9c82da064d1698df79cda1"
+static void (*g_calc)(void *), (*g_update)(void *);
+static void (*g_draw)(void *);
+static void (*g_sequence_draw)(void *);
+static void *g_system, *g_interpolated_kit;
+void dm_smo_interp_install(void);
+void dm_smo_interp_capture(void *system);
+int dm_smo_interp_apply(void *system, double alpha);
+void dm_smo_interp_restore(void);
+void dm_smo_interp_json(FILE *f);
+void dm_hid_commit(void);
+void dm_smo_ui_capture(void *scene);
+void dm_smo_route_capture(void *system, void *scene, void *player);
+int dm_smo_replay_active(void);
+void dm_smo_replay_next(void);
+static _Atomic uint64_t g_logic_ticks, g_logic_cpu_ns, g_skipped;
+static _Atomic int g_render_fps = 60;
+static _Atomic int g_effective_fps = 60;
+static _Atomic int g_show_fps;
+extern void front_fps_meter_install(void) __attribute__((weak_import));
+static uint64_t g_last; static int64_t g_credit;
+static int g_enabled;
+static int g_preferences_ready;
+static unsigned g_tick_count;
+static int g_render_only;
+static _Atomic int g_input_due;
+static void *g_sequence_vt, *g_scene_vt, *g_play_nerve_vt;
+static void *(*g_get_scene)(void *), *(*g_try_player)(void *, int), *(*g_get_player_nerve)(void *);
+static void *(*g_get_executor_nerve)(void *);
+static const float *(*g_get_trans)(void *);
+static void (*g_increment_draw)(void *), (*g_wait_draw)(void *), (*g_execute_view)(void *), (*g_pre_draw)(void *);
+static void (*g_wait_view)(void *), (*g_model_list)(void *), (*g_execute_draw)(void *), (*g_occlusion)(void *);
+static void (*g_temporal_update)(void *);
+static void (*g_exposure_calc)(void *), (*g_uniform_swap)(void *);
+static void (*g_kit_pre_draw)(void *);
+static _Atomic uint64_t g_temporal_extra;
+static _Atomic uint64_t g_exposure_extra;
+static void *g_defer_scene, *g_deferred_scene;
+static _Atomic uint64_t g_preparations, g_deferred_preparations;
+static pthread_mutex_t g_observe_mu = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+    char sequence[160], scene[160], player[160], pause[160], options[160];
+    char pause_list[160], options_list[160], config_list[160];
+    int scene_step, player_step, has_player, pause_step, options_step, pause_selected, options_selected, config_selected, config_rows;
+    float pos[3];
+} g_observed;
+extern void nvn_present_config(int hz, int display_mode);
+extern uint64_t mtl_display_presents(void);
+extern int front_screen_max_fps(void);
+int dm_smo_render_fps_get(void) { return atomic_load(&g_render_fps); }
+int dm_game_render_target(void) { return g_enabled ? atomic_load(&g_effective_fps) : -1; }
+int dm_game_input_sample(void) { return !g_enabled || atomic_load(&g_input_due); }
+
+static void type_name(void *object, char out[160]) {
+    out[0] = 0; if (!object) return;
+    void **vt = *(void ***)object; if (!vt || !vt[-1]) return;
+    const char *name = ((const char **)vt[-1])[1]; if (!name) return;
+    if (*name == '*') name++; // Itanium non-unique RTTI names (anonymous nerve classes).
+    size_t n = 0; while (n < 159 && (isalnum((unsigned char)name[n]) || name[n] == '_')) { out[n] = name[n]; n++; } out[n] = 0;
+}
+static void nerve(void *keeper, char out[160], int *step) {
+    out[0] = 0; *step = 0; if (!keeper) return;
+    type_name(*(void **)((uint8_t *)keeper + 8), out);
+    *step = *(int *)((uint8_t *)keeper + 0x18);
+}
+static int scene_prepared(void *scene) {
+    if (!scene || !*(uint8_t *)((uint8_t *)scene + 0x28)) return 0;
+    void *keeper = g_get_executor_nerve(scene);
+    return keeper && *(int *)((uint8_t *)keeper + 0x18) >= 0;
+}
+static int active_play(void *system) {
+    void *seq = *(void **)((uint8_t *)system + 0x10);
+    if (!seq || *(void **)seq != g_sequence_vt) return 0;
+    void *scene = g_get_scene(seq);
+    if (!scene || *(void **)scene != g_scene_vt || !scene_prepared(scene)) return 0;
+    void *keeper = g_get_executor_nerve(scene);
+    void *current = *(void **)((uint8_t *)keeper + 8);
+    if (current && !g_play_nerve_vt) {
+        char name[160]; type_name(current, name);
+        if (!strcmp(name, "N12_GLOBAL__N_117StageSceneNrvPlayE")) g_play_nerve_vt = *(void **)current;
+    }
+    return current && *(void **)current == g_play_nerve_vt && *(int *)((uint8_t *)keeper + 0x18) >= 3;
+}
+static void apply_render_deadline(void *system) {
+    int target = active_play(system) ? atomic_load(&g_render_fps) : 60;
+    int previous = atomic_exchange(&g_effective_fps, target);
+    if (previous != target) { nvn_present_config(target, 1); LOG("Odyssey: effective render deadline %d (0 = uncapped; loading/menu remain 60)", target); }
+}
+static void prepare_view(void *scene, void *kit) {
+    g_execute_view(kit); g_pre_draw(scene); g_wait_view(kit);
+    atomic_fetch_add(&g_preparations, 1);
+    void *models = *(void **)((uint8_t *)kit + 0x60); if (models) g_model_list(models);
+    g_execute_draw(kit);
+    void *gfx = *(void **)((uint8_t *)kit + 0x38);
+    void *occlusion = gfx ? *(void **)((uint8_t *)gfx + 0x988) : NULL; if (occlusion) g_occlusion(occlusion);
+}
+static void kit_pre_draw(uint64_t *r) {
+    void *kit = (void *)(uintptr_t)r[0];
+    if (g_defer_scene && kit == *(void **)((uint8_t *)g_defer_scene + 0x90)) {
+        g_deferred_scene = g_defer_scene; atomic_fetch_add(&g_deferred_preparations, 1);
+    } else g_kit_pre_draw(kit);
+}
+static void restore_presentation(void) {
+    if (g_interpolated_kit) { g_wait_view(g_interpolated_kit); g_wait_draw(g_interpolated_kit); }
+    dm_smo_interp_restore(); g_interpolated_kit = NULL;
+}
+static void draw_fixed(void *framework) {
+    g_draw(framework);
+    // Framework drawing can retain camera pointers beyond Sequence::drawMain.
+    restore_presentation();
+}
+static void draw_prepared(void *sequence) {
+    void *scene = g_get_scene(sequence);
+    // A loader can publish a scene between simulation ticks. Keep its normal
+    // first calculation ahead of its first draw, as the original loop does.
+    if (scene && !scene_prepared(scene)) return;
+    int target = atomic_load(&g_effective_fps);
+    int high_rate = scene && g_system && *(void **)((uint8_t *)g_system + 0x10) == sequence &&
+        (target == 0 || target > 60) && active_play(g_system);
+    // Present-driven/frozen test clocks can require a draw before another
+    // tick. They still need the same shadow cleanup as every other image.
+    int clock_only_draw = g_render_only && scene && *(void **)scene == g_scene_vt;
+    if (high_rate || clock_only_draw || (scene && scene == g_deferred_scene)) {
+        void *kit = *(void **)((uint8_t *)scene + 0x90);
+        g_wait_view(kit); g_wait_draw(kit);
+        if (high_rate) dm_smo_interp_apply(g_system, fmax(0.0, fmin((double)g_credit / 1e9, 1.0)));
+        g_interpolated_kit = kit;
+        // Stateful fog/parts GPU preparation runs once, after the camera pose.
+        // Also prepare when interpolation history reset on a camera/scene cut.
+        prepare_view(scene, kit);
+    }
+    g_deferred_scene = NULL;
+    g_sequence_draw(sequence);
+}
+static void observe(void *system) {
+    void *ui_scene = NULL, *route_player = NULL;
+    pthread_mutex_lock(&g_observe_mu);
+    memset(&g_observed, 0, sizeof g_observed);
+    g_observed.pause_selected = g_observed.options_selected = g_observed.config_selected = -1;
+    void *seq = *(void **)((uint8_t *)system + 0x10);
+    if (seq) type_name(seq, g_observed.sequence);
+    if (seq && *(void **)seq == g_sequence_vt) {
+        void *scene = g_get_scene(seq);
+        if (scene) {
+            nerve(g_get_executor_nerve(scene), g_observed.scene, &g_observed.scene_step);
+        }
+        if (scene && *(void **)scene == g_scene_vt) {
+            ui_scene = scene;
+            // Exact base-build exePause/exeOption/getSelected disassembly:
+            // scene+180 -> pause, pause+40 -> MenuSelectParts, pause+70 -> Options.
+            // This observes real selection; input still follows the game's HID path.
+            if (strstr(g_observed.scene, "StageSceneNrvPauseE")) {
+                void *pause = *(void **)((uint8_t *)scene + 0x180);
+                if (pause) {
+                    nerve(g_get_executor_nerve(pause), g_observed.pause, &g_observed.pause_step);
+                    void *parts = *(void **)((uint8_t *)pause + 0x40);
+                    int list_step;
+                    if (parts) {
+                        nerve(g_get_executor_nerve(parts), g_observed.pause_list, &list_step);
+                        g_observed.pause_selected = *(int *)((uint8_t *)parts + 0x1c);
+                    }
+                    void *options = *(void **)((uint8_t *)pause + 0x70);
+                    if (options) {
+                        nerve(g_get_executor_nerve(options), g_observed.options, &g_observed.options_step);
+                        void *top = *(void **)((uint8_t *)options + 0x70);
+                        void *config = *(void **)((uint8_t *)options + 0xb0);
+                        if (top) {
+                            nerve(g_get_executor_nerve(top), g_observed.options_list, &list_step);
+                            g_observed.options_selected = *(int *)((uint8_t *)top + 0x3c);
+                        }
+                        if (config) {
+                            nerve(g_get_executor_nerve(config), g_observed.config_list, &list_step);
+                            g_observed.config_selected = *(int *)((uint8_t *)config + 0x3c);
+                            g_observed.config_rows = *(int *)((uint8_t *)config + 0x9c);
+                        }
+                    }
+                }
+            }
+            void *kit = *(void **)((uint8_t *)scene + 0x90);
+            void *holder = kit ? *(void **)((uint8_t *)kit + 0x98) : NULL;
+            void *player = holder ? g_try_player(holder, 0) : NULL;
+            route_player = player;
+            if (player && g_get_player_nerve && g_get_trans) {
+                nerve(g_get_player_nerve(player), g_observed.player, &g_observed.player_step);
+                const float *p = g_get_trans(player);
+                if (p && isfinite(p[0]) && isfinite(p[1]) && isfinite(p[2])) { memcpy(g_observed.pos, p, sizeof g_observed.pos); g_observed.has_player = 1; }
+            }
+        }
+    }
+    dm_smo_ui_capture(ui_scene);
+    dm_smo_route_capture(system, ui_scene, route_player);
+    pthread_mutex_unlock(&g_observe_mu);
+}
+
+// The render-only part of al::Scene::movement and view preparation.
+// The exact base-build offsets and call order are checked against the original
+// 0x9ce604 Scene::movement and the matching OdysseyDecomp implementation.
+// Keep the three model buffers moving even when the game/nerve step is held.
+static void graphics_only(void *system) {
+    void *seq = *(void **)((uint8_t *)system + 0x10);
+    if (!seq || *(void **)seq != g_sequence_vt) return;
+    void *scene = g_get_scene(seq);
+    if (!scene || *(void **)scene != g_scene_vt || !scene_prepared(scene)) return;
+    void *kit = *(void **)((uint8_t *)scene + 0x90);
+    if (!kit || !*(void **)((uint8_t *)kit + 0x40) || !*(void **)((uint8_t *)kit + 0x48) ||
+        !*(void **)((uint8_t *)kit + 0x50) || !*(void **)((uint8_t *)kit + 0x58)) return;
+    g_increment_draw(kit); g_wait_draw(kit);
+    // TemporalInterlace owns rendered-image history, not actor/physics time.
+    // Original GraphicsSystemInfo::updateGraphics rotates its three targets
+    // once per frame (main+879938..879940). Extra images otherwise reuse the
+    // same history slots and interlace parity. Advance only that render
+    // bookkeeping here; graphics parameter requests still belong to the tick.
+    void *graphics = *(void **)((uint8_t *)kit + 0x38);
+    void *temporal = *(void **)((uint8_t *)graphics + 0x2c0);
+    if (temporal) { g_temporal_update(temporal); atomic_fetch_add(&g_temporal_extra, 1); }
+    // HdrCompose::update performs this render bookkeeping before its 60 Hz
+    // parameter interpolation (main+9ad828..9ad82c and 9adce0..9add0c).
+    // AutoExposure::calc only commits the previous rendered histogram and
+    // rotates its two targets; do not replay HdrCompose's parameter timers.
+    void *hdr = *(void **)((uint8_t *)graphics + 0x108);
+    if (hdr) {
+        g_exposure_calc((uint8_t *)hdr + 0x30);
+        int views = *(int *)((uint8_t *)hdr + 0x20);
+        void **table = *(void ***)((uint8_t *)hdr + 0x28);
+        if (views < 0 || views > 8 || (views && !table)) die("Odyssey HDR view table does not match the verified build");
+        for (int i = 0; i < views; i++) {
+            void *block = *(void **)((uint8_t *)table[i] + 0x8a0);
+            if (block) g_uniform_swap(block);
+        }
+        atomic_fetch_add(&g_exposure_extra, 1);
+    }
+    // Preserve the completed tick's lighting/fog/graphics requests. Only view
+    // matrices and draw buffers need rebuilding for another render.
+    // draw_prepared performs the sole GPU preparation after interpolation.
+}
+
+static void calc_fixed(void *framework) {
+    restore_presentation();
+    guest_clock_read_wait();
+    unsigned ticks = dm_smo_clock_advance(guest_ns(), &g_last, &g_credit);
+    int target = atomic_load(&g_render_fps);
+    int extra_play = (target == 0 || target > 60) && g_system && active_play(g_system);
+    // A capped frame or a cutscene uses the original update/prepare/draw
+    // lifecycle. Rendering early would overwrite shadow-map owners without
+    // the next update's cleanup. Sleep only the remaining clock debt; retain
+    // all catch-up time. Uncapped gameplay keeps its render-only fast path.
+    while (!ticks && !extra_play && !dm_detclock_enabled() && !dm_guest_clock_is_frozen()) {
+        uint64_t delay = dm_smo_clock_wait_ns(g_credit);
+        struct timespec pause = { (time_t)(delay / 1000000000ull), (long)(delay % 1000000000ull) };
+        while (nanosleep(&pause, &pause) && errno == EINTR) {}
+        ticks = dm_smo_clock_advance(guest_ns(), &g_last, &g_credit);
+    }
+    g_render_only = ticks == 0;
+    // Each replay frame must get its own framework pad sample. Retain catch-up
+    // debt for subsequent renders rather than merging several source inputs.
+    if(dm_smo_replay_active() && ticks>1) { g_credit+=(int64_t)(ticks-1)*1000000000ll;ticks=1; }
+    if(ticks) dm_smo_replay_next();
+    g_tick_count = ticks;
+    atomic_store(&g_input_due, ticks != 0);
+    g_calc(framework); // Graphics allocation, uploads and frame cleanup still run.
+}
+
+static void update_fixed(void *system) {
+    g_system = system;
+    unsigned ticks = g_tick_count; g_tick_count = 0;
+    apply_render_deadline(system);
+    if (!ticks) { graphics_only(system); atomic_fetch_add(&g_skipped, 1); return; }
+    uint64_t t0 = clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID);
+    for (unsigned i = 0; i < ticks; i++) {
+        int target = atomic_load(&g_effective_fps);
+        if ((target == 0 || target > 60) && active_play(system))
+            g_defer_scene = g_get_scene(*(void **)((uint8_t *)system + 0x10));
+        g_update(system); atomic_fetch_add(&g_logic_ticks, 1);
+        g_defer_scene = NULL;
+        dm_smo_interp_capture(system);
+        observe(system);
+        dm_hid_commit(); // Wake native text/input waits after the UI snapshot.
+    }
+    apply_render_deadline(system);
+    atomic_fetch_add(&g_logic_cpu_ns, clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID) - t0);
+}
+
+static int preferences_path(char *path, size_t capacity) {
+    const char *override = getenv("DM_NATIVE_OPTIONS");
+    if (override && *override) return snprintf(path, capacity, "%s", override) < (int)capacity;
+    // Automated hosts must never fall back to Player's persistent preferences.
+    const char *automated = getenv("DM_AUTOMATED_INPUT");
+    if (automated && atoi(automated)) return 0;
+    const char *root = getenv("DM_ROOT");
+    return root && snprintf(path, capacity, "%s/run/native-options.ini", root) < (int)capacity;
+}
+
+static void save_preferences(void) {
+    if (!g_preferences_ready) return;
+    char path[2048], tmp[2056];
+    if (!preferences_path(path, sizeof path) || snprintf(tmp, sizeof tmp, "%s.new", path) >= (int)sizeof tmp) return;
+    FILE *f = fopen(tmp, "w");
+    if (!f) { LOG("[RED] Odyssey: cannot write native renderer preferences"); return; }
+    int failed = fprintf(f, "render_fps=%d\nshow_fps=%d\n", atomic_load(&g_render_fps), atomic_load(&g_show_fps)) < 0;
+    failed |= fclose(f) != 0;
+    if (failed || rename(tmp, path)) LOG("[RED] Odyssey: cannot save native renderer preferences");
+}
+
+int dm_smo_fps_meter_get(void) { return g_enabled && atomic_load(&g_show_fps); }
+int dm_smo_fps_meter_set(int enabled) {
+    if (!g_enabled || (enabled != 0 && enabled != 1)) return 0;
+    atomic_store(&g_show_fps, enabled);
+    save_preferences();
+    if (front_fps_meter_install) front_fps_meter_install();
+    return 1;
+}
+
+int dm_smo_render_fps_set(int fps) {
+    if (!g_enabled || (fps != 0 && (fps < 30 || fps > 480))) return 0;
+    atomic_store(&g_render_fps, fps);
+    // The scene boundary, not an initialization menu, releases this limit.
+    if (atomic_load(&g_effective_fps) != 60) atomic_store(&g_effective_fps, fps);
+    // Declare variable pacing before the first menu frame can opt out of QoS.
+    nvn_present_config(atomic_load(&g_effective_fps), 1);
+    save_preferences();
+    LOG("Odyssey: render limit %s%d, simulation fixed at 60 Hz", fps ? "" : "uncapped / ", fps);
+    return 1;
+}
+
+void dm_game_timing_json(FILE *f) {
+    if (!g_enabled) return;
+    fprintf(f, ",\"timing\":{\"logicTicks\":%llu,\"logicCpuNs\":%llu,\"drawsWithoutTick\":%llu,\"historyExtraUpdates\":%llu,\"exposureExtraUpdates\":%llu,\"renderFPS\":%d,\"effectiveRenderFPS\":%d",
+        (unsigned long long)atomic_load(&g_logic_ticks), (unsigned long long)atomic_load(&g_logic_cpu_ns),
+        (unsigned long long)atomic_load(&g_skipped), (unsigned long long)atomic_load(&g_temporal_extra),
+        (unsigned long long)atomic_load(&g_exposure_extra), atomic_load(&g_render_fps), atomic_load(&g_effective_fps));
+    pthread_mutex_lock(&g_observe_mu);
+    fprintf(f, ",\"sequence\":\"%s\",\"scene\":\"%s\",\"sceneStep\":%d,\"playerNerve\":\"%s\",\"playerStep\":%d,\"position\":",
+        g_observed.sequence, g_observed.scene, g_observed.scene_step, g_observed.player, g_observed.player_step);
+    if (g_observed.has_player) fprintf(f, "[%g,%g,%g]", g_observed.pos[0], g_observed.pos[1], g_observed.pos[2]); else fputs("null", f);
+    fprintf(f, ",\"menu\":{\"pauseNerve\":\"%s\",\"optionsNerve\":\"%s\",\"pauseStep\":%d,\"optionsStep\":%d,\"pauseSelected\":%d,\"optionsSelected\":%d,\"configSelected\":%d,\"configRows\":%d,\"pauseListNerve\":\"%s\",\"optionsListNerve\":\"%s\",\"configListNerve\":\"%s\"}",
+        g_observed.pause, g_observed.options, g_observed.pause_step, g_observed.options_step, g_observed.pause_selected, g_observed.options_selected,
+        g_observed.config_selected, g_observed.config_rows, g_observed.pause_list, g_observed.options_list, g_observed.config_list);
+    dm_smo_interp_json(f);
+    fprintf(f, ",\"graphicsPreparation\":{\"renders\":%llu,\"deferred\":%llu}",
+        (unsigned long long)atomic_load(&g_preparations), (unsigned long long)atomic_load(&g_deferred_preparations));
+    fprintf(f, ",\"display\":{\"presents\":%llu,\"maxHz\":%d}",
+        (unsigned long long)mtl_display_presents(), front_screen_max_fps());
+    fputc('}', f); pthread_mutex_unlock(&g_observe_mu);
+}
+
+void dm_smo_frame_install(void) {
+    if (strcmp(dm_main_build(), SMO_BASE_BUILD)) return;
+    g_pre_draw = guest_sym("_ZN2al18updateGraphicsPrevEPNS_5SceneE");
+    g_kit_pre_draw = guest_sym("_ZN2al12LiveActorKit15preDrawGraphicsEv");
+    if (!g_pre_draw || !g_kit_pre_draw || !gate_call_present(CALL_SMO_PRE_DRAW))
+        die("Odyssey render preparation requires the updated offline main rewrite");
+    gate_call_set(CALL_SMO_PRE_DRAW, kit_pre_draw);
+    const char *off = getenv("DM_SMO_FIXED_TICK");
+    if (off && !strcmp(off, "0")) return;
+    uint8_t *vt = guest_sym("_ZTV10GameSystem");
+    void *original = guest_sym("_ZN10GameSystem8movementEv");
+    uint8_t *framework_vt = guest_sym("_ZTVN2al15GameFrameworkNxE");
+    void *framework_calc = guest_sym("_ZN4sead15GameFrameworkNx9procCalc_Ev");
+    void *framework_draw = guest_sym("_ZN2al15GameFrameworkNx9procDraw_Ev");
+    // Exact build's GameSystem vtable: ABI prefix, NerveExecutor accessor,
+    // destructors, init, movement. RootTask::calc calls movement virtually.
+    void **slot = vt ? (void **)(vt + 0x30) : NULL;
+    void **calc_slot = framework_vt ? (void **)(framework_vt + 0x108) : NULL;
+    void **framework_draw_slot = NULL;
+    for (unsigned i = 2; framework_vt && i < 0x138/8; i++) if (((void **)framework_vt)[i] == framework_draw) {
+        if (framework_draw_slot) { framework_draw_slot = NULL; break; }
+        framework_draw_slot = ((void **)framework_vt) + i;
+    }
+    uint8_t *sequence_vt = guest_sym("_ZTV16HakoniwaSequence");
+    void *sequence_draw = guest_sym("_ZNK16HakoniwaSequence8drawMainEv");
+    void **draw_slot = NULL;
+    for (unsigned i = 2; sequence_vt && i < 24; i++) if (((void **)sequence_vt)[i] == sequence_draw) {
+        if (draw_slot) { draw_slot = NULL; break; } draw_slot = ((void **)sequence_vt) + i;
+    }
+    if (!slot || !original || *slot != original || !calc_slot || *calc_slot != framework_calc ||
+        !framework_draw || !framework_draw_slot || !sequence_draw || !draw_slot) {
+        LOG("[RED] Odyssey fixed tick: expected GameSystem::movement slot absent; keeping original timing"); return;
+    }
+    g_update = original; g_calc = framework_calc; g_draw = framework_draw;
+    g_sequence_draw = sequence_draw;
+    g_sequence_vt = (uint8_t *)guest_sym("_ZTV16HakoniwaSequence") + 16;
+    g_scene_vt = (uint8_t *)guest_sym("_ZTV10StageScene") + 16;
+    g_get_scene = guest_sym("_ZNK16HakoniwaSequence15getCurrentSceneEv");
+    g_try_player = guest_sym("_ZNK2al12PlayerHolder12tryGetPlayerEi");
+    g_get_player_nerve = guest_sym("_ZNK2al9LiveActor14getNerveKeeperEv");
+    g_get_executor_nerve = guest_sym("_ZNK2al13NerveExecutor14getNerveKeeperEv");
+    g_get_trans = guest_sym("_ZN2al8getTransEPKNS_9LiveActorE");
+    g_increment_draw = guest_sym("_ZN2al26incrementDrawBufferCounterEPKNS_12LiveActorKitE");
+    g_wait_draw = guest_sym("_ZN2al20waitUpdateDrawBufferEPKNS_12LiveActorKitE");
+    g_execute_view = guest_sym("_ZN2al21executeUpdateCalcViewEPKNS_12LiveActorKitE");
+    g_pre_draw = guest_sym("_ZN2al18updateGraphicsPrevEPNS_5SceneE");
+    g_wait_view = guest_sym("_ZN2al18waitUpdateCalcViewEPKNS_12LiveActorKitE");
+    g_model_list = guest_sym("_ZN2al26ModelDisplayListController6updateEv");
+    g_execute_draw = guest_sym("_ZN2al23executeUpdateDrawBufferEPKNS_12LiveActorKitE");
+    g_occlusion = guest_sym("_ZN2al29ModelOcclusionCullingDirector4calcEv");
+    g_temporal_update = guest_sym("_ZN2al17TemporalInterlace6updateEv");
+    g_exposure_calc = guest_sym("_ZN3agl3pfx12AutoExposure4calcEv");
+    g_uniform_swap = guest_sym("_ZN2al12UniformBlock4swapEv");
+    if (!g_get_scene || !g_try_player || !g_get_executor_nerve || !g_increment_draw || !g_wait_draw || !g_execute_view || !g_pre_draw ||
+        !g_wait_view || !g_model_list || !g_execute_draw || !g_occlusion || !g_temporal_update || !g_exposure_calc || !g_uniform_swap) {
+        LOG("[RED] Odyssey fixed tick: render-maintenance functions absent; keeping original timing"); return;
+    }
+    dm_guest_write_prepare(slot, sizeof *slot); *slot = update_fixed;
+    dm_guest_write_prepare(calc_slot, sizeof *calc_slot); *calc_slot = calc_fixed;
+    dm_guest_write_prepare(draw_slot, sizeof *draw_slot); *draw_slot = draw_prepared;
+    dm_guest_write_prepare(framework_draw_slot, sizeof *framework_draw_slot); *framework_draw_slot = draw_fixed;
+    dm_smo_interp_install();
+    g_enabled = 1;
+    const char *limit = getenv("DM_SMO_RENDER_FPS");
+    int fps = 60, show = !(getenv("DM_AUTOMATED_INPUT") && atoi(getenv("DM_AUTOMATED_INPUT")));
+    char path[2048];
+    if (preferences_path(path, sizeof path)) {
+        FILE *f = fopen(path, "r");
+        if (f) {
+            char line[128]; int value;
+            while (fgets(line, sizeof line, f)) {
+                if (sscanf(line, "render_fps=%d", &value) == 1) fps = value;
+                else if (sscanf(line, "show_fps=%d", &value) == 1 && (value == 0 || value == 1)) show = value;
+            }
+            fclose(f);
+        }
+    }
+    atomic_store(&g_show_fps, show);
+    if (!dm_smo_render_fps_set(limit ? atoi(limit) : fps)) dm_smo_render_fps_set(60);
+    g_preferences_ready = 1;
+    if (front_fps_meter_install) front_fps_meter_install();
+    LOG("Odyssey: fixed 60 Hz GameSystem update installed for %s", SMO_BASE_BUILD);
+}
diff --git a/dm/host/hle_smo_interpolate.c b/dm/host/hle_smo_interpolate.c
new file mode 100644
index 0000000..a201b9b
--- /dev/null
+++ b/dm/host/hle_smo_interpolate.c
@@ -0,0 +1,501 @@
+// Odyssey 1.0.0 temporal presentation; private ABI verified in original main
+// 3ca12dfaaf9c82da064d1698df79cda1. See tmp/odyssey/research/native-interpolation.md.
+// One caller thread. Parent gates active play / >60 FPS, captures after EACH
+// completed tick, waits view/draw writers before apply, prepares graphics on
+// EVERY render, and restores after procDraw_ + waitDraw and before root calc.
+#include "hle.h"
+#include <mach/mach.h>
+#include <math.h>
+#include <stdatomic.h>
+
+void dm_smo_interp_install(void);
+void dm_smo_interp_capture(void *gameSystem);
+int dm_smo_interp_apply(void *gameSystem, double alpha);
+void dm_smo_interp_restore(void);
+void dm_smo_interp_json(FILE *f);
+
+enum { MAX_MODELS = 2048, MAX_BONES = 32768, BONES_PER_MODEL = 1024,
+       MAX_GROUP = 65536, HASH_SIZE = 8192, REGION_CACHE = 32 };
+enum { ROOT = 0x3c8, SCALE = 0x3f8, DISPLAY_ROOT = 0x408,
+       BOUNDS_DIRTY = 0x162, BUFFER_COUNT = 0x158, BUFFER_REMAINING = 0x15c };
+_Static_assert(sizeof(void *) == 8 && sizeof(float) == 4, "Odyssey ABI");
+_Static_assert(SCALE == ROOT + 12*sizeof(float), "Verified contiguous model base and scale");
+
+typedef struct { float world[16], joint[12]; } Bone;
+typedef struct {
+    void *keeper, *ctrl, *object, *skeleton, *worlds, *joints, *display_root;
+    unsigned first, count, group_index;
+    float root_scale[15];
+    uint8_t eligible, old_bounds_dirty;
+} Model;
+typedef struct {
+    void *system, *sequence, *scene, *kit, *group, *entries;
+    void *nerve, *camera_info, *view, *camera, *projection, *render_view;
+    int32_t step, model_count, model_capacity;
+} Context;
+typedef struct {
+    Context ctx;
+    float pose[9], projection[16];
+    unsigned models, bones;
+    Model model[MAX_MODELS];
+    Bone bone[MAX_BONES];
+} Frame;
+typedef struct {
+    float camera[21];             // camera +8: view[12], eye[3], at[3], up[3]
+    float inverse_view[12], inverse_projection[16];
+} CameraBackup;
+
+static Frame *g_frames, *g_current, *g_previous, *g_backup;
+static CameraBackup g_camera_backup;
+static unsigned g_history;
+static int g_enabled, g_applied, g_logged;
+static int g_model_mode = 1; // Default: camera + root translation. Affine is opt-in until real-game QA.
+static void *g_sequence_vt, *g_scene_vt;
+static void *(*g_get_scene)(void *), *(*g_get_nerve)(void *);
+static void (*g_camera_matrix)(const void *, void *), (*g_calc_bounds)(void *);
+static int g_seen[3][HASH_SIZE];
+static struct { uintptr_t lo, hi; } g_regions[REGION_CACHE];
+static unsigned g_region_count;
+static _Atomic uint64_t g_captures, g_applies, g_restores, g_model_writes, g_restore_mismatches;
+static FILE *g_trace;
+static unsigned g_trace_rows;
+_Static_assert(3*sizeof(Frame) + sizeof g_seen < 12u*1024u*1024u, "Bounded interpolation storage");
+
+static void *field(const void *p, size_t off) { return (void *)((uintptr_t)p + off); }
+// Check mappings once per native region per call, rather than a syscall per
+// bone. Simulation/scene destruction cannot run during apply/restore's barrier.
+static int readable(const void *p, size_t n) {
+    uintptr_t a = (uintptr_t)p;
+    if (a < 0x1000 || !n || n > UINTPTR_MAX - a) return 0;
+    for (unsigned i = 0; i < g_region_count; i++)
+        if (a >= g_regions[i].lo && a + n <= g_regions[i].hi) return 1;
+    vm_address_t at = a;
+    vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t r = vm_region_64(mach_task_self(), &at, &size, VM_REGION_BASIC_INFO_64,
+                                  (vm_region_info_t)&info, &count, &object);
+    if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), object);
+    if (r != KERN_SUCCESS || at > a || size > UINTPTR_MAX - at || at + size < a + n ||
+        !(info.protection & VM_PROT_READ)) return 0;
+    if (g_region_count < REGION_CACHE) {
+        g_regions[g_region_count].lo = at; g_regions[g_region_count].hi = at + size;
+        g_region_count++;
+    }
+    return 1;
+}
+static int read_mem(const void *p, void *out, size_t n) {
+    if (!readable(p, n)) return 0;
+    memcpy(out, p, n); return 1;
+}
+static void *pointer(const void *p, size_t off) {
+    void *v = NULL; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static int32_t integer(const void *p, size_t off) {
+    int32_t v = -1; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static void write_mem(void *p, const void *src, size_t n) {
+    dm_guest_write_prepare(p, n); memcpy(p, src, n);
+}
+static int finite_values(const float *v, unsigned n) {
+    for (unsigned i = 0; i < n; i++) if (!isfinite(v[i]) || fabsf(v[i]) > 1e7f) return 0;
+    return 1;
+}
+static float distance2(const float *a, const float *b) {
+    float x = a[0] - b[0], y = a[1] - b[1], z = a[2] - b[2];
+    return x*x + y*y + z*z;
+}
+static int normalize(float v[3]) {
+    float n = v[0]*v[0] + v[1]*v[1] + v[2]*v[2];
+    if (!isfinite(n) || n < 1e-8f) return 0;
+    float k = 1.0f / sqrtf(n);
+    for (unsigned i = 0; i < 3; i++) v[i] *= k;
+    return 1;
+}
+static int camera_basis(const float pose[9], float dir[3], float up[3]) {
+    for (unsigned i = 0; i < 3; i++) { dir[i] = pose[i + 3] - pose[i]; up[i] = pose[i + 6]; }
+    if (!normalize(dir) || !normalize(up)) return 0;
+    float d = dir[0]*up[0] + dir[1]*up[1] + dir[2]*up[2];
+    return fabsf(d) < 0.98f;
+}
+static float dot3(const float *a, const float *b) { return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]; }
+static void lerp(float *out, const float *a, const float *b, unsigned n, float t) {
+    for (unsigned i = 0; i < n; i++) out[i] = a[i] + (b[i] - a[i]) * t;
+}
+static void native_to_sead(float out[12], const float in[16]) {
+    for (unsigned r = 0; r < 3; r++) for (unsigned c = 0; c < 4; c++) out[r*4+c] = in[c*4+r];
+}
+static float determinant(const float m[12]) {
+    return m[0]*(m[5]*m[10]-m[6]*m[9]) - m[1]*(m[4]*m[10]-m[6]*m[8]) + m[2]*(m[4]*m[9]-m[5]*m[8]);
+}
+// Affine lerp only below 25 degrees per basis axis and 20%/25% scale change.
+// Check the blended determinant too; a rejected model uses translation only.
+static int affine_small(const float a[12], const float b[12], float t) {
+    float product = 1.0f, mixed[12];
+    if (!finite_values(a, 12) || !finite_values(b, 12)) return 0;
+    for (unsigned c = 0; c < 3; c++) {
+        float av[3] = {a[c], a[4+c], a[8+c]}, bv[3] = {b[c], b[4+c], b[8+c]};
+        float aa = dot3(av, av), bb = dot3(bv, bv);
+        if (aa < 1e-8f || bb < 1e-8f || bb < aa*0.64f || bb > aa*1.5625f) return 0;
+        float ab = sqrtf(aa*bb);
+        if (dot3(av, bv) < 0.9063078f*ab) return 0;
+        product *= ab;
+    }
+    float da = determinant(a), db = determinant(b);
+    if (!isfinite(product) || da*db <= 0 || da*db < product*0.5f) return 0;
+    lerp(mixed, a, b, 12, t);
+    float dm = determinant(mixed);
+    return isfinite(dm) && dm*da > 0 && fabsf(dm) >= fminf(fabsf(da), fabsf(db))*0.75f;
+}
+
+static int context(void *system, Context *c) {
+    memset(c, 0, sizeof *c); c->system = system;
+    c->sequence = pointer(system, 0x10);
+    if (pointer(c->sequence, 0) != g_sequence_vt) return 0;
+    c->scene = g_get_scene(c->sequence);
+    uint8_t prepared = 0;
+    if (pointer(c->scene, 0) != g_scene_vt ||
+        !read_mem(field(c->scene, 0x28), &prepared, 1) || !prepared) return 0;
+    void *keeper = g_get_nerve(c->scene);
+    c->nerve = pointer(keeper, 8); c->step = integer(keeper, 0x18);
+    if (!c->nerve || c->step < 0) return 0;
+    c->kit = pointer(c->scene, 0x90);
+    void *director = pointer(c->kit, 0x78);
+    c->camera_info = pointer(director, 0x10);
+    int32_t views = integer(c->camera_info, 0);
+    if (views < 1 || views > 8) return 0;
+    c->view = pointer(pointer(c->camera_info, 8), 0);
+    c->camera = pointer(c->view, 8); c->projection = pointer(c->view, 0x10);
+    if (!c->camera || !c->projection) return 0;
+    void *table = pointer(pointer(c->kit, 0x38), 0x2a8);
+    if (integer(table, 0) > 0 && integer(table, 0) <= 8)
+        c->render_view = pointer(pointer(table, 8), 0);
+    c->group = pointer(c->kit, 0xf0);
+    c->entries = pointer(c->group, 0x10);
+    c->model_count = integer(c->group, 8); c->model_capacity = integer(c->group, 0xc);
+    return 1;
+}
+static int same_scene(const Context *a, const Context *b) {
+    return a->system == b->system && a->sequence == b->sequence && a->scene == b->scene &&
+        a->kit == b->kit && a->group == b->group && a->entries == b->entries &&
+        a->camera_info == b->camera_info && a->view == b->view && a->camera == b->camera &&
+        a->projection == b->projection && a->render_view == b->render_view && a->nerve == b->nerve;
+}
+static int capture_camera(Frame *f) {
+    uint8_t flags[3]; uint16_t projection_dirty;
+    if (!read_mem(field(f->ctx.view, 4), flags, sizeof flags) || !flags[0] || flags[1] ||
+        !read_mem(field(f->ctx.projection, 8), &projection_dirty, 2) || projection_dirty ||
+        !read_mem(field(f->ctx.camera, 0x38), f->pose, sizeof f->pose) ||
+        !read_mem(field(f->ctx.projection, 0x4c), f->projection, sizeof f->projection) ||
+        !finite_values(f->pose, 9) || !finite_values(f->projection, 16)) return 0;
+    float dir[3], up[3]; return camera_basis(f->pose, dir, up);
+}
+static int camera_continuous(const Frame *a, const Frame *b) {
+    float ad[3], au[3], bd[3], bu[3];
+    return !memcmp(a->projection, b->projection, sizeof a->projection) &&
+        distance2(a->pose, b->pose) <= 512.0f*512.0f &&
+        distance2(a->pose+3, b->pose+3) <= 512.0f*512.0f &&
+        camera_basis(a->pose, ad, au) && camera_basis(b->pose, bd, bu) &&
+        dot3(ad, bd) >= 0.8660254f && dot3(au, bu) >= 0.8660254f;
+}
+static int model_identity(Model *m, void *keeper) {
+    memset(m, 0, sizeof *m); m->keeper = keeper;
+    m->ctrl = pointer(keeper, 0x10); m->object = pointer(m->ctrl, 0);
+    m->skeleton = pointer(m->object, 0x38); m->worlds = pointer(m->skeleton, 0x20);
+    m->joints = pointer(keeper, 0x58); m->display_root = pointer(m->ctrl, DISPLAY_ROOT);
+    uint16_t count = 0;
+    if (!m->ctrl || !m->object || !m->skeleton || !m->worlds ||
+        !read_mem(field(m->skeleton, 0x50), &count, 2) || !count || count > BONES_PER_MODEL ||
+        !readable(m->worlds, count*0x40u) || (m->joints && !readable(m->joints, count*0x30u)) ||
+        !readable(field(m->ctrl, ROOT), sizeof m->root_scale)) return 0;
+    m->count = count;
+    uintptr_t world = (uintptr_t)m->worlds, joint = (uintptr_t)m->joints;
+    if (joint && world < joint+count*0x30u && joint < world+count*0x40u) return 0;
+    // A display root in our own joint cache is covered; an external one is not.
+    if (m->display_root) {
+        uintptr_t p = (uintptr_t)m->display_root, lo = (uintptr_t)m->joints;
+        if (!lo || p < lo || p-lo >= count*0x30u || (p-lo)%0x30u) return 0;
+    }
+    int32_t buffers = integer(m->ctrl, BUFFER_COUNT);
+    return buffers >= 1 && buffers <= 3;
+}
+static int same_model(const Model *a, const Model *b) {
+    return a->keeper == b->keeper && a->ctrl == b->ctrl && a->object == b->object &&
+        a->skeleton == b->skeleton && a->worlds == b->worlds && a->joints == b->joints &&
+        a->display_root == b->display_root && a->count == b->count;
+}
+static int live_model(const Context *c, const Model *m) {
+    Model live;
+    return c->model_count >= 0 && c->model_count <= MAX_GROUP &&
+        c->model_capacity >= c->model_count && c->model_capacity <= MAX_GROUP &&
+        m->group_index < (unsigned)c->model_count &&
+        pointer(c->entries, m->group_index*sizeof(void *)) == m->keeper &&
+        model_identity(&live, m->keeper) && same_model(&live, m);
+}
+static void copy_bones(Bone *out, const Model *m) {
+    for (unsigned i = 0; i < m->count; i++) {
+        memcpy(out[i].world, field(m->worlds, i*0x40u), 0x40);
+        if (m->joints) memcpy(out[i].joint, field(m->joints, i*0x30u), 0x30);
+        else memset(out[i].joint, 0, 0x30);
+    }
+}
+static int model_compare(const void *a, const void *b) {
+    uintptr_t x = (uintptr_t)((const Model *)a)->ctrl, y = (uintptr_t)((const Model *)b)->ctrl;
+    return (x > y) - (x < y);
+}
+static uintptr_t model_key(const Model *m, unsigned kind) {
+    return (uintptr_t)(kind == 0 ? m->ctrl : kind == 1 ? m->worlds : m->joints);
+}
+static void reject_shared_arrays(Frame *f) {
+    memset(g_seen, 0, sizeof g_seen);
+    for (unsigned i = 0; i < f->models; i++) for (unsigned kind = 0; kind < 3; kind++) {
+        uintptr_t key = model_key(&f->model[i], kind);
+        if (!key) continue;
+        unsigned h = (unsigned)((key >> 4) * UINT64_C(11400714819323198485)) & (HASH_SIZE-1);
+        while (g_seen[kind][h]) {
+            Model *old = &f->model[g_seen[kind][h]-1];
+            if (model_key(old, kind) == key) { old->eligible = f->model[i].eligible = 0; break; }
+            h = (h+1) & (HASH_SIZE-1);
+        }
+        if (!g_seen[kind][h]) g_seen[kind][h] = (int)i+1;
+    }
+}
+static Model *previous_model(const Model *m) {
+    Model *old = bsearch(m, g_previous->model, g_previous->models, sizeof *m, model_compare);
+    return old && old->eligible && same_model(old, m) ? old : NULL;
+}
+
+void dm_smo_interp_install(void) {
+    if (g_enabled || strcmp(dm_main_build(), "3ca12dfaaf9c82da064d1698df79cda1")) return;
+    const char *off = getenv("DM_SMO_INTERPOLATE");
+    if (off && !strcmp(off, "0")) return;
+    uint8_t *sequence = guest_sym("_ZTV16HakoniwaSequence"), *scene = guest_sym("_ZTV10StageScene");
+    g_get_scene = guest_sym("_ZNK16HakoniwaSequence15getCurrentSceneEv");
+    g_get_nerve = guest_sym("_ZNK2al13NerveExecutor14getNerveKeeperEv");
+    g_camera_matrix = guest_sym("_ZNK4sead12LookAtCamera14doUpdateMatrixEPNS_8Matrix34IfEE");
+    g_calc_bounds = guest_sym("_ZN2al9ModelCtrl12calcBoundingEv");
+    if (!sequence || !scene || !g_get_scene || !g_get_nerve || !g_camera_matrix || !g_calc_bounds) {
+        LOG("[RED] Odyssey interpolation: required base-build symbols absent"); return;
+    }
+    g_frames = calloc(3, sizeof *g_frames);
+    if (!g_frames) { LOG("[RED] Odyssey interpolation: bounded snapshot allocation failed"); return; }
+    g_sequence_vt = sequence+16; g_scene_vt = scene+16;
+    g_current = &g_frames[0]; g_previous = &g_frames[1]; g_backup = &g_frames[2];
+    const char *mode = getenv("DM_SMO_INTERP_MODE");
+    if (mode && !strcmp(mode, "camera")) g_model_mode = 0;
+    else if (mode && !strcmp(mode, "affine")) g_model_mode = 2;
+    g_enabled = 1;
+    char trace_path[2048];
+    const char *trace = getenv("DM_SMO_INTERP_TRACE");
+    const char *profile = getenv("DM_NVN_TSV");
+    if (!trace && profile && *profile &&
+        snprintf(trace_path, sizeof trace_path, "%s.interpolation.tsv", profile) < (int)sizeof trace_path) trace = trace_path;
+    if (trace && *trace) {
+        g_trace = fopen(trace, "w");
+        if (g_trace) fputs("sceneStep\talpha\tpreviousX\tpreviousY\tpreviousZ\tcurrentX\tcurrentY\tcurrentZ\trenderX\trenderY\trenderZ\tmodels\n", g_trace);
+    }
+    LOG("Odyssey: native interpolation ready (%zu bytes; max %d models / %d bones; mode %s)",
+        3*sizeof *g_frames + sizeof g_seen, MAX_MODELS, MAX_BONES,
+        g_model_mode == 0 ? "camera" : g_model_mode == 2 ? "affine" : "translation");
+}
+
+void dm_smo_interp_capture(void *system) {
+    if (!g_enabled) return;
+    if (g_applied) { g_history = 0; return; } // Caller must restore after the draw barrier first.
+    g_region_count = 0;
+    Frame *next = g_previous;
+    next->models = next->bones = 0;
+    if (!context(system, &next->ctx) || !capture_camera(next)) { g_history = 0; return; }
+    int continuous = g_history && same_scene(&g_current->ctx, &next->ctx) &&
+        next->ctx.step > g_current->ctx.step && next->ctx.step-g_current->ctx.step == 1 &&
+        camera_continuous(g_current, next);
+    if (g_model_mode && next->ctx.model_count >= 0 && next->ctx.model_count <= MAX_GROUP &&
+        next->ctx.model_capacity >= next->ctx.model_count && next->ctx.model_capacity <= MAX_GROUP &&
+        (next->ctx.model_count == 0 || readable(next->ctx.entries, next->ctx.model_count*sizeof(void *)))) {
+        for (int32_t i = 0; i < next->ctx.model_count && next->models < MAX_MODELS && next->bones < MAX_BONES; i++) {
+            Model m;
+            if (!model_identity(&m, pointer(next->ctx.entries, i*sizeof(void *))) ||
+                m.count > MAX_BONES-next->bones) continue;
+            memcpy(m.root_scale, field(m.ctrl, ROOT), sizeof m.root_scale);
+            if (!finite_values(m.root_scale, 15)) continue;
+            m.first = next->bones; m.group_index = (unsigned)i; m.eligible = 1;
+            copy_bones(&next->bone[m.first], &m);
+            next->bones += m.count; next->model[next->models++] = m;
+        }
+    }
+    qsort(next->model, next->models, sizeof(Model), model_compare);
+    reject_shared_arrays(next);
+    g_previous = g_current; g_current = next; g_history = continuous ? 2 : 1;
+    atomic_fetch_add(&g_captures, 1);
+}
+
+static int choose_affine(const Model *old, const Model *cur, float t) {
+    if (!affine_small(old->root_scale, cur->root_scale, t)) return 0;
+    for (unsigned i = 12; i < 15; i++) {
+        float a = old->root_scale[i], b = cur->root_scale[i];
+        if (a*b <= 0 || fabsf(b) < fabsf(a)*0.8f || fabsf(b) > fabsf(a)*1.25f) return 0;
+    }
+    for (unsigned i = 0; i < cur->count; i++) {
+        const Bone *a = &g_previous->bone[old->first+i], *b = &g_current->bone[cur->first+i];
+        float am[12], bm[12]; native_to_sead(am, a->world); native_to_sead(bm, b->world);
+        float relative_motion[3];
+        for (unsigned r = 0; r < 3; r++) relative_motion[r] =
+            (bm[r*4+3]-cur->root_scale[r*4+3]) - (am[r*4+3]-old->root_scale[r*4+3]);
+        if (dot3(relative_motion, relative_motion) > 128.0f*128.0f) return 0;
+        if (!affine_small(am, bm, t) || (cur->joints && !affine_small(a->joint, b->joint, t))) return 0;
+    }
+    return 1;
+}
+static int backup_model(const Model *cur, Model *save) {
+    *save = *cur; save->first = g_backup->bones;
+    memcpy(save->root_scale, field(cur->ctrl, ROOT), sizeof save->root_scale);
+    if (memcmp(save->root_scale, cur->root_scale, sizeof save->root_scale) ||
+        !read_mem(field(cur->ctrl, BOUNDS_DIRTY), &save->old_bounds_dirty, 1)) return 0;
+    copy_bones(&g_backup->bone[save->first], cur);
+    for (unsigned i = 0; i < cur->count; i++) {
+        const Bone *live = &g_backup->bone[save->first+i], *now = &g_current->bone[cur->first+i];
+        float world[12]; native_to_sead(world, live->world);
+        if (!finite_values(world, 12) || (cur->joints && !finite_values(live->joint, 12))) return 0;
+        for (unsigned v = 0; v < 4; v++)
+            if (memcmp(live->world+v*4, now->world+v*4, 3*sizeof(float))) return 0;
+        if (cur->joints && memcmp(live->joint, now->joint, sizeof live->joint)) return 0;
+    }
+    return 1;
+}
+static void apply_model(const Model *old, const Model *cur, const Model *save, float t, int affine) {
+    float delta[3], root_scale[15];
+    memcpy(root_scale, save->root_scale, sizeof root_scale);
+    for (unsigned r = 0; r < 3; r++) {
+        unsigned k = r*4+3;
+        delta[r] = (old->root_scale[k]-cur->root_scale[k])*(1.0f-t);
+        root_scale[k] += delta[r];
+    }
+    if (affine) lerp(root_scale, old->root_scale, cur->root_scale, 15, t);
+    write_mem(field(cur->ctrl, ROOT), root_scale, sizeof root_scale);
+    dm_guest_write_prepare(cur->worlds, cur->count*0x40u);
+    if (cur->joints) dm_guest_write_prepare(cur->joints, cur->count*0x30u);
+    for (unsigned i = 0; i < cur->count; i++) {
+        const Bone *a = &g_previous->bone[old->first+i], *b = &g_current->bone[cur->first+i];
+        const Bone *original = &g_backup->bone[save->first+i];
+        Bone out = *original; // Preserve every SIMD padding lane, bit for bit.
+        if (affine) {
+            for (unsigned v = 0; v < 4; v++) lerp(out.world+v*4, a->world+v*4, b->world+v*4, 3, t);
+            if (cur->joints) lerp(out.joint, a->joint, b->joint, 12, t);
+        } else for (unsigned r = 0; r < 3; r++) {
+            out.world[12+r] += delta[r];
+            if (cur->joints) out.joint[r*4+3] += delta[r];
+        }
+        memcpy(field(cur->worlds, i*0x40u), out.world, 0x40);
+        if (cur->joints) memcpy(field(cur->joints, i*0x30u), out.joint, 0x30);
+    }
+    uint8_t dirty = 1; int32_t refresh = integer(cur->ctrl, BUFFER_COUNT);
+    write_mem(field(cur->ctrl, BOUNDS_DIRTY), &dirty, 1);
+    write_mem(field(cur->ctrl, BUFFER_REMAINING), &refresh, sizeof refresh);
+}
+
+int dm_smo_interp_apply(void *system, double alpha) {
+    if (!g_enabled || g_applied || g_history < 2 || !isfinite(alpha)) return 0;
+    g_region_count = 0;
+    Context live; float pose[9], dir[3], up[3];
+    Frame *cur = g_current;
+    if (!context(system, &live) || !same_scene(&live, &cur->ctx) || live.step != cur->ctx.step ||
+        !live.render_view ||
+        !read_mem(field(live.render_view, 0x10), g_camera_backup.inverse_view, sizeof g_camera_backup.inverse_view) ||
+        !read_mem(field(live.render_view, 0x48), g_camera_backup.inverse_projection, sizeof g_camera_backup.inverse_projection) ||
+        !read_mem(field(live.camera, 8), g_camera_backup.camera, sizeof g_camera_backup.camera) ||
+        memcmp(g_camera_backup.camera+12, cur->pose, sizeof cur->pose)) { g_history = 0; return 0; }
+    float t = (float)fmax(0.0, fmin(alpha, 1.0));
+    if (t == 1.0f) return 0;
+    // Projection is never changed, including its lazy-update flags.
+    float projection[16]; uint16_t projection_dirty;
+    if (!read_mem(field(live.projection, 8), &projection_dirty, 2) || projection_dirty ||
+        !read_mem(field(live.projection, 0x4c), projection, sizeof projection) ||
+        memcmp(projection, cur->projection, sizeof projection)) { g_history = 0; return 0; }
+    lerp(pose, g_previous->pose, cur->pose, 9, t);
+    if (!camera_basis(pose, dir, up)) { g_history = 0; return 0; }
+    memcpy(pose+6, up, sizeof up);
+    g_backup->ctx = live; g_backup->models = g_backup->bones = 0;
+    g_applied = 1; // Backups exist before the first guest write.
+    write_mem(field(live.camera, 0x38), pose, sizeof pose);
+    dm_guest_write_prepare(field(live.camera, 8), 0x30);
+    g_camera_matrix(live.camera, field(live.camera, 8));
+    unsigned affine_count = 0, translation_count = 0;
+    if (g_model_mode && live.model_count == cur->ctx.model_count && live.model_capacity == cur->ctx.model_capacity) {
+        for (unsigned i = 0; i < cur->models; i++) {
+            Model *m = &cur->model[i], *old;
+            if (!m->eligible || !(old = previous_model(m)) || !live_model(&live, m)) continue;
+            if (!memcmp(old->root_scale, m->root_scale, sizeof m->root_scale) &&
+                !memcmp(&g_previous->bone[old->first], &cur->bone[m->first], m->count*sizeof(Bone))) continue;
+            float a[3], b[3];
+            for (unsigned r = 0; r < 3; r++) { a[r] = old->root_scale[r*4+3]; b[r] = m->root_scale[r*4+3]; }
+            if (distance2(a, b) > 256.0f*256.0f || m->count > MAX_BONES-g_backup->bones) continue;
+            Model *save = &g_backup->model[g_backup->models];
+            if (!backup_model(m, save)) continue;
+            int affine = g_model_mode == 2 && choose_affine(old, m, t);
+            if (!affine && !memcmp(a, b, sizeof a)) continue;
+            apply_model(old, m, save, t, affine);
+            g_backup->models++; g_backup->bones += m->count;
+            if (affine) affine_count++; else translation_count++;
+        }
+    }
+    if (!g_logged) {
+        LOG("Odyssey: native pose interpolation applied (camera, %u affine / %u translation models; alpha %.3f)",
+            affine_count, translation_count, (double)t); g_logged = 1;
+    }
+    atomic_fetch_add(&g_applies, 1);
+    atomic_fetch_add(&g_model_writes, affine_count + translation_count);
+    if (g_trace && g_trace_rows < 16384 && distance2(g_previous->pose, cur->pose) > 0.0001f) {
+        fprintf(g_trace, "%d\t%.9g", live.step, (double)t);
+        for (unsigned i = 0; i < 3; i++) fprintf(g_trace, "\t%.9g", (double)g_previous->pose[i]);
+        for (unsigned i = 0; i < 3; i++) fprintf(g_trace, "\t%.9g", (double)cur->pose[i]);
+        for (unsigned i = 0; i < 3; i++) fprintf(g_trace, "\t%.9g", (double)pose[i]);
+        fprintf(g_trace, "\t%u\n", affine_count + translation_count);
+        g_trace_rows++; if (!(g_trace_rows % 120)) fflush(g_trace);
+    }
+    return 1;
+}
+
+void dm_smo_interp_restore(void) {
+    if (!g_applied) return;
+    g_region_count = 0;
+    Context live;
+    if (context(g_backup->ctx.system, &live) && same_scene(&live, &g_backup->ctx)) {
+        write_mem(field(live.camera, 8), g_camera_backup.camera, sizeof g_camera_backup.camera);
+        if (memcmp(field(live.camera, 8), g_camera_backup.camera, sizeof g_camera_backup.camera))
+            atomic_fetch_add(&g_restore_mismatches, 1);
+        if (readable(field(live.render_view, 0x10), sizeof g_camera_backup.inverse_view) &&
+            readable(field(live.render_view, 0x48), sizeof g_camera_backup.inverse_projection)) {
+            write_mem(field(live.render_view, 0x10), g_camera_backup.inverse_view, sizeof g_camera_backup.inverse_view);
+            write_mem(field(live.render_view, 0x48), g_camera_backup.inverse_projection, sizeof g_camera_backup.inverse_projection);
+        }
+        for (unsigned i = 0; i < g_backup->models; i++) {
+            Model *m = &g_backup->model[i];
+            if (!live_model(&live, m)) { g_history = 0; continue; }
+            write_mem(field(m->ctrl, ROOT), m->root_scale, sizeof m->root_scale);
+            dm_guest_write_prepare(m->worlds, m->count*0x40u);
+            if (m->joints) dm_guest_write_prepare(m->joints, m->count*0x30u);
+            for (unsigned j = 0; j < m->count; j++) {
+                Bone *original = &g_backup->bone[m->first+j];
+                memcpy(field(m->worlds, j*0x40u), original->world, 0x40);
+                if (m->joints) memcpy(field(m->joints, j*0x30u), original->joint, 0x30);
+            }
+            // Native render-only bounds calculation from restored worlds. No
+            // animation, world recomputation, collision, sensor or pose calls.
+            g_calc_bounds(m->ctrl);
+            write_mem(field(m->ctrl, BOUNDS_DIRTY), &m->old_bounds_dirty, 1);
+            // BUFFER_REMAINING belongs to the real render writer: never rewind it.
+        }
+    } else g_history = 0; // Retired ownership: never dereference stale saved objects.
+    g_backup->models = g_backup->bones = 0;
+    g_applied = 0;
+    atomic_fetch_add(&g_restores, 1);
+}
+
+void dm_smo_interp_json(FILE *f) {
+    fprintf(f, ",\"interpolation\":{\"enabled\":%s,\"mode\":\"%s\",\"captures\":%llu,\"applies\":%llu,\"restores\":%llu,\"modelWrites\":%llu,\"restoreMismatches\":%llu}",
+        g_enabled ? "true" : "false", g_model_mode == 0 ? "camera" : g_model_mode == 2 ? "affine" : "translation",
+        (unsigned long long)atomic_load(&g_captures), (unsigned long long)atomic_load(&g_applies),
+        (unsigned long long)atomic_load(&g_restores), (unsigned long long)atomic_load(&g_model_writes),
+        (unsigned long long)atomic_load(&g_restore_mismatches));
+}
