+++ b/dm/host/smo_lunakit_pad.h
@@ -0,0 +1,24 @@
+// Odyssey base 1.0.0 controller-addon ABI, verified from original disassembly.
+// Source semantics: PlacidMink/smo-lunakit-tas stable, TAS::applyFrame.
+#pragma once
+#include "smo_lunakit_tape.h"
+typedef struct { unsigned char *pad, *accel[2], *gyro[2]; int port; } DmLunaPad;
+static inline void dm_luna_neutral(DmLunaFrame *f, unsigned player) {
+    memset(f, 0, sizeof *f); f->player = player;
+    for (int hand=0; hand<2; hand++) for(int i=0;i<3;i++) f->direction[hand][i*3+i]=1;
+}
+static inline void dm_luna_apply_pad(const DmLunaPad *p, const DmLunaFrame *f, uint32_t previous) {
+    uint32_t devices=2, trigger=f->buttons & ~previous;
+    // Preserve the published player's release expression, including its
+    // unusual held/previous intersection. Do not silently fix source tapes.
+    uint32_t release=f->buttons & previous;
+    memcpy(p->pad+0x184,&devices,4);
+    memcpy(p->pad+8,&trigger,4); memcpy(p->pad+12,&release,4);
+    memcpy(p->pad+0x114,&f->buttons,4);
+    memcpy(p->pad+0x120,f->sticks,sizeof f->sticks);
+    for(int hand=0;hand<2;hand++) {
+        memcpy(p->accel[hand]+0x2c,f->accel[hand],sizeof f->accel[hand]);
+        memcpy(p->gyro[hand]+0x2c,f->direction[hand],sizeof f->direction[hand]);
+        memcpy(p->gyro[hand]+0x50,f->angular[hand],sizeof f->angular[hand]);
+    }
+}
