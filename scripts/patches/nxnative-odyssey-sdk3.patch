--- /dev/null
+++ b/dm/host/tests/t_audio_record.c
@@ -0,0 +1,41 @@
+#include "../hle_audio_record.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static uint32_t u32(const unsigned char *p) {
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+static void verify(const char *path, int16_t left, int16_t right, unsigned expected) {
+    FILE *f = fopen(path,"rb"); assert(f);
+    unsigned char h[44]; assert(fread(h,1,sizeof h,f)==sizeof h);
+    assert(!memcmp(h,"RIFF",4) && !memcmp(h+8,"WAVEfmt ",8) && !memcmp(h+36,"data",4));
+    assert(h[20]==1 && h[22]==2 && h[34]==16 && u32(h+24)==48000);
+    uint32_t bytes=u32(h+40); assert(bytes>=expected*4 && bytes<(expected+4800)*4);
+    assert(u32(h+4)==bytes+36);
+    unsigned pairs=0; int16_t p[2];
+    while(fread(p,sizeof p,1,f)==1) {
+        if(p[0]||p[1]) { assert(p[0]==left && p[1]==right); pairs++; }
+    }
+    assert(pairs==expected); fclose(f);
+}
+int main(void) {
+    char path[]="build/audio-record-XXXXXX"; int fd=mkstemp(path); assert(fd>=0); close(fd);
+    int16_t pcm[2400*2];
+    for(unsigned i=0;i<2400;i++) { pcm[i*2]=1200;pcm[i*2+1]=-2400; }
+    assert(dm_audio_record_start(path));
+    dm_audio_record_push(pcm,2400,2); // split blocks must retain every sample.
+    dm_audio_record_stop(); verify(path,1200,-2400,2400);
+    assert(dm_audio_record_start(path)); // new clip replaces the previous take.
+    int16_t mono[480];for(unsigned i=0;i<480;i++)mono[i]=600;
+    dm_audio_record_push(mono,480,1);dm_audio_record_stop();verify(path,600,600,480);
+    assert(dm_audio_record_start(path));
+    dm_audio_record_push(mono,480,3);dm_audio_record_stop();
+    char *json=NULL;size_t length=0;FILE *meta=open_memstream(&json,&length);assert(meta);
+    dm_audio_record_json(meta);fclose(meta);
+    assert(strstr(json,"\"droppedFrames\":480") && strstr(json,"\"unixNs\":\""));free(json);
+    assert(!dm_audio_record_start("build/no-such-audio-folder/file.wav"));
+    dm_audio_record_stop();unlink(path);
+    puts("Native audio recording: WAV duration, stereo samples, mono, restart, dropped-frame reporting and invalid path passed");
+}
