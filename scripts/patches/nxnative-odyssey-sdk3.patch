@@ -0,0 +1,36 @@
+// Optional controller environment for the original legacy TAS, not new inputs.
+// No steering, position changes, added button presses or inferred Shake events.
+#include "dm.h"
+#include "smo_tas_motion.h"
+int dm_smo_replay_active(void);
+int dm_smo_replay_legacy(void);
+uint64_t dm_smo_replay_trigger(void);
+void dm_smo_luna_motion_observe(const SmoMotion *);
+static void (*g_motion_original)(void *);
+static int (*g_l_original)(int), (*g_count_original)(int);
+static int g_legacy;
+static int active(void) { return g_legacy && dm_smo_replay_legacy() && dm_smo_replay_active(); }
+static void motion(uint64_t *r) {
+    if(active()) smo_legacy_motion_apply((SmoMotion *)(uintptr_t)r[0],dm_smo_replay_trigger());
+    else {
+        g_motion_original((void *)(uintptr_t)r[0]);
+        dm_smo_luna_motion_observe((const SmoMotion *)(uintptr_t)r[0]);
+    }
+}
+static void camera_l(uint64_t *r) { r[0]=active()?0:(uint32_t)g_l_original((int)r[0]); }
+static void accel_count(uint64_t *r) { r[0]=active()?2:(uint32_t)g_count_original((int)r[0]); }
+void dm_smo_tas_motion_install(void) {
+    if(strcmp(dm_main_build(),"3ca12dfaaf9c82da064d1698df79cda1")) return;
+    int present=gate_call_present(CALL_SMO_MOTION) && gate_call_present(CALL_SMO_CAMERA_L) && gate_call_present(CALL_SMO_ACCEL_COUNT);
+    const char *profile=getenv("DM_SMO_TAS_MOTION");g_legacy=profile && !strcmp(profile,"legacy-2021");
+    if(!present) { if(g_legacy) die("legacy TAS motion requires the updated offline main rewrite"); return; }
+    module_t *m=NULL;for(int i=0;i<g_nmod;i++)if(!strcmp(g_mod[i].name,"main"))m=&g_mod[i];
+    g_motion_original=guest_sym("_ZN2al23JoyPadAccelPoseAnalyzer6updateEv");
+    g_l_original=guest_sym("_ZN2al13isPadTriggerLEi");
+    g_count_original=guest_sym("_ZN2al27getPadAccelerationDeviceNumEi");
+    if(!m || (uint8_t *)(uintptr_t)g_motion_original!=m->base+0x8656e0 ||
+       (uint8_t *)(uintptr_t)g_l_original!=m->base+0x85c678 || (uint8_t *)(uintptr_t)g_count_original!=m->base+0x862f2c)
+        die("legacy TAS motion symbols do not match the verified base build");
+    gate_call_set(CALL_SMO_MOTION,motion);gate_call_set(CALL_SMO_CAMERA_L,camera_l);gate_call_set(CALL_SMO_ACCEL_COUNT,accel_count);
+    LOG("Odyssey TAS motion: %s (normal game input outside active replay)",g_legacy?"published legacy-2021 mapping":"disabled");
+}
diff --git a/dm/host/hle_smo_ui.c b/dm/host/hle_smo_ui.c
