+    if (r != KERN_SUCCESS || at > a || size > UINTPTR_MAX-at ||
+        at+size < a+n || !(info.protection & VM_PROT_READ)) return 0;
+    if (g_region_count < MAX_REGIONS) {
+        g_regions[g_region_count].lo = at;
+        g_regions[g_region_count++].hi = at+size;
+    }
+    return 1;
+}
+static int read_mem(const void *p, void *out, size_t n) {
+    if (!readable(p, n)) return 0;
+    memcpy(out, p, n); return 1;
+}
+static void *pointer(const void *p, size_t off) {
+    void *v = NULL; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static int32_t integer(const void *p, size_t off) {
+    int32_t v = -1; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static int text(const char *p, char *out, size_t capacity, int stage) {
+    out[0] = 0;
+    for (size_t i = 0; i < capacity; i++) {
+        unsigned char c;
+        if (!read_mem(field(p, i), &c, 1)) break;
+        if (!c) { out[i] = 0; return i != 0; }
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '_' || (!stage && c == '*'))) break;
+        out[i] = (char)c;
+    }
+    out[0] = 0; return 0; // Reject unterminated, overlong or non-ASCII identifiers.
+}
+static int finite3(const float p[3]) {
+    for (unsigned i = 0; i < 3; i++)
+        if (!isfinite(p[i]) || fabsf(p[i]) > 1e8f) return 0;
+    return 1;
+}
+static void player_state(void *state, PlayerState *out) {
+    out->step=-1;
+    void *vt=pointer(state,0), *rtti=(uintptr_t)vt>=0x1008?pointer((void *)((uintptr_t)vt-8),0):NULL;
+    if(!text(pointer(rtti,8),out->type,sizeof out->type,0)) return;
+    void *keeper=pointer(state,8),*current=pointer(keeper,8);
+    vt=pointer(current,0);rtti=(uintptr_t)vt>=0x1008?pointer((void *)((uintptr_t)vt-8),0):NULL;
+    if(text(pointer(rtti,8),out->nerve,sizeof out->nerve,0)) out->step=integer(keeper,0x18);
+}
+static void capture_player_detail(void *player) {
+    if(actor_type(player)!=0) return;
+    // Exact original init: PlayerInput at +138, continuous-jump counter at
+    // +1b8, jump state +308 and damage state +378. This samples the game's
+    // processed trigger queries after its update, rather than HID receipts.
+    void *input=pointer(player,0x138),*continuous=pointer(player,0x1b8);
+    void *jump=pointer(player,0x308),*damage=pointer(player,0x378);
+    uintptr_t jvt=(uintptr_t)pointer(jump,0),dvt=(uintptr_t)pointer(damage,0);
+    if(pointer(input,0)!=player || !readable(input,0x140) ||
+       (jvt!=g_jump_vptr[0] && jvt!=g_jump_vptr[1] && jvt!=g_jump_vptr[2]) || dvt!=g_damage_vptr) return;
+    PlayerDetail *out=&g_work.player;
+    if(!read_mem(g_velocity(player),out->velocity,sizeof out->velocity) || !finite3(out->velocity) ||
+       !read_mem(field(input,0x98),&out->input_disabled,1) || out->input_disabled>1) return;
+    out->jump_count=integer(continuous,8);out->jump_window=integer(continuous,0xc);
+    if(out->jump_count<0 || out->jump_count>16 || out->jump_window<0 || out->jump_window>10000) return;
+    player_state(jump,&out->jump);player_state(damage,&out->damage);
+    out->trigger_jump=!!g_trigger_jump(input);out->hold_jump=!!g_hold_jump(input);
+    out->trigger_dive=!!g_trigger_dive(input);out->trigger_hip_drop=!!g_trigger_hip_drop(input);
+    out->valid=1;
+}
+static void capture_camera(void *kit) {
+    void *info = pointer(pointer(kit, 0x78), 0x10);
+    int32_t views = integer(info, 0);
+    if (views < 1 || views > 8) return;
+    void *view = pointer(pointer(info, 8), 0);
+    uint8_t flags[2];
+    float pose[6]; // eye at +0x38, target at +0x44, contiguous.
+    if (!read_mem(field(view, 4), flags, sizeof flags) || !flags[0] || flags[1] ||
+        !read_mem(field(pointer(view, 8), 0x38), pose, sizeof pose) ||
+        !finite3(pose) || !finite3(pose+3)) return;
+    // al::calcCameraFront (0x83bff0) computes target-eye. al::calcCameraDir
+    // reads the view matrix's BACKWARD axis instead; do not use its sign.
+    double x = (double)pose[3]-pose[0], z = (double)pose[5]-pose[2];
+    double length = sqrt(x*x+z*z);
+    if (!isfinite(length) || length < 1e-3) return;
+    g_work.camera_forward[0] = (float)(x/length);
+    g_work.camera_forward[1] = 0;
+    g_work.camera_forward[2] = (float)(z/length);
+    memcpy(g_work.camera_eye, pose, sizeof g_work.camera_eye);
+    memcpy(g_work.camera_target, pose+3, sizeof g_work.camera_target);
+    g_work.has_camera = 1;
+}
+static int actor_type(void *actor) {
+    uintptr_t vt = (uintptr_t)pointer(actor, 0);
+    if (vt) for (unsigned i = 0; i < sizeof g_types/sizeof g_types[0]; i++)
+        if (vt == g_types[i].vptr) return (int)i;
+    return -1;
+}
+static int capture_actor(void *actor, unsigned type) {
+    Actor a = {0};
+    a.step = -1;
+    void *flags = pointer(actor, 0x100);
+    uint8_t dead;
+    if (!read_mem(field(pointer(actor, 0x50), 8), a.position, sizeof a.position) ||
+        !finite3(a.position) || !read_mem(flags, &dead, 1) || dead > 1) return 0;
+    a.alive = !dead;
+    snprintf(a.type, sizeof a.type, "%s", g_types[type].type);
+    void *keeper = pointer(actor, 0x90);
+    if (keeper) {
+        a.step = integer(keeper, 0x18);
+        void *current = pointer(keeper, 8), *vt = pointer(current, 0);
+        void *rtti = (uintptr_t)vt >= 0x1008 ? pointer((const void *)((uintptr_t)vt-8), 0) : NULL;
+        const char *name = pointer(rtti, 8);
+        if (name && !text(name, a.nerve, sizeof a.nerve, 0)) return 0;
+        if (a.nerve[0] == '*') memmove(a.nerve, a.nerve+1, strlen(a.nerve));
+    }
+    if (g_work.count == MAX_ACTORS) { g_work.truncated = 1; return 1; }
+    g_work.actors[g_work.count++] = a;
+    return 1;
+}
+static void capture_actors(void *kit, void *player) {
+    void *group = pointer(kit, 0xc8);
+    int32_t capacity = integer(group, 0x10), count = integer(group, 0x14);
+    void *array = pointer(group, 0x18);
+    if (count < 0 || count > MAX_GROUP || capacity < count || capacity > MAX_GROUP ||
+        (count && !read_mem(array, g_actor_slots, (size_t)count*sizeof(void *)))) return;
+    g_work.scan_complete = 1;
+    // Provided player may not be in this registry. Preserve its real position
+    // too; the captured Frog remains a separate entry regardless of player nerve.
+    int pt = actor_type(player);
+    if (pt >= 0 && !capture_actor(player, (unsigned)pt)) g_work.scan_complete = 0;
+    for (int32_t i = 0; i < count; i++) {
+        g_slot_types[i] = actor_type(g_actor_slots[i]);
+        if (g_actor_slots[i] && !readable(g_actor_slots[i], sizeof(void *)))
+            g_work.scan_complete = 0;
+    }
+    // All interaction targets precede optional moving platforms in the limit.
+    for (unsigned priority = 0; priority < 2; priority++)
+        for (int32_t i = 0; i < count; i++) {
+            int t = g_slot_types[i];
+            if (t >= 0 && g_types[t].priority == priority && g_actor_slots[i] != player &&
+                !capture_actor(g_actor_slots[i], (unsigned)t)) g_work.scan_complete = 0;
+        }
+    // Do not carry any raw actor pointer across a capture/scene boundary.
+    memset(g_actor_slots, 0, (size_t)count*sizeof(void *));
+}
+
+void dm_smo_route_install(void) {
+    if (atomic_load(&g_installed) || strcmp(dm_main_build(), "3ca12dfaaf9c82da064d1698df79cda1")) return;
+    module_t *main = NULL;
+    for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) { main = &g_mod[i]; break; }
+    if (!main) return;
+    static const struct { const char *name; uintptr_t off; } checks[] = {
+        {"_ZTV10StageScene", 0x1d8bb70},
+        {"_ZN2al5Scene24initAndLoadStageResourceEPKci", 0x9ce6f0},
+        {"_ZN2al19StageResourceKeeper19initAndLoadResourceEPKci", 0xa26918},
+        {"_ZNK2al5Scene17getCameraDirectorEv", 0x9ce6c4},
+        {"_ZN2al12LiveActorKit15preDrawGraphicsEv", 0x910650},
+        {"_ZN2al12getCameraPosEPKNS_15SceneCameraInfoEi", 0x83bc20},
+        {"_ZN2al11getCameraAtEPKNS_15SceneCameraInfoEi", 0x83bc70},
+        {"_ZN2al15calcCameraFrontEPN4sead7Vector3IfEEPKNS_10IUseCameraEi", 0x83bff0},
+        {"_ZN2al12LiveActorKitC1Eii", 0x90fe84},
+        {"_ZN2al14LiveActorGroup13registerActorEPNS_9LiveActorE", 0x9106bc},
+        {"_ZN2al8getTransEPKNS_9LiveActorE", 0x8ee66c},
+        {"_ZNK2al9LiveActor14getNerveKeeperEv", 0x4c1c},
+        {"_ZN2al6isDeadEPKNS_9LiveActorE", 0x8d9980},
+        {"_ZNK2al13NerveExecutor14getNerveKeeperEv",0x14358},
+        {"_ZN11PlayerInputC2EPKN2al9LiveActorEPK19IUsePlayerCollisionPK13IUseDimension",0x44a98c},
+        {"_ZNK11PlayerInput13isTriggerJumpEv",0x44c728},
+        {"_ZNK11PlayerInput10isHoldJumpEv",0x44cc70},
+        {"_ZNK11PlayerInput20isTriggerHeadSlidingEv",0x44c7e8},
+        {"_ZNK11PlayerInput16isTriggerHipDropEv",0x44c7ac},
+        {"_ZN2al11getVelocityEPKNS_9LiveActorE",0x8e2a34},
+        {"_ZTV15PlayerStateJump",0x1d7e278},
+        {"_ZTV19PlayerStateJump2D3D",0x1d7e578},
+        {"_ZTV21PlayerStateNormalJump",0x1d7e7a8},
+        {"_ZTV21PlayerStateDamageLife",0x1d7d670},
+    };
+    for (unsigned i = 0; i < sizeof checks/sizeof checks[0]; i++)
+        if ((uintptr_t)module_sym(main, checks[i].name) != (uintptr_t)main->base+checks[i].off) {
+            LOG("[RED] SMO route: base-build symbol/address mismatch: %s", checks[i].name); return;
+        }
+    for (unsigned i = 0; i < sizeof g_types/sizeof g_types[0]; i++) {
+        void *symbol = module_sym(main, g_types[i].symbol);
+        if ((uintptr_t)symbol != (uintptr_t)main->base+g_types[i].offset) {
+            LOG("[RED] SMO route: base-build actor vtable mismatch: %s", g_types[i].symbol); return;
+        }
+        g_types[i].vptr = (uintptr_t)symbol+0x18;
+    }
+    g_stage_vptr = (uintptr_t)main->base+0x1d8bb70+0x10;
+    g_jump_vptr[0]=(uintptr_t)main->base+0x1d7e278+0x10;
+    g_jump_vptr[1]=(uintptr_t)main->base+0x1d7e578+0x10;
+    g_jump_vptr[2]=(uintptr_t)main->base+0x1d7e7a8+0x10;
+    g_damage_vptr=(uintptr_t)main->base+0x1d7d670+0x10;
+    g_trigger_jump=module_sym(main,"_ZNK11PlayerInput13isTriggerJumpEv");
+    g_hold_jump=module_sym(main,"_ZNK11PlayerInput10isHoldJumpEv");
+    g_trigger_dive=module_sym(main,"_ZNK11PlayerInput20isTriggerHeadSlidingEv");
+    g_trigger_hip_drop=module_sym(main,"_ZNK11PlayerInput16isTriggerHipDropEv");
+    g_velocity=module_sym(main,"_ZN2al11getVelocityEPKNS_9LiveActorE");
+    atomic_store(&g_installed, 1);
+    LOG("SMO route: read-only stage/camera/actor snapshot installed (64 actor limit)");
+}
+void dm_smo_route_capture(void *system, void *scene, void *player) {
+    (void)system; // Scene ownership and completed-update ordering belong to caller.
+    memset(&g_work, 0, sizeof g_work);
+    g_work.replay_frame=dm_smo_replay_frame();
+    g_region_count = g_region_queries = 0;
+    uint8_t alive = 0;
+    if (atomic_load(&g_installed) && scene && (uintptr_t)pointer(scene, 0) == g_stage_vptr &&
+        read_mem(field(scene, 0x28), &alive, 1) && alive &&
+        integer(pointer(scene, 8), 0x18) >= 0) {
+        // The loaded scene's resource name is authoritative even during a stage
+        // transition; GameDataHolder can already describe the next scene.
+        text(pointer(pointer(scene, 0x88), 8), g_work.stage, sizeof g_work.stage, 1);
+        void *kit = pointer(scene, 0x90);
+        capture_camera(kit); // Camera/stage get the memory-query budget FIRST.
+        capture_player_detail(player);
+        capture_actors(kit, player);
+    }
+    pthread_mutex_lock(&g_cache_mu);
+    g_cache = g_work;
+    pthread_mutex_unlock(&g_cache_mu);
+    // Including invalid/loading captures replaces the previous scene's snapshot.
+}
+void dm_smo_route_json(FILE *f) {
+    Snapshot s;
+    pthread_mutex_lock(&g_cache_mu);
+    s = g_cache;
+    pthread_mutex_unlock(&g_cache_mu);
+    fprintf(f,",\"route\":{\"replayFrame\":%u,\"stage\":",s.replay_frame);
+    if (s.stage[0]) fprintf(f, "\"%s\"", s.stage); else fputs("null", f);
+    fputs(",\"cameraForward\":", f);
+    if (s.has_camera) fprintf(f, "[%.9g,0,%.9g]", (double)s.camera_forward[0], (double)s.camera_forward[2]);
+    else fputs("null", f);
+    fputs(",\"cameraEye\":", f);
+    if (s.has_camera) fprintf(f, "[%.9g,%.9g,%.9g]", (double)s.camera_eye[0], (double)s.camera_eye[1], (double)s.camera_eye[2]);
+    else fputs("null", f);
+    fputs(",\"cameraTarget\":", f);
+    if (s.has_camera) fprintf(f, "[%.9g,%.9g,%.9g]", (double)s.camera_target[0], (double)s.camera_target[1], (double)s.camera_target[2]);
+    else fputs("null", f);
+    fputs(",\"actors\":[", f);
+    for (unsigned i = 0; i < s.count; i++) {
+        const Actor *a = &s.actors[i];
+        fprintf(f, "%s{\"type\":\"%s\",\"nerve\":\"%s\",\"step\":%d,\"position\":[%.9g,%.9g,%.9g],\"alive\":%s}",
+            i ? "," : "", a->type, a->nerve, (int)a->step,
+            (double)a->position[0], (double)a->position[1], (double)a->position[2], a->alive ? "true" : "false");
+    }
+    fprintf(f, "],\"actorScanComplete\":%s,\"actorsTruncated\":%s,\"player\":",
+        s.scan_complete ? "true" : "false", s.truncated ? "true" : "false");
+    const PlayerDetail *p=&s.player;
+    if(!p->valid) fputs("null",f);
+    else fprintf(f,"{\"velocity\":[%.9g,%.9g,%.9g],\"continuousJump\":%d,\"jumpWindow\":%d,"
+        "\"inputDisabled\":%s,\"triggerJump\":%s,\"holdJump\":%s,\"triggerDive\":%s,\"triggerHipDrop\":%s,"
+        "\"jump\":{\"type\":\"%s\",\"nerve\":\"%s\",\"step\":%d},\"damage\":{\"type\":\"%s\",\"nerve\":\"%s\",\"step\":%d}}",
+        (double)p->velocity[0],(double)p->velocity[1],(double)p->velocity[2],p->jump_count,p->jump_window,
+        p->input_disabled?"true":"false",p->trigger_jump?"true":"false",p->hold_jump?"true":"false",p->trigger_dive?"true":"false",p->trigger_hip_drop?"true":"false",
+        p->jump.type,p->jump.nerve,p->jump.step,p->damage.type,p->damage.nerve,p->damage.step);
+    fputc('}',f);
+}
