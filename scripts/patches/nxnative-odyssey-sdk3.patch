+    {"_ZTV16ElectricWirePole", "ElectricWirePole", 0x1cf5928, 0, 0},
+    {"_ZTV18ElectricWireTarget", "ElectricWireTarget", 0x1cf6178, 0, 0},
+    {"_ZTVN2al15FloaterMapPartsE", "al::FloaterMapParts", 0x1deeca8, 0, 1},
+    {"_ZTVN2al15KeyMoveMapPartsE", "al::KeyMoveMapParts", 0x1def5f8, 0, 1},
+    {"_ZTVN2al21SwitchKeyMoveMapPartsE", "al::SwitchKeyMoveMapParts", 0x1d38598, 0, 1},
+    {"_ZTVN2al21VisibleSwitchMapPartsE", "al::VisibleSwitchMapParts", 0x1df3858, 0, 1},
+    {"_ZTVN2al18SwitchOpenMapPartsE", "al::SwitchOpenMapParts", 0x1df32e8, 0, 1},
+    {"_ZTVN2al20SwitchDitherMapPartsE", "al::SwitchDitherMapParts", 0x1df2eb8, 0, 1},
+};
+static Snapshot g_work, g_cache;
