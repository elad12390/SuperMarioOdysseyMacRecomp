+++ b/dm/host/smo_lunakit_tape.h
@@ -0,0 +1,188 @@
+#ifndef DM_SMO_LUNAKIT_TAPE_H
+#define DM_SMO_LUNAKIT_TAPE_H
+
+/* LunaKit binary format emitted by xiivler/TSV-TAS-2 (tsv-tas.py):
+ * https://github.com/xiivler/TSV-TAS-2
+ * Compiler blob: 6f52cc38a614e4dfa96a6799af98618a37ecce91.
+ * Runtime format: PlacidMink/smo-lunakit-tas, stable, src/program/smo-tas/.
+ * https://github.com/PlacidMink/smo-lunakit-tas
+ * This independent decoder contains no game data or runtime/controller hooks.
+ *
+ * Records are sparse, ordered by (step, player), with zero-based player 0/1.
+ * frames is the final step plus one, not the number of records. Missing records
+ * do not imply held inputs; the runtime supplies neutral inputs for those steps.
+ * SEAD buttons and all finite IEEE-754 float32 bits are preserved verbatim.
+ */
+#include <float.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+_Static_assert(CHAR_BIT == 8 && sizeof(float) == 4 && FLT_RADIX == 2 &&
+               FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128,
+               "LunaKit decoding requires IEEE-754 binary32 floats");
+_Static_assert(sizeof(int32_t) == 4, "LunaKit decoding requires int32_t");
+
+enum {
+    DM_LUNA_HEADER_SIZE = 0x11c,
+    DM_LUNA_RECORD_SIZE = 0x94,
+    DM_LUNA_MAX_STEPS = 60000,
+    DM_LUNA_MAX_RECORDS = 120000
+};
+/* sead::Controller::PadIdx: A through Right occupy bits 0 through 19. */
+#define DM_LUNA_SEAD_BUTTON_MASK UINT32_C(0x000fffff)
+
+typedef struct {
+    uint32_t step, player, buttons;
+    float sticks[4];          /* left x/y, right x/y */
+    float accel[2][3];       /* left, right */
+    float direction[2][9];   /* left, right; row-major matrices */
+    float angular[2][3];     /* left, right */
+} DmLunaFrame;
+
+typedef struct {
+    DmLunaFrame *records;    /* owned; release with dm_luna_free */
+    size_t count;
+    uint32_t frames;
+    int two_player;
+    int32_t scenario;
+    char stage[128], entrance[128];
+    float pos[3];
+} DmLunaTape;
+
+static inline uint32_t dm_luna_u32le(const unsigned char *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline int dm_luna_error(char *error, size_t capacity, const char *text) {
+    if (error && capacity) (void)snprintf(error, capacity, "%s", text);
+    return -1;
+}
+
+static inline int dm_luna_float(const unsigned char *p, float *out, int stick) {
+    uint32_t bits = dm_luna_u32le(p);
+    if ((bits & UINT32_C(0x7f800000)) == UINT32_C(0x7f800000)) return -1;
+    memcpy(out, &bits, sizeof(bits));
+    return stick && (*out < -1.0f || *out > 1.0f) ? -1 : 0;
+}
+
+/* Only bytes before the first NUL belong to the string. Binary padding is
+ * ignored, as are the compiler's explicit 3x alignment bytes. */
+static inline int dm_luna_string(const unsigned char *p, char out[128]) {
+    size_t length = 0;
+    while (length < 128 && p[length]) {
+        if (p[length] > 0x7f) return -1;
+        ++length;
+    }
+    if (length == 128) return -1;
+    memcpy(out, p, length);
+    return 0; /* The destination was zero-initialized. */
+}
+
+/* On error, *out is byte-for-byte unchanged and a nonempty error message is
+ * written when error/capacity allow it. On success, *out receives one owned
+ * allocation and error is cleared. The caller must free an existing successful
+ * result before replacing it with another successful decode. Input memory can
+ * be unaligned and is never retained. error must not alias input or *out. */
+static inline int dm_luna_decode(const void *data, size_t length, DmLunaTape *out,
+                                 char *error, size_t capacity) {
+    const unsigned char *bytes = (const unsigned char *)data;
+    DmLunaTape tape = {0};
+    const char *failure = NULL;
+    size_t count;
+    uint32_t scenario_bits;
+
+    if (!data || !out)
+        return dm_luna_error(error, capacity, "null input or output");
+    if (length < DM_LUNA_HEADER_SIZE)
+        return dm_luna_error(error, capacity, "truncated LunaKit header");
+    if (memcmp(bytes, "BOOB", 4))
+        return dm_luna_error(error, capacity, "invalid LunaKit magic");
+    count = dm_luna_u32le(bytes + 4);
+    if (!count || count > DM_LUNA_MAX_RECORDS)
+        return dm_luna_error(error, capacity, "invalid LunaKit record count");
+    if (count > (SIZE_MAX - DM_LUNA_HEADER_SIZE) / DM_LUNA_RECORD_SIZE ||
+        length != DM_LUNA_HEADER_SIZE + (size_t)count * DM_LUNA_RECORD_SIZE)
+        return dm_luna_error(error, capacity, "LunaKit length does not match count");
+    if (bytes[8] > 1)
+        return dm_luna_error(error, capacity, "invalid two-player boolean");
+    tape.two_player = bytes[8];
+    scenario_bits = dm_luna_u32le(bytes + 12);
+    memcpy(&tape.scenario, &scenario_bits, sizeof(scenario_bits));
+    if (dm_luna_string(bytes + 16, tape.stage) ||
+        dm_luna_string(bytes + 144, tape.entrance))
+        return dm_luna_error(error, capacity, "stage and entrance must be terminated ASCII");
+    for (size_t i = 0; i < 3; ++i)
+        if (dm_luna_float(bytes + 272 + i * 4, &tape.pos[i], 0))
+            return dm_luna_error(error, capacity, "nonfinite starting position");
+    if (count > SIZE_MAX / sizeof(*tape.records))
+        return dm_luna_error(error, capacity, "LunaKit allocation size overflow");
+    tape.records = (DmLunaFrame *)calloc(count, sizeof(*tape.records));
+    if (!tape.records)
+        return dm_luna_error(error, capacity, "cannot allocate LunaKit records");
+    tape.count = count;
+
+    for (size_t i = 0; i < count; ++i) {
+        const unsigned char *p = bytes + DM_LUNA_HEADER_SIZE + i * DM_LUNA_RECORD_SIZE;
+        DmLunaFrame *frame = &tape.records[i];
+        frame->step = dm_luna_u32le(p);
+        frame->player = p[4];
+        frame->buttons = dm_luna_u32le(p + 8);
+        if (frame->step >= DM_LUNA_MAX_STEPS) {
+            failure = "LunaKit step exceeds limit";
+            break;
+        }
+        if (frame->player > 1 || (!tape.two_player && frame->player)) {
+            failure = "invalid LunaKit player";
+            break;
+        }
+        if (frame->buttons & ~DM_LUNA_SEAD_BUTTON_MASK) {
+            failure = "unknown SEAD button bits";
+            break;
+        }
+        if (i && (frame->step < tape.records[i - 1].step ||
+                  (frame->step == tape.records[i - 1].step &&
+                   frame->player <= tape.records[i - 1].player))) {
+            failure = "LunaKit records must be ordered without duplicates";
+            break;
+        }
+        for (size_t j = 0; j < 4; ++j)
+            if (dm_luna_float(p + 12 + j * 4, &frame->sticks[j], 1))
+                failure = "nonfinite or out-of-range LunaKit stick";
+        for (size_t hand = 0; hand < 2; ++hand) {
+            const size_t accel_offset = hand ? 40 : 28;
+            const size_t direction_offset = hand ? 100 : 52;
+            const size_t angular_offset = hand ? 136 : 88;
+            for (size_t j = 0; j < 3; ++j) {
+                if (dm_luna_float(p + accel_offset + j * 4, &frame->accel[hand][j], 0) ||
+                    dm_luna_float(p + angular_offset + j * 4, &frame->angular[hand][j], 0))
+                    failure = "nonfinite LunaKit motion";
+            }
+            for (size_t j = 0; j < 9; ++j)
+                if (dm_luna_float(p + direction_offset + j * 4,
+                                  &frame->direction[hand][j], 0))
+                    failure = "nonfinite LunaKit direction";
+        }
+        if (failure) break;
+    }
+    if (failure) {
+        free(tape.records);
+        return dm_luna_error(error, capacity, failure);
+    }
+    tape.frames = tape.records[count - 1].step + 1;
+    *out = tape;
+    if (error && capacity) error[0] = '\0';
+    return 0;
+}
+
+static inline void dm_luna_free(DmLunaTape *tape) {
+    if (!tape) return;
+    free(tape->records);
+    memset(tape, 0, sizeof(*tape));
+}
+
+#endif /* DM_SMO_LUNAKIT_TAPE_H */
