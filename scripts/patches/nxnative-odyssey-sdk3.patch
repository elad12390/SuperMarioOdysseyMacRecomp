+static int (*g_trigger_jump)(const void *), (*g_hold_jump)(const void *), (*g_trigger_dive)(const void *), (*g_trigger_hip_drop)(const void *);
+static const float *(*g_velocity)(const void *);
+static int actor_type(void *actor);
+static struct { uintptr_t lo, hi; } g_regions[MAX_REGIONS];
+static unsigned g_region_count, g_region_queries;
