--- /dev/null
+++ b/dm/host/hle_smo_ui.c
@@ -0,0 +1,377 @@
+// Read-only semantic snapshot of Odyssey base 1.0.0's own menu text.
+// Exact main build 3ca12dfaaf9c82da064d1698df79cda1; see native-ui-text.md.
+// Capture is GAME THREAD ONLY after completed GameSystem movement. JSON never
+// reads guest memory or calls guest code; it serializes a bounded host cache.
+#include "dm.h"
+#include <mach/mach.h>
+#include <stddef.h>
+#include <stdatomic.h>
+
+void dm_smo_ui_install(void);
+void dm_smo_ui_capture(void *scene);
+void dm_smo_ui_json(FILE *f);
+int dm_smo_options_is_graphics(void *owner);
+
+enum { MAX_ROWS = 32, MAX_PARTS = 32, MAX_ITEMS = 40, MAX_UNITS = 512,
+       TEXT_BYTES = MAX_UNITS*3+1, TYPE_BYTES = 128 };
+enum { NONE, PAUSE, OPTIONS, CONFIG, OTHER, GRAPHICS };
+enum { HEADING, OPTION };
+typedef struct {
+    uintptr_t vptr;
+    const uint16_t *text;
+    int32_t capacity;
+    uint16_t storage[512];
+} RowString;
+typedef struct {
+    int32_t count;
+    const uint16_t *const *texts;
+    int32_t initial;
+    uint8_t wrap;
+} Roll;
+typedef struct {
+    uintptr_t vptr;
+    void *keeper, *layout;
+    int32_t parts_count, parts_capacity;
+    void **parts;
+    void *cursor, *bar;
+    int32_t pane_count, selected, top;
+    uint8_t reserved44[0x24];
+    int32_t first;
+    uint32_t reserved6c;
+    const RowString *const *columns;
+    void *column_names;
+    uint8_t reserved80[0x10];
+    const uint8_t *enabled;
+    int32_t column_count, row_count;
+    uint8_t reserveda0[0x18];
+    const Roll *rolls;
+    const int32_t *values;
+    float speed;
+    uint8_t dirty, reservedcd[3];
+} List;
+typedef struct {
+    char text[TEXT_BYTES], value[TEXT_BYTES];
+    uint8_t role, selected, enabled, has_value;
+} Item;
+typedef struct {
+    Item items[MAX_ITEMS];
+    unsigned count;
+    int screen, visible, ready;
+    int vertical_allowed, horizontal_allowed;
+    int port, raw_down, stick_down, cursor_down, cursor_right, focus;
+} Snapshot;
+_Static_assert(sizeof(void *) == 8 && sizeof(RowString) == 0x418 &&
+               offsetof(RowString, text) == 8, "Verified row string ABI");
+_Static_assert(sizeof(Roll) == 0x18 && offsetof(Roll, texts) == 8, "Verified roll ABI");
+_Static_assert(sizeof(List) == 0xd0 && offsetof(List, selected) == 0x3c &&
+               offsetof(List, columns) == 0x70 && offsetof(List, enabled) == 0x90 &&
+               offsetof(List, row_count) == 0x9c && offsetof(List, rolls) == 0xb8 &&
+               offsetof(List, values) == 0xc0, "Verified CommonVerticalList ABI");
+_Static_assert(sizeof(Snapshot)*3 < 512u*1024u, "Bounded UI cache");
+
+static Snapshot g_work, g_cache, g_output;
+static pthread_mutex_t g_cache_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t g_output_mu = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic int g_installed;
+static void *g_stage_vptr;
+static const uint16_t *(*g_text)(const void *, const char *);
+static int (*g_exists)(const void *, const char *), (*g_hidden)(const void *, const char *);
+static int (*g_root_hidden)(const void *);
+static float (*g_alpha)(const void *, const char *);
+static int (*g_parts_index)(const void *, int), (*g_invalid_select)(const void *);
+static int (*g_action_playing)(const void *, const char *, const char *);
+static int (*g_is_roll)(const void *);
+static int (*g_port)(void), (*g_raw_down)(int), (*g_stick_down)(int), (*g_cursor_down)(int), (*g_cursor_right)(int);
+extern int dm_focus_now(void);
+
+static void *field(const void *p, size_t off) { return (void *)((uintptr_t)p + off); }
+static int read_mem(const void *p, void *out, size_t n) {
+    uintptr_t a = (uintptr_t)p;
+    vm_size_t got = 0;
+    return a >= 0x1000 && n && n <= UINTPTR_MAX-a &&
+        vm_read_overwrite(mach_task_self(), (vm_address_t)a, n, (vm_address_t)out, &got) == KERN_SUCCESS && got == n;
+}
+static void *pointer(const void *p, size_t off) {
+    void *v = NULL; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static int32_t integer(const void *p, size_t off) {
+    int32_t v = -1; read_mem(field(p, off), &v, sizeof v); return v;
+}
+static int ascii_string(const char *p, char out[TYPE_BYTES]) {
+    for (unsigned i = 0; i < TYPE_BYTES; i++) {
+        if (!read_mem(field(p, i), out+i, 1)) break;
+        if (!out[i]) return 1;
+    }
+    out[0] = 0; return 0;
+}
+// NerveExecutor +8 -> keeper; keeper +8 -> current nerve. Names are actual RTTI,
+// compared exactly, not substring guesses about a ready menu.
+static int nerve(void *executor, char name[TYPE_BYTES], int *step) {
+    name[0] = 0; *step = -1;
+    void *keeper = pointer(executor, 8), *current = pointer(keeper, 8);
+    void *vt = pointer(current, 0);
+    if (!vt || (uintptr_t)vt < 0x1008) return 0;
+    void *info = pointer((void *)((uintptr_t)vt-8), 0);
+    const char *type = pointer(info, 8);
+    *step = integer(keeper, 0x18);
+    if (*step < 0 || !ascii_string(type, name)) return 0;
+    if (name[0] == '*') memmove(name, name+1, strlen(name));
+    return 1;
+}
+static int exact(const char *name, const char *expected) { return !strcmp(name, expected); }
+
+static int utf16(const uint16_t *p, int capacity, char out[TEXT_BYTES]) {
+    unsigned used = 0;
+    uint16_t pending = 0;
+    out[0] = 0;
+    if (capacity < 1 || capacity > MAX_UNITS || ((uintptr_t)p & 1)) return 0;
+    for (int i = 0; i < capacity;) {
+        uint16_t block[32];
+        unsigned n = (unsigned)(capacity-i);
+        if (n > 32) n = 32;
+        if (!read_mem(field(p, (size_t)i*2), block, n*2)) {
+            n = 1;
+            if (!read_mem(field(p, (size_t)i*2), block, 2)) break;
+        }
+        for (unsigned j = 0; j < n; j++, i++) {
+            uint32_t c = block[j];
+            if (pending) {
+                if (c >= 0xdc00 && c <= 0xdfff) {
+                    c = 0x10000u + ((pending-0xd800u)<<10) + (c-0xdc00u);
+                    pending = 0;
+                } else { out[0] = 0; return 0; }
+            } else if (c >= 0xd800 && c <= 0xdbff) { pending = (uint16_t)c; continue; }
+            else if (c >= 0xdc00 && c <= 0xdfff) { out[0] = 0; return 0; }
+            if (!c) { out[used] = 0; return 1; }
+            if (c < 0x80) out[used++] = (char)c;
+            else if (c < 0x800) { out[used++] = (char)(0xc0|(c>>6)); out[used++] = (char)(0x80|(c&63)); }
+            else if (c < 0x10000) {
+                out[used++] = (char)(0xe0|(c>>12)); out[used++] = (char)(0x80|((c>>6)&63)); out[used++] = (char)(0x80|(c&63));
+            } else {
+                out[used++] = (char)(0xf0|(c>>18)); out[used++] = (char)(0x80|((c>>12)&63));
+                out[used++] = (char)(0x80|((c>>6)&63)); out[used++] = (char)(0x80|(c&63));
+            }
+        }
+    }
+    out[0] = 0; return 0; // Never publish an unterminated/truncated native label.
+}
+static int layout_valid(void *actor) {
+    void *keeper = pointer(actor, 0xe0);
+    void *layouter = pointer(keeper, 0x10);
+    return actor && pointer(actor, 8) && pointer(layouter, 0x18);
+}
+static int layout_visible(void *actor) {
+    uint8_t alive = 0;
+    return layout_valid(actor) && read_mem(field(actor, 0x128), &alive, 1) && alive &&
+        !g_root_hidden(field(actor, 8));
+}
+// IUseLayout is +8; this exact caller adjustment is verified in setSelectMessage.
+// Native getPaneStringBuffer returns TextBox's UTF-16 pointer in x0, not an sret.
+static int pane_text(void *actor, const char *pane, char out[TEXT_BYTES]) {
+    out[0] = 0;
+    if (!layout_valid(actor) || g_root_hidden(field(actor, 8)) ||
+        !g_exists(field(actor, 8), pane) || g_hidden(field(actor, 8), pane) ||
+        !(g_alpha(field(actor, 8), pane) > 0.0f)) return 0;
+    return utf16(g_text(field(actor, 8), pane), MAX_UNITS, out) && out[0];
+}
+static Item *next_item(void) { return g_work.count < MAX_ITEMS ? &g_work.items[g_work.count] : NULL; }
+static void heading(void *layout) {
+    Item *it = next_item();
+    if (it && pane_text(layout, "TxtOption", it->text)) {
+        it->role = HEADING; it->enabled = 1; g_work.count++; g_work.visible = 1;
+    }
+}
+static void pause_menu(void *pause, const char *pause_nerve) {
+    g_work.screen = PAUSE;
+    void *layout = pointer(pause, 0x20), *parts = pointer(pause, 0x40);
+    if (!layout_visible(layout)) return;
+    int count = integer(parts, 0x18), selected = integer(parts, 0x1c), max = integer(parts, 0x20);
+    void *array = pointer(parts, 0x28);
+    if (count < 1 || count > 5 || max < count || max > MAX_PARTS || selected < 0 || selected >= count || !array) return;
+    char part_nerve[TYPE_BYTES]; int step;
+    int ready = exact(pause_nerve, "N12_GLOBAL__N_131StageSceneStatePauseMenuNrvWaitE") &&
+        nerve(parts, part_nerve, &step) &&
+        (exact(part_nerve, "N12_GLOBAL__N_124MenuSelectPartsNrvSelectE") ||
+         exact(part_nerve, "N12_GLOBAL__N_130MenuSelectPartsNrvSelectSecondE"));
+    // Select's first execution resets this repeat controller into a blocked
+    // state. A neutral update clears it. Text can be visible before that.
+    uint8_t blocked = 1;
+    void *repeat = pointer(parts, 0x50);
+    ready = ready && step > 0 && read_mem(field(repeat, 0x10), &blocked, 1) && !blocked;
+    int selected_seen = 0;
+    for (int i = 0; i < count; i++) {
+        int physical = g_parts_index(parts, i);
+        if (physical < 0 || physical >= max) continue;
+        void *part = pointer(array, (size_t)physical*sizeof(void *));
+        Item *it = next_item();
+        if (!it || !pane_text(part, "TxtContent", it->text)) continue;
+        it->role = OPTION; it->selected = i == selected;
+        // IUseLayoutAction +0x10 and State/Deactive are the original pause code's
+        // actual disabled-animation group, not guessed disabled option indices.
+        it->enabled = !g_action_playing(field(part, 0x10), "Deactive", "State");
+        if (it->selected && g_invalid_select(parts)) it->enabled = 0;
+        selected_seen |= it->selected && it->enabled;
+        g_work.count++;
+    }
+    g_work.visible = g_work.count != 0;
+    g_work.ready = ready && selected_seen;
+    g_work.vertical_allowed = g_work.ready;
+}
+static void vertical_list(void *owner, void *layout, void *list, int config, const char *owner_nerve, int owner_step) {
+    g_work.screen = config ? (dm_smo_options_is_graphics(owner) ? GRAPHICS : CONFIG) : OPTIONS;
+    if (!layout_visible(layout)) return;
+    heading(layout);
+    List l;
+    if (!read_mem(list, &l, sizeof l) || l.layout != layout || !l.keeper ||
+        l.row_count < 1 || l.row_count > MAX_ROWS || l.column_count != 1 || !l.columns ||
+        l.parts_count < 1 || l.parts_count > MAX_PARTS || l.parts_capacity < l.parts_count ||
+        l.parts_capacity > MAX_PARTS || l.pane_count < 1 || l.pane_count > l.parts_count ||
+        l.selected < 0 || l.selected >= l.row_count || l.top < 0 || l.top >= l.row_count || !l.parts) return;
+    const RowString *labels = pointer(l.columns, 0);
+    if (!labels) return;
+    char list_nerve[TYPE_BYTES]; int list_step;
+    int ready = owner_step >= 6 && !l.dirty && integer(list, 0x50) <= 0 &&
+        exact(owner_nerve, config ? "N12_GLOBAL__N_130StageSceneStateOptionNrvConfigE" :
+                                  "N12_GLOBAL__N_133StageSceneStateOptionNrvOptionTopE") &&
+        nerve(list, list_nerve, &list_step) && exact(list_nerve, "N12_GLOBAL__N_127CommonVerticalListNrvActiveE");
+    // Native getSelectedParts: physical = selected - top + 1. Use a real pane
+    // to establish that the panel has visible text, while exposing ALL logical
+    // native rows so the controller can scroll to an initially offscreen row.
+    int physical = l.selected-l.top+1;
+    if (physical >= 0 && physical < l.parts_count) {
+        void *part = pointer(l.parts, (size_t)physical*sizeof(void *));
+        if (l.rolls && layout_valid(part) && g_is_roll(part)) ready = 0;
+        Item *probe = next_item();
+        if (probe && pane_text(part, "TxtContent", probe->text)) g_work.visible = 1;
+        if (probe) memset(probe, 0, sizeof *probe);
+    }
+    int selected_seen = 0;
+    for (int row = 0; row < l.row_count; row++) {
+        Item *it = next_item(); RowString label;
+        if (!it || !read_mem(field(labels, (size_t)row*sizeof label), &label, 0x14) ||
+            !utf16(label.text, label.capacity, it->text) || !it->text[0]) continue;
+        uint8_t enabled = 1;
+        if (l.enabled && !read_mem(field(l.enabled, (size_t)row), &enabled, 1)) enabled = 0;
+        Roll roll = {0};
+        int has_roll = l.rolls && l.values &&
+            read_mem(field(l.rolls, (size_t)row*sizeof roll), &roll, sizeof roll);
+        if (has_roll && roll.count >= 1 && roll.count <= 32 && roll.texts) {
+            // Read the visible TextBox, not the requested index. RollParts
+            // animates its old text out before binding the new value.
+            int p = row-l.top+1;
+            if (p >= 0 && p < l.parts_count) {
+                void *part = pointer(l.parts, (size_t)p*sizeof(void *));
+                it->has_value = pane_text(part, "TxtRoll", it->value);
+            }
+        }
+        it->role = config && !enabled && has_roll && roll.count == 1 ? HEADING : OPTION;
+        it->selected = it->role == OPTION && row == l.selected;
+        it->enabled = it->role == HEADING ? 1 : !!enabled;
+        selected_seen |= it->selected && it->enabled;
+        g_work.count++;
+    }
+    g_work.ready = ready && selected_seen && g_work.visible;
+    // InputSeparator's actual axis arbitration, from its isHold/isTrigger
+    // methods: recent preferred-axis input blocks the other axis until neutral.
+    void *separator = pointer(owner, 0x190);
+    uint8_t axis = 2, blocking = 1;
+    if (read_mem(field(separator, 8), &axis, 1) && read_mem(field(separator, 9), &blocking, 1)) {
+        int counter = integer(separator, 0x10);
+        g_work.vertical_allowed = g_work.ready && (axis == 1 || (!blocking && counter <= 0));
+        g_work.horizontal_allowed = g_work.ready && (axis == 0 || (!blocking && counter <= 0));
+    }
+}
+
+void dm_smo_ui_install(void) {
+    if (atomic_load(&g_installed) || strcmp(dm_main_build(), "3ca12dfaaf9c82da064d1698df79cda1")) return;
+    uint8_t *vt = guest_sym("_ZTV10StageScene");
+    g_text = guest_sym("_ZN2al19getPaneStringBufferEPKNS_10IUseLayoutEPKc");
+    g_is_roll = guest_sym("_ZNK2al9RollParts6isRollEv");
+    g_exists = guest_sym("_ZN2al11isExistPaneEPKNS_10IUseLayoutEPKc");
+    g_hidden = guest_sym("_ZN2al10isHidePaneEPKNS_10IUseLayoutEPKc");
+    g_root_hidden = guest_sym("_ZN2al14isHidePaneRootEPKNS_10IUseLayoutE");
+    g_alpha = guest_sym("_ZN2al14getGlobalAlphaEPKNS_10IUseLayoutEPKc");
+    g_parts_index = guest_sym("_ZNK15MenuSelectParts14calcPartsIndexEi");
+    g_invalid_select = guest_sym("_ZNK15MenuSelectParts15isInvalidSelectEv");
+    g_action_playing = guest_sym("_ZN2al15isActionPlayingEPKNS_16IUseLayoutActionEPKcS4_");
+    g_port = guest_sym("_ZN2al21getMainControllerPortEv");
+    g_raw_down = guest_sym("_ZN2al13isPadHoldDownEi");
+    g_stick_down = guest_sym("_ZN2al22isPadHoldDownLeftStickEi");
+    g_cursor_down = guest_sym("_ZN2al21isPadHoldUiCursorDownEi");
+    g_cursor_right = guest_sym("_ZN2al22isPadHoldUiCursorRightEi");
+    if (!vt || !g_text || !g_is_roll || !g_exists || !g_hidden || !g_root_hidden || !g_alpha ||
+        !g_parts_index || !g_invalid_select || !g_action_playing) {
+        LOG("[RED] SMO UI: required base-build text/selection symbols absent"); return;
+    }
+    g_stage_vptr = vt+16;
+    atomic_store(&g_installed, 1);
+    LOG("SMO UI: native pause/options/config text snapshot installed (game-thread capture)");
+}
+void dm_smo_ui_capture(void *scene) {
+    memset(&g_work, 0, sizeof g_work);
+    char scene_nerve[TYPE_BYTES], pause_nerve[TYPE_BYTES]; int step;
+    if (atomic_load(&g_installed) && scene && pointer(scene, 0) == g_stage_vptr &&
+        nerve(scene, scene_nerve, &step) && exact(scene_nerve, "N12_GLOBAL__N_118StageSceneNrvPauseE")) {
+        void *pause = pointer(scene, 0x180);
+        if (nerve(pause, pause_nerve, &step)) {
+            int options = exact(pause_nerve, "N12_GLOBAL__N_133StageSceneStatePauseMenuNrvOptionE") ||
+                          exact(pause_nerve, "N12_GLOBAL__N_141StageSceneStatePauseMenuNrvOptionFromHelpE");
+            if (options) {
+                void *owner = pointer(pause, 0x70);
+                char name[TYPE_BYTES]; int owner_step;
+                g_work.screen = OTHER;
+                if (nerve(owner, name, &owner_step)) {
+                    void *top = pointer(owner, 0x68), *config = pointer(owner, 0xa8);
+                    if (exact(name, "N12_GLOBAL__N_130StageSceneStateOptionNrvConfigE") ||
+                        (layout_visible(config) && !layout_visible(top)))
+                        vertical_list(owner, config, pointer(owner, 0xb0), 1, name, owner_step);
+                    else if (exact(name, "N12_GLOBAL__N_133StageSceneStateOptionNrvOptionTopE") || layout_visible(top))
+                        vertical_list(owner, top, pointer(owner, 0x70), 0, name, owner_step);
+                }
+            } else pause_menu(pause, pause_nerve);
+        }
+    }
+    for (unsigned i = 0; i < g_work.count; i++)
+        if (g_work.items[i].role == OPTION) g_work.items[i].enabled &= !!g_work.ready;
+    if (g_work.visible && g_port) {
+        g_work.port = g_port(); g_work.focus = dm_focus_now();
+        if (g_raw_down) g_work.raw_down = g_raw_down(g_work.port);
+        if (g_stick_down) g_work.stick_down = g_stick_down(g_work.port);
+        if (g_cursor_down) g_work.cursor_down = g_cursor_down(g_work.port);
+        if (g_cursor_right) g_work.cursor_right = g_cursor_right(g_work.port);
+    }
+    pthread_mutex_lock(&g_cache_mu); g_cache = g_work; pthread_mutex_unlock(&g_cache_mu);
+}
+static void json_string(FILE *f, const char *s) {
+    fputc('"', f);
+    for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
+        if (*p == '"' || *p == '\\') { fputc('\\', f); fputc(*p, f); }
+        else if (*p < 0x20) fprintf(f, "\\u%04x", (unsigned)*p);
+        else fputc(*p, f);
+    }
+    fputc('"', f);
+}
+void dm_smo_ui_json(FILE *f) {
+    static const char *const screens[] = {"none", "pause", "options", "config", "options.other", "graphics"};
+    pthread_mutex_lock(&g_output_mu);
+    pthread_mutex_lock(&g_cache_mu); g_output = g_cache; pthread_mutex_unlock(&g_cache_mu);
+    const Snapshot *s = &g_output;
+    fprintf(f, ",\"ui\":{\"screen\":"); json_string(f, screens[s->screen]);
+    fprintf(f, ",\"visible\":%s,\"ready\":%s,\"items\":[", s->visible ? "true" : "false", s->ready ? "true" : "false");
+    const char *selected = NULL;
+    for (unsigned i = 0; i < s->count; i++) {
+        const Item *it = &s->items[i];
+        if (i) fputc(',', f);
+        fprintf(f, "{\"role\":\"%s\",\"text\":", it->role == HEADING ? "heading" : "option");
+        json_string(f, it->text);
+        if (it->has_value) { fputs(",\"value\":", f); json_string(f, it->value); }
+        fprintf(f, ",\"selected\":%s,\"enabled\":%s}", it->selected ? "true" : "false", it->enabled ? "true" : "false");
+        if (it->selected) selected = it->text;
+    }
+    fputc(']', f);
+    if (selected) { fputs(",\"selectedText\":", f); json_string(f, selected); }
+    fprintf(f, ",\"actions\":{\"vertical\":%s,\"horizontal\":%s},\"inputDebug\":{\"port\":%d,\"rawDown\":%d,\"stickDown\":%d,\"cursorDown\":%d,\"cursorRight\":%d,\"focus\":%d}}",
+        s->vertical_allowed ? "true" : "false", s->horizontal_allowed ? "true" : "false",
+        s->port, s->raw_down, s->stick_down, s->cursor_down, s->cursor_right, s->focus);
+    pthread_mutex_unlock(&g_output_mu);
+}
