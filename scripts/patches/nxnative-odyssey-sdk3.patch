diff --git a/dm/host/hle_smo_replay.c b/dm/host/hle_smo_replay.c
new file mode 100644
index 0000000..c6c5425
--- /dev/null
+++ b/dm/host/hle_smo_replay.c
@@ -0,0 +1,107 @@
+// Native controller replay: source holds advance on simulation updates.
+// The file is loaded once; the browser and socket timing are not the clock.
+#include "dm.h"
+#include <stdatomic.h>
+
+void dm_pad_set(uint64_t, int32_t, int32_t, int32_t, int32_t);
+enum { REPLAY_MAX_ROWS = 60000, REPLAY_MAX_FRAMES = 60000 };
+typedef struct { uint32_t frames; uint64_t buttons; int32_t axes[4]; } ReplayRow;
+static ReplayRow *g_rows;
+static uint32_t g_count, g_index, g_remaining, g_frame, g_total;
+static _Atomic int g_active;
+static _Atomic uint64_t g_trigger;
+static uint64_t g_previous;
+static pthread_mutex_t g_replay_mu = PTHREAD_MUTEX_INITIALIZER;
+int dm_smo_luna_active(void), dm_smo_luna_selected(void), dm_smo_luna_load(const char *);
+uint32_t dm_smo_luna_frame(void);
+void dm_smo_luna_stop(void), dm_smo_luna_json(FILE *), dm_smo_luna_status(FILE *);
+static _Atomic int g_lunakit;
+static _Atomic int g_luna_cleanup_pending;
+
+int dm_smo_replay_active(void) { return atomic_load(&g_active) || dm_smo_luna_active(); }
+int dm_smo_replay_legacy(void) { return !atomic_load(&g_lunakit); }
+uint64_t dm_smo_replay_trigger(void) { return atomic_load(&g_trigger); }
+uint32_t dm_smo_replay_frame(void) {
+    if(atomic_load(&g_lunakit))return dm_smo_luna_frame();
+    pthread_mutex_lock(&g_replay_mu);uint32_t frame=g_frame;pthread_mutex_unlock(&g_replay_mu);return frame;
+}
+void dm_smo_replay_stop(void) {
+    dm_smo_luna_stop();
+    pthread_mutex_lock(&g_replay_mu);
+    atomic_store(&g_active, 0);
+    atomic_store(&g_luna_cleanup_pending,0);
+    atomic_store(&g_trigger, 0); g_previous = 0;
+    free(g_rows); g_rows = NULL; g_count = g_index = g_remaining = 0;
+    dm_pad_set(0,0,0,0,0);
+    pthread_mutex_unlock(&g_replay_mu);
+}
+int dm_smo_replay_load(const char *path) {
+    FILE *f = fopen(path,"rb"); if (!f) return 0;
+    char magic[4];size_t n=fread(magic,1,4,f);rewind(f);
+    if(n==4 && !memcmp(magic,"BOOB",4)) {
+        fclose(f);if(!dm_smo_luna_load(path))return 0;
+        pthread_mutex_lock(&g_replay_mu);
+        atomic_store(&g_active,0);atomic_store(&g_lunakit,1);
+        atomic_store(&g_trigger,0);g_previous=0;dm_pad_set(0,0,0,0,0);
+        pthread_mutex_unlock(&g_replay_mu);return 1;
+    }
+    ReplayRow *rows = calloc(REPLAY_MAX_ROWS,sizeof *rows);
+    if (!rows) { fclose(f); return 0; }
+    char line[256]; unsigned count=0,total=0; int valid=1;
+    while(fgets(line,sizeof line,f)) {
+        if(line[0]=='#' || line[0]=='\n' || line[0]=='\r') continue;
+        unsigned frames; unsigned long long buttons; int a[4],used=0;
+        if(count==REPLAY_MAX_ROWS || sscanf(line,"%u %llx %d %d %d %d%n",&frames,&buttons,&a[0],&a[1],&a[2],&a[3],&used)!=6 ||
+           !frames || frames>REPLAY_MAX_FRAMES-total || strspn(line+used," \t\r\n")!=strlen(line+used) ||
+           (buttons & ~(0xffffull | (1ull<<63)))) { valid=0; break; }
+        for(int i=0;i<4;i++) if(a[i]<-32767 || a[i]>32767) valid=0;
+        if(!valid) break;
+        rows[count].frames=frames; rows[count].buttons=buttons;
+        for(int i=0;i<4;i++) rows[count].axes[i]=a[i];
+        count++;total+=frames;
+    }
+    valid &= !ferror(f) && count!=0; fclose(f);
+    if(!valid) { free(rows); return 0; }
+    dm_smo_luna_stop();
+    pthread_mutex_lock(&g_replay_mu);
+    free(g_rows);g_rows=rows;g_count=count;g_index=0;g_remaining=rows[0].frames;g_frame=0;g_total=total;
+    atomic_store(&g_trigger,0);g_previous=0;
+    atomic_store(&g_active,1);
+    atomic_store(&g_lunakit,0);
+    atomic_store(&g_luna_cleanup_pending,dm_smo_luna_selected());
+    pthread_mutex_unlock(&g_replay_mu);
+    LOG("SMO replay: loaded %u input holds / %u simulation frames from %s",count,total,path);
+    return 1;
+}
+// Called before framework pad sampling, at most once for each original update.
+void dm_smo_replay_next(void) {
+    if(!atomic_load(&g_active)) return;
+    // Old addon/mode cleanup runs on the simulation thread at Scene movement.
+    // Keep text frame zero pending until that cleanup has finished.
+    if(atomic_load(&g_luna_cleanup_pending)) {
+        if(dm_smo_luna_selected())return;
+        atomic_store(&g_luna_cleanup_pending,0);
+    }
+    pthread_mutex_lock(&g_replay_mu);
+    if(atomic_load(&g_active)) {
+        if(g_index==g_count) {
+            atomic_store(&g_active,0);dm_pad_set(0,0,0,0,0);
+            atomic_store(&g_trigger,0);g_previous=0;
+            LOG("SMO replay: completed %u source frames",g_frame);
+        } else {
+            ReplayRow *r=&g_rows[g_index];
+            atomic_store(&g_trigger,r->buttons & ~g_previous);g_previous=r->buttons;
+            dm_pad_set(r->buttons,r->axes[0],r->axes[1],r->axes[2],r->axes[3]);g_frame++;
+            if(!--g_remaining) { g_index++;if(g_index<g_count) g_remaining=g_rows[g_index].frames; }
+        }
+    }
+    pthread_mutex_unlock(&g_replay_mu);
+}
+void dm_smo_replay_json(FILE *f) {
+    dm_smo_luna_status(f);
+    if(atomic_load(&g_lunakit)) { dm_smo_luna_json(f);return; }
+    pthread_mutex_lock(&g_replay_mu);
+    fprintf(f,",\"replay\":{\"active\":%s,\"frame\":%u,\"frames\":%u,\"hold\":%u,\"holds\":%u}",
+        atomic_load(&g_active)?"true":"false",g_frame,g_total,g_index,g_count);
+    pthread_mutex_unlock(&g_replay_mu);
+}
