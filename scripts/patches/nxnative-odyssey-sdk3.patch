diff --git a/dm/gfx/nvn/nvn_present_slots.h b/dm/gfx/nvn/nvn_present_slots.h
new file mode 100644
index 0000000..2984307
--- /dev/null
+++ b/dm/gfx/nvn/nvn_present_slots.h
@@ -0,0 +1,78 @@
+#ifndef NVN_PRESENT_SLOTS_H
+#define NVN_PRESENT_SLOTS_H
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+
+enum { NVN_PRESENT_SLOTS = 3, NVN_PRESENT_QUEUE = 8 };
+typedef struct {
+    uint64_t submitted[NVN_PRESENT_SLOTS];
+    uint64_t completed[NVN_PRESENT_SLOTS];
+} nvn_present_slots;
+
+// A single presenter owns selection and submission. Only real GPU feedback
+// completes a slot; skipping a presentation ticket cannot release its memory.
+static inline int nvn_present_slot_acquire(nvn_present_slots *slots, int preferred,
+                                         pthread_mutex_t *mutex, pthread_cond_t *condition) {
+    pthread_mutex_lock(mutex);
+    for (;;) {
+        for (int n = 0; n < NVN_PRESENT_SLOTS; n++) {
+            int slot = (preferred + n) % NVN_PRESENT_SLOTS;
+            if (slots->completed[slot] >= slots->submitted[slot]) {
+                pthread_mutex_unlock(mutex);
+                return slot;
+            }
+        }
+        pthread_cond_wait(condition, mutex);
+    }
+}
+
+// Caller holds the same mutex, publishes any other completion state, then
+// broadcasts the condition. Record submission before committing GPU work.
+static inline void nvn_present_slot_submit(nvn_present_slots *slots, int slot, uint64_t ticket) {
+    slots->submitted[slot] = ticket;
+}
+static inline void nvn_present_slot_complete(nvn_present_slots *slots, int slot, uint64_t ticket) {
+    slots->completed[slot] = ticket;
+}
+// Global retirement stays contiguous for drains and bounded queue storage.
+// Individual source queries can release a newer dropped texture without ever
+// releasing an older texture the GPU still reads. Caller holds mutex.
+typedef struct {
+    uint64_t done;
+    uint64_t retired[NVN_PRESENT_QUEUE];
+    unsigned readers[NVN_PRESENT_QUEUE];
+} nvn_present_retirement;
+static inline int nvn_present_source_ready(const nvn_present_retirement *queue, uint64_t ticket) {
+    if (ticket <= queue->done) return 1;
+    if (ticket - queue->done > NVN_PRESENT_QUEUE) return 0;
+    unsigned slot = (unsigned)((ticket - 1) % NVN_PRESENT_QUEUE);
+    return queue->retired[slot] == ticket && !queue->readers[slot];
+}
+static inline void nvn_present_retirement_advance(nvn_present_retirement *queue) {
+    while (queue->retired[queue->done % NVN_PRESENT_QUEUE] == queue->done + 1 &&
+           !queue->readers[queue->done % NVN_PRESENT_QUEUE]) {
+        queue->retired[queue->done % NVN_PRESENT_QUEUE] = 0;
+        queue->done++;
+    }
+}
+static inline void nvn_present_retire(nvn_present_retirement *queue, uint64_t ticket) {
+    if (ticket <= queue->done) return;
+    assert(ticket - queue->done <= NVN_PRESENT_QUEUE);
+    queue->retired[(ticket - 1) % NVN_PRESENT_QUEUE] = ticket;
+    nvn_present_retirement_advance(queue);
+}
+// Optional preview/readback queues also own the source until their GPU copies
+// finish. Register before commit; the presenter has not retired this ticket yet.
+static inline void nvn_present_reader_begin(nvn_present_retirement *queue, uint64_t ticket) {
+    assert(ticket > queue->done && ticket - queue->done <= NVN_PRESENT_QUEUE);
+    queue->readers[(ticket - 1) % NVN_PRESENT_QUEUE]++;
+}
+static inline void nvn_present_reader_end(nvn_present_retirement *queue, uint64_t ticket) {
+    assert(ticket > queue->done && ticket - queue->done <= NVN_PRESENT_QUEUE);
+    unsigned *readers = &queue->readers[(ticket - 1) % NVN_PRESENT_QUEUE];
+    assert(*readers);
+    --*readers;
+    nvn_present_retirement_advance(queue);
+}
+#endif
