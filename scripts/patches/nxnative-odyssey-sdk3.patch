diff --git a/dm/host/hle_audio_record.c b/dm/host/hle_audio_record.c
new file mode 100644
index 0000000..0bfcfbd
--- /dev/null
+++ b/dm/host/hle_audio_record.c
@@ -0,0 +1,139 @@
+// Native game output capture, including the headless real-time sink. The audio
+// callback only copies into a bounded SPSC queue; a separate thread writes WAV.
+#include "hle_audio_record.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { RECORD_RATE = 48000, RECORD_SLOTS = 256, RECORD_BLOCK = 1024 };
+typedef struct { uint64_t ns; uint32_t frames; int16_t pcm[RECORD_BLOCK * 2]; } RecordBlock;
+static RecordBlock g_blocks[RECORD_SLOTS];
+static _Atomic uint64_t g_head, g_tail, g_dropped;
+static _Atomic unsigned g_pushers;
+static _Atomic int g_active, g_writing;
+static pthread_mutex_t g_record_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t g_record_thread;
+static FILE *g_record_file;
+static uint64_t g_record_unix, g_record_mono;
+static _Atomic uint64_t g_record_frames;
+static _Atomic int g_record_error;
+
+static uint64_t record_ns(clockid_t clock) {
+    struct timespec t; clock_gettime(clock, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+static void le32(uint8_t *p, uint32_t v) {
+    for (unsigned i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (i * 8));
+}
+static void wave_header(void) {
+    uint8_t h[44] = {0};
+    memcpy(h, "RIFF", 4); le32(h + 4, 36 + (uint32_t)(g_record_frames * 4));
+    memcpy(h + 8, "WAVEfmt ", 8); le32(h + 16, 16);
+    h[20] = 1; h[22] = 2; le32(h + 24, RECORD_RATE);
+    le32(h + 28, RECORD_RATE * 4); h[32] = 4; h[34] = 16;
+    memcpy(h + 36, "data", 4); le32(h + 40, (uint32_t)(g_record_frames * 4));
+    if (fseek(g_record_file, 0, SEEK_SET) || fwrite(h, 1, sizeof h, g_record_file) != sizeof h)
+        g_record_error = 1;
+}
+static void record_write(const int16_t *pcm, uint64_t frames) {
+    if (g_record_error) return;
+    if (frames > (UINT32_MAX - 36u) / 4u - g_record_frames ||
+        fwrite(pcm, 4, (size_t)frames, g_record_file) != frames) {
+        g_record_error = 1; return;
+    }
+    g_record_frames += frames;
+}
+static void record_silence(uint64_t frames) {
+    const int16_t zero[RECORD_BLOCK * 2] = {0};
+    while (frames && !g_record_error) {
+        uint64_t n = frames < RECORD_BLOCK ? frames : RECORD_BLOCK;
+        record_write(zero, n); frames -= n;
+    }
+}
+static void *record_writer(void *unused) {
+    (void)unused;
+    while (atomic_load_explicit(&g_writing, memory_order_acquire) ||
+           atomic_load(&g_head) != atomic_load(&g_tail)) {
+        uint64_t head = atomic_load_explicit(&g_head, memory_order_relaxed);
+        if (head == atomic_load_explicit(&g_tail, memory_order_acquire)) { usleep(2000); continue; }
+        const RecordBlock *b = &g_blocks[head % RECORD_SLOTS];
+        uint64_t elapsed = b->ns > g_record_mono ? b->ns - g_record_mono : 0;
+        uint64_t at = elapsed / 1000000000ull * RECORD_RATE + elapsed % 1000000000ull * RECORD_RATE / 1000000000ull;
+        // Preserve real pauses and loading gaps. Callback scheduling jitter
+        // below 20 ms keeps the exact sample clock instead of adding drift.
+        if (!g_record_frames || at > g_record_frames + RECORD_RATE / 50)
+            if (at > g_record_frames) record_silence(at - g_record_frames);
+        record_write(b->pcm, b->frames);
+        atomic_store_explicit(&g_head, head + 1, memory_order_release);
+    }
+    return NULL;
+}
+static void record_stop_locked(void) {
+    atomic_store_explicit(&g_active, 0, memory_order_release);
+    while (atomic_load_explicit(&g_pushers, memory_order_acquire)) usleep(50);
+    if (!g_record_file) return;
+    atomic_store_explicit(&g_writing, 0, memory_order_release);
+    pthread_join(g_record_thread, NULL);
+    wave_header();
+    if (fclose(g_record_file)) g_record_error = 1;
+    g_record_file = NULL;
+}
+int dm_audio_record_start(const char *path) {
+    pthread_mutex_lock(&g_record_mu);
+    record_stop_locked();
+    g_record_file = fopen(path, "wb");
+    if (!g_record_file) { pthread_mutex_unlock(&g_record_mu); return 0; }
+    g_record_frames = 0; g_record_error = 0;
+    g_record_unix = record_ns(CLOCK_REALTIME); g_record_mono = record_ns(CLOCK_MONOTONIC);
+    atomic_store(&g_head, 0); atomic_store(&g_tail, 0); atomic_store(&g_dropped, 0);
+    wave_header();
+    if (g_record_error) { fclose(g_record_file); g_record_file = NULL; pthread_mutex_unlock(&g_record_mu); return 0; }
+    atomic_store(&g_writing, 1);
+    if (pthread_create(&g_record_thread, NULL, record_writer, NULL)) {
+        atomic_store(&g_writing, 0); fclose(g_record_file); g_record_file = NULL;
+        pthread_mutex_unlock(&g_record_mu); return 0;
+    }
+    atomic_store_explicit(&g_active, 1, memory_order_release);
+    pthread_mutex_unlock(&g_record_mu); return 1;
+}
+void dm_audio_record_stop(void) {
+    pthread_mutex_lock(&g_record_mu); record_stop_locked(); pthread_mutex_unlock(&g_record_mu);
+}
+static int16_t record_clip(int64_t v) { return (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v); }
+void dm_audio_record_push(const int16_t *samples, uint32_t frames, unsigned channels) {
+    if (!atomic_load_explicit(&g_active, memory_order_acquire)) return;
+    atomic_fetch_add_explicit(&g_pushers, 1, memory_order_acq_rel);
+    if (!atomic_load_explicit(&g_active, memory_order_acquire)) goto done;
+    if (!samples || (channels != 1 && channels != 2 && channels != 6)) { atomic_fetch_add(&g_dropped, frames); goto done; }
+    uint64_t ns = record_ns(CLOCK_MONOTONIC);
+    while (frames) {
+        uint32_t n = frames < RECORD_BLOCK ? frames : RECORD_BLOCK;
+        uint64_t tail = atomic_load_explicit(&g_tail, memory_order_relaxed);
+        if (tail - atomic_load_explicit(&g_head, memory_order_acquire) == RECORD_SLOTS) {
+            atomic_fetch_add(&g_dropped, frames); break;
+        }
+        RecordBlock *b = &g_blocks[tail % RECORD_SLOTS]; b->ns = ns; b->frames = n;
+        for (uint32_t i = 0; i < n; i++) {
+            const int16_t *p = samples + i * channels;
+            if (channels == 6) {
+                int64_t center = (int64_t)p[2] * 23167 + (int64_t)p[3] * 8224;
+                b->pcm[i*2] = record_clip(((int64_t)p[0]*32768 + center + (int64_t)p[4]*23167) >> 15);
+                b->pcm[i*2+1] = record_clip(((int64_t)p[1]*32768 + center + (int64_t)p[5]*23167) >> 15);
+            } else { b->pcm[i*2] = p[0]; b->pcm[i*2+1] = p[channels == 1 ? 0 : 1]; }
+        }
+        atomic_store_explicit(&g_tail, tail + 1, memory_order_release);
+        ns += (uint64_t)n * 1000000000ull / RECORD_RATE;
+        samples += n * channels; frames -= n;
+    }
+done:
+    atomic_fetch_sub_explicit(&g_pushers, 1, memory_order_release);
+}
+void dm_audio_record_json(FILE *f) {
+    pthread_mutex_lock(&g_record_mu);
+    fprintf(f, "{\"ok\":true,\"unixNs\":\"%llu\",\"rate\":48000,\"channels\":2,\"frames\":%llu,\"droppedFrames\":%llu,\"error\":%s}\n",
+        (unsigned long long)g_record_unix, (unsigned long long)g_record_frames,
+        (unsigned long long)atomic_load(&g_dropped), g_record_error ? "true" : "false");
+    pthread_mutex_unlock(&g_record_mu);
+}
