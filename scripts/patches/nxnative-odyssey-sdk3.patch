+// Mapping cache is reset on EVERY capture. No actor/scene pointers survive a
+// capture. The caller owns the completed scene on this game-thread boundary.
+static int readable(const void *p, size_t n) {
+    uintptr_t a = (uintptr_t)p;
+    if (a < 0x1000 || !n || n > UINTPTR_MAX-a) return 0;
+    for (unsigned i = 0; i < g_region_count; i++)
