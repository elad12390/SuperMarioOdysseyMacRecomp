diff --git a/dm/gfx/tests/t_present_retire.c b/dm/gfx/tests/t_present_retire.c
new file mode 100644
index 0000000..3c9244d
--- /dev/null
+++ b/dm/gfx/tests/t_present_retire.c
@@ -0,0 +1,207 @@
+// Exercise the production slot coordinator without opening a GPU device or window.
+#include "../nvn/nvn_present_slots.h"
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static int checks, failures;
+#define CHECK(label, value) do { int ok = !!(value); checks++; failures += !ok; \
+    printf("%s: %s\n", label, ok ? "OK" : "FAIL"); } while (0)
+
+static void free_slots(void) {
+    pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    pthread_cond_t condition = PTHREAD_COND_INITIALIZER;
+    for (int busy = 0; busy < 7; busy++) {
+        for (int preferred = 0; preferred < NVN_PRESENT_SLOTS; preferred++) {
+            nvn_present_slots slots = {0};
+            for (int slot = 0; slot < NVN_PRESENT_SLOTS; slot++) {
+                nvn_present_slot_submit(&slots, slot, 30 + slot);
+                if (!(busy & (1 << slot))) nvn_present_slot_complete(&slots, slot, 30 + slot);
+            }
+            int got = nvn_present_slot_acquire(&slots, preferred, &mutex, &condition);
+            int expected = preferred;
+            while (busy & (1 << expected)) expected = (expected + 1) % NVN_PRESENT_SLOTS;
+            CHECK("acquire selects the first genuinely completed slot", got == expected);
+            CHECK("selection never changes submission/completion state", slots.submitted[got] == (uint64_t)(30 + got) && slots.completed[got] == (uint64_t)(30 + got));
+        }
+    }
+    pthread_cond_destroy(&condition); pthread_mutex_destroy(&mutex);
+}
+
+typedef struct {
+    nvn_present_slots slots;
+    pthread_mutex_t mutex, probe_mutex;
+    pthread_cond_t condition, probe_condition;
+    int started, returned, selected;
+} scenario;
+
+static void *acquire_main(void *context) {
+    scenario *s = context;
+    pthread_mutex_lock(&s->probe_mutex);
+    s->started = 1; pthread_cond_broadcast(&s->probe_condition);
+    pthread_mutex_unlock(&s->probe_mutex);
+    int slot = nvn_present_slot_acquire(&s->slots, 1, &s->mutex, &s->condition);
+    pthread_mutex_lock(&s->probe_mutex);
+    s->selected = slot; s->returned = 1; pthread_cond_broadcast(&s->probe_condition);
+    pthread_mutex_unlock(&s->probe_mutex);
+    return NULL;
+}
+static int wait_probe(scenario *s, int started, int milliseconds) {
+    struct timespec deadline; clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_sec += milliseconds / 1000;
+    deadline.tv_nsec += (long)(milliseconds % 1000) * 1000000;
+    if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+    pthread_mutex_lock(&s->probe_mutex);
+    int *flag = started ? &s->started : &s->returned;
+    while (!*flag) {
+        int status = pthread_cond_timedwait(&s->probe_condition, &s->probe_mutex, &deadline);
+        if (status == ETIMEDOUT) break;
+        if (status) { failures++; break; }
+    }
+    int result = *flag;
+    pthread_mutex_unlock(&s->probe_mutex);
+    return result;
+}
+static void busy_slots(void) {
+    scenario s = {.mutex = PTHREAD_MUTEX_INITIALIZER, .probe_mutex = PTHREAD_MUTEX_INITIALIZER,
+                  .condition = PTHREAD_COND_INITIALIZER, .probe_condition = PTHREAD_COND_INITIALIZER,
+                  .selected = -1};
+    for (int slot = 0; slot < NVN_PRESENT_SLOTS; slot++) nvn_present_slot_submit(&s.slots, slot, 3 + slot);
+    uint64_t retired_ticket = 9;
+    CHECK("old global-watermark predicate would reuse busy preferred slot", retired_ticket >= s.slots.submitted[1] && s.slots.completed[1] < s.slots.submitted[1]);
+    pthread_t thread;
+    int made = pthread_create(&thread, NULL, acquire_main, &s) == 0;
+    CHECK("allocator waiter starts", made);
+    if (!made) return;
+    CHECK("waiter reaches acquire", wait_probe(&s, 1, 1000));
+    CHECK("all busy slots block despite advanced retired ticket", !wait_probe(&s, 0, 100));
+    pthread_mutex_lock(&s.mutex);
+    pthread_cond_broadcast(&s.condition);
+    pthread_mutex_unlock(&s.mutex);
+    CHECK("a frame-drop wakeup cannot release GPU-owned memory", !wait_probe(&s, 0, 100));
+    pthread_mutex_lock(&s.mutex);
+    nvn_present_slot_complete(&s.slots, 0, 3);
+    pthread_cond_broadcast(&s.condition);
+    pthread_mutex_unlock(&s.mutex);
+    int returned = wait_probe(&s, 0, 1000);
+    CHECK("non-preferred completion wakes acquire without waiting for preferred slot", returned);
+    if (!returned) { // Unblock the thread before reporting failure; never leave a background waiter.
+        pthread_mutex_lock(&s.mutex);
+        for (int slot = 0; slot < NVN_PRESENT_SLOTS; slot++) nvn_present_slot_complete(&s.slots, slot, 3 + slot);
+        pthread_cond_broadcast(&s.condition);
+        pthread_mutex_unlock(&s.mutex);
+    }
+    pthread_join(thread, NULL);
+    CHECK("only the slot with a real completion is selected", returned && s.selected == 0);
+    CHECK("other submitted slots remain protected", s.slots.completed[1] < s.slots.submitted[1] && s.slots.completed[2] < s.slots.submitted[2]);
+    nvn_present_slot_submit(&s.slots, 0, 6);
+    CHECK("previous completion cannot authorize the next reuse", s.slots.completed[0] < s.slots.submitted[0]);
+    nvn_present_slot_complete(&s.slots, 2, 5);
+    CHECK("after reuse, acquire takes another completed slot", nvn_present_slot_acquire(&s.slots, 0, &s.mutex, &s.condition) == 2);
+    pthread_cond_destroy(&s.probe_condition); pthread_mutex_destroy(&s.probe_mutex);
+    pthread_cond_destroy(&s.condition); pthread_mutex_destroy(&s.mutex);
+}
+
+static unsigned retirement_permutations, retirement_errors;
+static void retire_orders(nvn_present_retirement queue, unsigned retired, uint64_t base) {
+    for (unsigned next = 0; next < NVN_PRESENT_QUEUE; next++) {
+        if (retired & (1u << next)) continue;
+        nvn_present_retirement copy = queue;
+        unsigned mask = retired | (1u << next);
+        nvn_present_retire(&copy, base + next + 1);
+        unsigned prefix = 0;
+        while (prefix < NVN_PRESENT_QUEUE && (mask & (1u << prefix))) prefix++;
+        if (copy.done != base + prefix) retirement_errors++;
+        for (unsigned i = 0; i < NVN_PRESENT_QUEUE; i++) {
+            int expected = !!(mask & (1u << i));
+            if (nvn_present_source_ready(&copy, base + i + 1) != expected) retirement_errors++;
+        }
+        nvn_present_retire(&copy, base + next + 1); // Repeated feedback is harmless.
+        if (copy.done != base + prefix) retirement_errors++;
+        if (prefix == NVN_PRESENT_QUEUE) retirement_permutations++;
+        else retire_orders(copy, mask, base);
+    }
+}
+static void retirement(void) {
+    nvn_present_retirement queue = {0};
+    nvn_present_retire(&queue, 2); nvn_present_retire(&queue, 3);
+    CHECK("dropping tickets 2 and 3 never releases GPU-owned ticket 1", queue.done == 0);
+    nvn_present_retire(&queue, 4);
+    CHECK("newer completion cannot bypass pending earlier texture read", queue.done == 0);
+    nvn_present_retire(&queue, 1);
+    CHECK("completion of oldest frame releases contiguous retired tickets", queue.done == 4);
+    nvn_present_retire(&queue, 3);
+    CHECK("late duplicate completion never moves retirement backwards", queue.done == 4);
+    retire_orders((nvn_present_retirement){0}, 0, 0);
+    retire_orders((nvn_present_retirement){.done = 13}, 0, 13);
+    CHECK("all retirement orders and ring wrap preserve pending reads", retirement_errors == 0 && retirement_permutations == 80640);
+    for (uint64_t ticket = 5; ticket <= 10000; ticket++) nvn_present_retire(&queue, ticket);
+    CHECK("long sequential playback reuses the bounded retirement ring", queue.done == 10000);
+}
+
+
+static void readback_ownership(void) {
+    // A display completion and a no-drawable return both finish only the
+    // presenter's ownership; neither establishes classic-queue completion.
+    {
+        nvn_present_retirement queue = {0};
+        nvn_present_reader_begin(&queue, 1);
+        nvn_present_reader_begin(&queue, 1);
+        nvn_present_retire(&queue, 1);
+        CHECK("display/no-submit cannot retire a source with pending readbacks", queue.done == 0);
+        nvn_present_retire(&queue, 2);
+        nvn_present_reader_end(&queue, 1);
+        CHECK("one completed readback cannot bypass another source reader", queue.done == 0);
+        nvn_present_reader_end(&queue, 1);
+        CHECK("last readback releases this source and later dropped tickets", queue.done == 2);
+        nvn_present_reader_begin(&queue, 3);
+        nvn_present_reader_end(&queue, 3);
+        CHECK("early readback completion waits for the presenter", queue.done == 2);
+        nvn_present_retire(&queue, 3);
+        CHECK("presenter can finish after all readbacks", queue.done == 3);
+        for (uint64_t ticket = 4; ticket <= 20; ticket++) {
+            nvn_present_reader_begin(&queue, ticket);
+            nvn_present_retire(&queue, ticket);
+            nvn_present_reader_end(&queue, ticket);
+        }
+        CHECK("readback ownership survives ring reuse", queue.done == 20);
+    }
+}
+
+static void mailbox_sources(void) {
+    nvn_present_retirement queue = {0};
+    CHECK("an empty presentation ticket needs no source wait", nvn_present_source_ready(&queue, 0));
+    CHECK("an unsubmitted future ticket is not reusable", !nvn_present_source_ready(&queue, 1));
+    nvn_present_retire(&queue, 2);
+    nvn_present_retire(&queue, 3);
+    CHECK("newer discarded sources are reusable independently of an older copy",
+          nvn_present_source_ready(&queue, 2) && nvn_present_source_ready(&queue, 3));
+    CHECK("discarding newer frames never returns the texture being copied",
+          !nvn_present_source_ready(&queue, 1));
+    CHECK("a global drain still waits for the older copy", queue.done == 0);
+    nvn_present_reader_begin(&queue, 4);
+    nvn_present_retire(&queue, 4);
+    CHECK("a superseded source with a GPU reader remains owned", !nvn_present_source_ready(&queue, 4));
+    nvn_present_reader_end(&queue, 4);
+    CHECK("the exact source becomes reusable after its last reader", nvn_present_source_ready(&queue, 4));
+    CHECK("finishing a different source cannot release the older copy", !nvn_present_source_ready(&queue, 1));
+    nvn_present_retire(&queue, 1);
+    CHECK("the drain advances only after every earlier source finishes", queue.done == 4);
+    CHECK("already drained sources stay reusable", nvn_present_source_ready(&queue, 1));
+    CHECK("a reused ring slot cannot satisfy a future ticket", !nvn_present_source_ready(&queue, 10));
+    for (uint64_t ticket = 5; ticket < 10005; ticket++) {
+        nvn_present_retire(&queue, ticket);
+        if (!nvn_present_source_ready(&queue, ticket) || nvn_present_source_ready(&queue, ticket + NVN_PRESENT_QUEUE)) {
+            failures++; break;
+        }
+    }
+    CHECK("mailbox reuse stays bounded across ten thousand tickets", queue.done == 10004);
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    free_slots(); busy_slots(); retirement(); readback_ownership(); mailbox_sources();
+    printf("present retirement CPU regression: %d checks, %d failed\n", checks, failures);
+    return failures != 0;
+}
