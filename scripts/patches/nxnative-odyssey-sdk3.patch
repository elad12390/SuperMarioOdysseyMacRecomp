+static void write32(unsigned char *p, uint32_t value) {
+    for (int i = 0; i < 4; ++i) { p[i] = (unsigned char)(value & 255); value >>= 8; }
+}
+static void write_float(unsigned char *p, float value) {
+    uint32_t bits; memcpy(&bits, &value, 4); write32(p, bits);
+}
+static DmLunaFrame frame(uint32_t step, uint32_t player, uint32_t buttons, float value) {
+    DmLunaFrame f; dm_luna_neutral(&f, player); f.step = step; f.buttons = buttons;
+    for (int i = 0; i < 4; ++i) f.sticks[i] = value / (float)(i + 2);
+    for (int h = 0; h < 2; ++h) {
+        for (int i = 0; i < 3; ++i) { f.accel[h][i] = value + (float)(h * 3 + i); f.angular[h][i] = -value - (float)(h * 3 + i); }
+        for (int i = 0; i < 9; ++i) f.direction[h][i] = value + (float)(h * 9 + i) / 16.0f;
+    }
+    return f;
+}
+static void tape_path(char path[4096], const char *name) {
+    int n = snprintf(path, 4096, "%s/%s", scratch, name);
+    if (n < 0 || n >= 4096) { fputs("Fixture path overflow\n", stderr); exit(2); }
+}
+static void cleanup_scratch(void) {
+    if (!scratch) return;
+    const char *names[] = {"basic.bin", "single.bin", "sparse.bin", "unsupported-stage.bin",
+        "malformed.bin", "completion.bin", "position.bin", "reload.bin", "legacy.txt"};
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+        char path[4096]; tape_path(path, names[i]); (void)unlink(path);
+    }
+    (void)rmdir(scratch);
+}
+static void write_tape(const char *name, const DmLunaFrame *frames, size_t count, int two_player,
+                       const float pos[3], const char *stage, char path[4096]) {
+    size_t length = DM_LUNA_HEADER_SIZE + count * DM_LUNA_RECORD_SIZE;
+    unsigned char *bytes = calloc(1, length);
+    if (!bytes) exit(2);
+    memcpy(bytes, "BOOB", 4); write32(bytes + 4, (uint32_t)count); bytes[8] = (unsigned char)two_player;
+    write32(bytes + 12, 1);
+    if (stage) memcpy(bytes + 16, stage, strlen(stage) + 1);
+    for (int i = 0; i < 3; ++i) write_float(bytes + 272 + 4 * i, pos ? pos[i] : 0);
+    for (size_t i = 0; i < count; ++i) {
+        const DmLunaFrame *f = &frames[i]; unsigned char *p = bytes + DM_LUNA_HEADER_SIZE + i * DM_LUNA_RECORD_SIZE;
+        write32(p, f->step); p[4] = (unsigned char)f->player; write32(p + 8, f->buttons);
+        for (int j = 0; j < 4; ++j) write_float(p + 12 + 4 * j, f->sticks[j]);
+        for (int h = 0; h < 2; ++h) {
+            for (int j = 0; j < 3; ++j) { write_float(p + (h ? 40 : 28) + 4 * j, f->accel[h][j]); write_float(p + (h ? 136 : 88) + 4 * j, f->angular[h][j]); }
+            for (int j = 0; j < 9; ++j) write_float(p + (h ? 100 : 52) + 4 * j, f->direction[h][j]);
+        }
+    }
+    tape_path(path, name); FILE *out = fopen(path, "wb");
+    if (!out || fwrite(bytes, 1, length, out) != length || fclose(out)) exit(2);
+    free(bytes);
+}
+static void observe_pair(const DmLunaFrame *a, const DmLunaFrame *b, uint32_t previous_a, uint32_t previous_b) {
+    observed[0] = a; observed[1] = b; observed_previous[0] = previous_a; observed_previous[1] = previous_b; observe_writes = 1;
+}
+static void neutral_pair(DmLunaFrame pair[2]) {
+    dm_luna_neutral(&pair[0], 0); dm_luna_neutral(&pair[1], 1);
+}
+static void make_basic(char path[4096], int two_player) {
+    DmLunaFrame f[] = {frame(0, 0, 15, 0.25f), frame(0, 1, 0x8010, -0.5f), frame(2, 0, 7, 0.125f)};
+    if (two_player) write_tape("basic.bin", f, 3, 1, NULL, NULL, path);
+    else { f[1] = f[2]; write_tape("single.bin", f, 2, 0, NULL, NULL, path); }
+}
